<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 目标框架**不带平台版本**（`net10.0-windows`，即 TargetPlatformVersion=7.0）。
         这不是随手写的：带平台版本（`net10.0-windows10.0.22000.0`）会让 SDK 引用
         `Microsoft.Windows.SDK.NET.Ref` 那套 WinRT 托管投影，单文件包直接多 25.7 MB
         （`Microsoft.Windows.SDK.NET.dll` 25,717,792 字节 + `WinRT.Runtime.dll` 528,944），
         而本程序一行 WinRT 类型都没用（界面全是 WPF，系统能力全是 P/Invoke）。
         实测：不带平台版本 12.7 MiB，带了 37.7 MiB。
         代价是**失去编译期的"只允许 Win11"约束**（`SupportedOSPlatformVersion` 不能高于
         TargetPlatformVersion=7.0，写了就是 NETSDK1135），所以最低系统版本改成运行期检查：
         见 `App.xaml.cs` 的 `EnsureSupportedOs()`（Windows 10 1809 / build 17763 起）。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 只有一个 exe（框架依赖）。.NET 10 桌面运行时需要另行安装，
          下载地址见 README 顶部与每次的 Release 说明。
          不再拆"启动器 + 主程序"两个文件 —— 用户不知道该点哪个。 -->
    <AssemblyName>InputPlus</AssemblyName>
    <RootNamespace>InputPlus</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 1.0：改名 Input Plus 之后重新起版本号。
         老版本线停在 5.15.x（KeyboardEnhance），所以 1.0 不是"倒退"而是新品牌的第一版；
         设置文件里 Global.LastVersion 记录的旧号回退逻辑仍然按字符串比较，
         不会把 5.15.0 当成"比 1.0 新"。 -->
    <Version>1.7.4</Version>
    <FileVersion>1.7.4</FileVersion>
    <!-- AssemblyVersion 必须跟 <Version> 一致：UpdateService.CurrentVersion 读的是
         Assembly.GetName().Version（三段式），漏改的话发布包会自己弹一次「发现新版本」。 -->
    <AssemblyVersion>1.7.4</AssemblyVersion>
    <!-- 不要把源码 commit 拼进 ProductVersion。
         默认行为会生成 "4.5.0+2c574eb…"，而发布时那个 commit 通常**还没包含**
         本次改动（先构建、后提交），用户看文件属性会以为装的是旧版。
         版本号就是版本号，commit 用 tag 与 Release 记录就够了。 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Input Plus</Product>
    <!-- 文件属性里显示的"说明"来自 AssemblyTitle；不给的话会用程序集名 InputPlus（少个空格）。 -->
    <AssemblyTitle>Input Plus</AssemblyTitle>
    <Company>QQQOrange</Company>
    <Description>Input Plus：键盘增强与鼠标手势工具。任意键绑定功能、光标移动与选择、快速搜索面板、直达链接（网址/文件）、独立剪贴板、宏与多图层、鼠标手势、平滑滚动、按住拖拽</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 发布包里不带 PDB。
         以前是 `embedded`：调试符号整个嵌进 InputPlus.dll，主程序集 6.2 MB 里有
         好几 MB 是符号表，而**发布版用不到它**（堆栈行号靠 CoreLog 自己记）。
         改成 none 之后单文件包直接小一截，运行行为完全不变。
         需要断点调试时用 Debug 配置（默认 portable），不影响开发。 -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' != 'Release'">embedded</DebugType>

    <!-- WPF 启动开销控制：去掉不需要的语言资源与调试符号，缩短首屏时间 -->
    <PublishTrimmed>false</PublishTrimmed>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>

    <!-- WFO0003：分析器建议把 DPI 设置从 app.manifest 挪到 ApplicationHighDpiMode。
         这条**不能照做** —— 本项目是 WPF 主体，高 DPI 靠清单里的
         PerMonitorV2 + WPF 自己的 DPI 感知声明生效；WinForms 只用来托管托盘图标，
         改成 WinForms 的 API 反而会让 WPF 那条路失去 Per-Monitor 支持。
         这里只关掉这条针对性建议，其它分析器规则照旧。 -->
    <NoWarn>$(NoWarn);WFO0003;WFAC010</NoWarn>

    <!-- 性能与体积：ReadyToRun 把 IL 预编译成原生代码，理论上省 JIT；
         但**实测在这台机器上没有收益**（本程序 5 轮交替测量：
         中位数 718ms → 716ms，差异在噪声内），而它会让单文件大 2.06 MB。
         所以这里关掉：体积减 40%，启动速度不变。 -->
    <TieredPGO>true</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- 框架依赖：体积最小（约 5MB），但运行前必须装 .NET 10 桌面运行时。
         缺了它双击不会有任何界面 —— 这是这个方案唯一的代价，
         所以 README / Release 说明里必须把依赖和下载地址写在最前面。 -->
    <SelfContained>false</SelfContained>
    <!-- 注意：EnableCompressionInSingleFile 只在自带运行时时有效，
         框架依赖模式下 SDK 会直接报 NETSDK1176，所以这里不能开。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- 诊断工具开关（审视报告 P1-5）。
         默认 true：发布版仍带「自检」与「离屏渲染」两个命令行入口，
         用户报「某功能不灵」时可以让他自己跑一次自检，比远程猜快得多。
         需要最小体积时用 MSBuild 属性 IncludeDiagnostics=false 发布。 -->
    <IncludeDiagnostics Condition="'$(IncludeDiagnostics)' == ''">true</IncludeDiagnostics>
    <!-- 原生库（ipidx.dll）随单文件发布一起打包，运行时解压到临时目录再加载。
         见 Core/Qbar/Search/TantivyApi.cs 的 DllImport("ipidx")。 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- 应用图标（512×512 PNG）。界面里的品牌区统一用它，
         不再用 Segoe 图标字体的 glyph —— 那和 exe 上的图标完全是两回事，
         用户一眼就看出"里面这个图标跟外面那个不一样"。 -->
    <Resource Include="Assets\app.png" />
    <!-- 内置引擎图标（由 QuickSearch 的图标库转换而来，见 tools/qs_gen.py）。
         以 Resource 形式打包进程序，运行时不依赖磁盘或网络。 -->
    <Resource Include="Assets\engine-icons\*.png" />
    <!-- 拖动 Qbar 面板用的鼠标指针：张开手（可拖）/ 握拳（正在拖）。
         用 Resource 而不是系统 Cursors.Hand —— Windows 没有内置的"抓手"指针，
         只有指向用的 Link 手形；抓取手势得自己画。 -->
    <Resource Include="Assets\cursors\*.cur" />
    <!-- 内置手势库（1.0 起）：一套调好的 59 条鼠标手势，新装即用。
         用 EmbeddedResource 而不是 content 文件 —— 单文件发布后磁盘上没有这个
         文件，只有嵌进程序集才读得到。LogicalName 写死，避免 RID 构建时
         清单名变成 命名空间.目录.文件 之外的样子。 -->
    <EmbeddedResource Include="Assets\gestures-builtin.json" LogicalName="InputPlus.Assets.gestures-builtin.json" />
    <!-- 界面语言包已经挪到 InputPlus.Localization 工程（Assets\Lang），
         原因见该工程 csproj 顶部：XAML 里的 {loc:T} 一旦引用**本程序集**的类型，
         WPF 就必须先编一个临时程序集再跑第二趟标记编译，那趟临时编译会和正式产物
         抢同一个中间文件，带 RID 构建时 bin 里就缺 InputPlus.dll。
         放到被引用的程序集里就没有这个问题。 -->
  </ItemGroup>

  <ItemGroup>
    <!-- 文件索引的原生库：Rust 侧 crates（src/ipidx）编出来的 cdylib。
         构建方式见 BUILD.md：在 src/ipidx 下执行 cargo 的 release 构建，
         产物 target\release\ipidx.dll 会被这里拷到输出目录与发布目录。
         单文件发布时由 IncludeNativeLibrariesForSelfExtract 一起打包。 -->
    <Content Include="$(MSBuildThisFileDirectory)..\ipidx\target\release\ipidx.dll" Link="ipidx.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)..\ipidx\target\release\ipidx.dll')" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本地化内核（Loc / LocToken / {loc:T} 标记扩展）+ 内置语言包 -->
    <ProjectReference Include="..\InputPlus.Localization\InputPlus.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI Automation：直接读取选区，不受 UIPI 限制 -->
    <PackageReference Include="Interop.UIAutomationClient" Version="10.16299.0" />
    <!-- WMI：调屏幕亮度（root\wpi）。 -->
    <PackageReference Include="System.Management" Version="10.0.13" />
    <PackageReference Include="TinyPinyin.Net" Version="1.0.2" />
    <!-- Lua 脚本动作（v1.5.0）：沙盒里跑用户脚本，只暴露 ip.* 这一层软件能力 -->
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <!-- PDF 正文抽取（正文索引用）：纯托管、MIT、无原生依赖。
         为什么不用 Windows 自带的 IFilter：它要么没装（PDF/Office 都可能是空的），
         要么装在装了 Office/WPS 的机器上才有 —— 不能把功能押在用户的软件清单上。 -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <!-- P1-5：精简发布形态。这两个文件只服务于自检与离屏渲染两个入口，
       运行期逻辑没有任何引用，所以可以整份排除。 -->
  <ItemGroup Condition="'$(IncludeDiagnostics)' == 'false'">
    <Compile Remove="SelfTest.cs" />
    <Compile Remove="UI\RenderTools.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IncludeDiagnostics)' == 'false'">
    <DefineConstants>$(DefineConstants);NO_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <!-- 没有原生索引库时，Release 构建直接失败：少了一个 dll 的发布包"能启动、
       搜索永远没结果"，那种错误用户报不上来、我们也复现不了，必须在构建期拦住。
       Debug 只报警告，方便没装 Rust 工具链的人只看 C# 侧。 -->
  <Target Name="EnsureIpIdxNative" BeforeTargets="Build" Condition="!Exists('$(MSBuildThisFileDirectory)..\ipidx\target\release\ipidx.dll')">
    <Message Importance="high" Text="缺少 ipidx.dll：先在 src\ipidx 下跑 cargo build --release（见 BUILD.md）。" />
    <Error Condition="'$(Configuration)' == 'Release'" Text="Release 构建需要 ipidx.dll（Rust 侧文件索引内核）。请在 src\ipidx 下执行 cargo build --release。" />
  </Target>

</Project>
