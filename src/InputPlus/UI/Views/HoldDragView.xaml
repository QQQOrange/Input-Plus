<UserControl x:Class="InputPlus.UI.Views.HoldDragView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
             xmlns:controls="clr-namespace:InputPlus.UI.Controls"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：名字 + 一句话 + 总开关 -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="34" Height="36" CornerRadius="{DynamicResource Radius.Control}" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#xE7C9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T '按住拖拽'}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{loc:T '按住触发键不放，左键拖动窗口、右键改大小；贴边半屏、拖到别的屏自动最大化。引擎照搬 AltDrag。'}"
                                   Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T '启用'}" Style="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox x:Name="EnabledBox" Style="{StaticResource ToggleSwitch}"
                              Click="OnEnabledChanged"
                              ToolTip="{loc:T '打开之后，按住触发键就能拖动/缩放任何窗口。'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 左：参数 -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="18,10,18,14" Margin="0,0,14,0">
            <ScrollViewer x:Name="LeftScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,0">

                    <TextBlock Text="{loc:T '触发'}" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold"
                               Margin="0,6,0,2" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '触发键'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '按住它才开始接管鼠标。点右边按钮，按哪个键就是哪个键 —— Enter 回车、空格、Shift、F 键都行。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="TriggerKeyButton" Style="{StaticResource Button.Base}" Padding="14,6"
                                    MinWidth="150" Content="{loc:T 'Enter 回车'}" Click="OnPickTriggerKey" />
                            <!-- 图标化（m01050）：只留一个撤销字形，文字进 ToolTip/读屏名，少占一行宽度 -->
                            <Button x:Name="TriggerResetButton" Style="{StaticResource Button.Icon}"
                                    Margin="8,0,0,0" Content="&#xE7A7;" Click="OnResetTriggerKey"
                                    AutomationProperties.Name="{loc:T '默认'}"
                                    ToolTip="{loc:T '默认：恢复成 Enter 回车'}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '长按多久才算数'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '按下触发键要按住这么久才开始接管鼠标；按一下就松开，那一下照旧送给窗口（触发键是 Enter 就还是回车）。0 = 按下即接管。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TriggerHoldBox" Style="{StaticResource TextBox.Base}" Width="72"
                                     TextChanged="OnNumberChanged" Tag="TriggerHoldMs" />
                            <TextBlock Text="{loc:T '毫秒'}" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <!-- v1.7.0「吞键」：打开后触发键的按下不再送到前台。
                         用户场景：Enter 当触发键，按住它拖窗口，前台对话框不该先收到一串回车。 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '吞掉触发键'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '打开后，触发键不再送到前台窗口：Enter 当触发键时，按住它拖窗口不会先在对话框里按出一串回车。按一下就松开（没拖）的那一下会在松手时补发给你，Enter 照常能打字。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="SwallowTriggerBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnToggleChanged" Tag="SwallowTrigger"
                                  ToolTip="{loc:T '打开后触发键不再送给前台窗口（短按会在松手时补发一次）'}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '只认这几台键盘'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '勾上的键盘按的触发键才算数，可以勾多台。最上面的「所有键盘」勾上＝哪台都算，下面的都跟着打勾；取消它＝一台都不认。笔记本自带键盘和外接键盘可以各配各的。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="DeviceButton" Style="{StaticResource Button.Base}"
                                Padding="12,5" VerticalAlignment="Center" Click="OnDeviceButtonClick"
                                ToolTip="{loc:T '选择哪些键盘的触发键才算数（可以勾多台）'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌨" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="DeviceText" Text="{loc:T '所有键盘'}" VerticalAlignment="Center"
                                           MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="▾" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.7" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 键盘清单：勾上哪几台，就只有它们的触发键算数（可多选）。
                         样式照抄「按键映射」页的设备清单（胶囊 + 弹层 + 方框），两页看起来是同一套东西。 -->
                    <Popup x:Name="DevicePopup" PlacementTarget="{Binding ElementName=DeviceButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           HorizontalOffset="0" VerticalOffset="6">
                        <Border Style="{StaticResource Card.Popup}" Padding="14,12" Width="400">
                            <StackPanel>
                                <TextBlock Text="{loc:T '哪些键盘的触发键才算数'}" Style="{StaticResource Text.Body}" />
                                <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="{loc:T '打勾的键盘按的触发键才管用，可以勾多台。勾最上面的「所有键盘」＝下面全算；把它取消＝一台都不认。'}" />
                                <ScrollViewer MaxHeight="300" Margin="0,10,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="DeviceList" />
                                </ScrollViewer>
                                <Separator Margin="0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DeviceHint" Style="{StaticResource Text.Tertiary}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="&#xE72C;" Style="{StaticResource Button.Icon}"
                                            Click="OnRefreshDevicesClick"
                                            AutomationProperties.Name="{loc:T '刷新'}"
                                            ToolTip="{loc:T '刷新：重新枚举键盘和鼠标'}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <TextBlock Text="{loc:T '鼠标动作'}" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold"
                               Margin="0,10,0,2" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '左键'}" Style="{StaticResource Text.Body}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="LeftBox" Style="{StaticResource ComboBox.Base}"
                                  Width="190" VerticalAlignment="Center"
                                  SelectionChanged="OnComboChanged" Tag="ActionLeft" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '右键'}" Style="{StaticResource Text.Body}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="RightBox" Style="{StaticResource ComboBox.Base}"
                                  Width="190" VerticalAlignment="Center"
                                  SelectionChanged="OnComboChanged" Tag="ActionRight" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '中键'}" Style="{StaticResource Text.Body}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="MiddleBox" Style="{StaticResource ComboBox.Base}"
                                  Width="190" VerticalAlignment="Center"
                                  SelectionChanged="OnComboChanged" Tag="ActionMiddle" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '侧键 X1（后退）'}" Style="{StaticResource Text.Body}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="X1Box" Style="{StaticResource ComboBox.Base}"
                                  Width="190" VerticalAlignment="Center"
                                  SelectionChanged="OnComboChanged" Tag="ActionX1" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '侧键 X2（前进）'}" Style="{StaticResource Text.Body}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="X2Box" Style="{StaticResource ComboBox.Base}"
                                  Width="190" VerticalAlignment="Center"
                                  SelectionChanged="OnComboChanged" Tag="ActionX2" />
                    </Grid>

                    <TextBlock Text="{loc:T '贴边'}" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold"
                               Margin="0,10,0,2" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '吸附'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '窗口边靠近屏幕边、任务栏、别的窗口时自动贴上去。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="AutoSnapBox" Width="240" HorizontalAlignment="Right" Style="{StaticResource ComboBox.Base}"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnComboChanged" Tag="AutoSnap" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '吸附距离'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '离边缘多远以内算「贴上了」，就是 AltDrag.ini 里的 SnapThreshold。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="SnapThresholdBox" Style="{StaticResource TextBox.Base}" Width="70"
                                     MinHeight="30" Padding="8,2" VerticalContentAlignment="Center"
                                     TextChanged="OnNumberChanged" Tag="SnapThreshold" />
                            <TextBlock Text="{loc:T '像素'}" Style="{StaticResource Text.Tertiary}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T 'Aero 贴边'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '拖到屏幕顶边最大化、拖到左右边或顶角各占半屏/四分之一屏。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="AeroBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnToggleChanged" Tag="AeroSnap" />
                    </Grid>

                    <TextBlock Text="{loc:T '多显示器与焦点'}" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold"
                               Margin="0,10,0,2" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '拖到别的屏幕就最大化'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '把最大化的窗口拖到另一块屏上，直接在那块屏上最大化（AutoRemaximize）。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="AutoRemaxBox" Width="240" HorizontalAlignment="Right" Style="{StaticResource ComboBox.Base}"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnComboChanged" Tag="AutoRemaximize" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '起拖时激活窗口'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '按下鼠标就把目标窗口提到最前（AutoFocus=1）。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="AutoFocusBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnToggleChanged" Tag="AutoFocus" />
                    </Grid>

                    <TextBlock Text="{loc:T '刷新率'}" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold"
                               Margin="0,10,0,2" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '移动抽帧'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '每 N 个鼠标事件才写一次窗口（MoveRate）。1 = 每个事件都跟手。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="MoveRateBox" Style="{StaticResource TextBox.Base}" Width="70"
                                     MinHeight="30" Padding="8,2" VerticalContentAlignment="Center"
                                     TextChanged="OnNumberChanged" Tag="MoveRate" />
                            <TextBlock Text="{loc:T '个事件'}" Style="{StaticResource Text.Tertiary}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '缩放抽帧'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '改大小时每 N 个鼠标事件才写一次窗口（ResizeRate）。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="ResizeRateBox" Style="{StaticResource TextBox.Base}" Width="70"
                                     MinHeight="30" Padding="8,2" VerticalContentAlignment="Center"
                                     TextChanged="OnNumberChanged" Tag="ResizeRate" />
                            <TextBlock Text="{loc:T '个事件'}" Style="{StaticResource Text.Tertiary}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>


                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右：状态 + 程序例外 + 窗口例外 + 用法
             两类例外原来在左栏最底下，得自己往下翻才找得到；现在都挪进这张常驻卡，
             版式照「平滑滚动」右栏：挑程序的按钮 + 一行一条的清单 + 一行一条的窗口规则。 -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{loc:T '当前状态'}" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>

                <ScrollViewer x:Name="RightScroll" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,18,0">

                        <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />

                        <TextBlock Text="{loc:T '程序例外'}" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:T '这些程序里的窗口不接管（按进程名，一行一个），* 通配，例如 game*.exe。'}" />
                        <controls:AppPickButtons Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                                 PickFile="OnPickProcess" PickWindow="OnPickWindow" />

                        <ItemsControl x:Name="ProcessExceptionList" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Tertiary}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <!-- 图标化（m01050）：每行一个垃圾桶，比"删除"两个字窄得多，也不会把名字挤断 -->
                                            <Button Grid.Column="1" Content="&#xE74D;" Tag="{Binding Value}"
                                                    Click="OnRemoveProcess"
                                                    Style="{StaticResource Button.Icon}"
                                                    Foreground="{DynamicResource Brush.Danger}"
                                                    Margin="8,0,0,0"
                                                    AutomationProperties.Name="{loc:T '删除'}"
                                                    ToolTip="{loc:T '从例外清单里删掉这一条'}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ProcessExceptionEmpty" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="{loc:T '还没有例外程序：所有程序都用左边的全局参数。'}" />

                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,10,0,4"
                                   Text="{loc:T '一行一个进程名，这些程序完全不接管。支持 * 通配（例如 game*.exe）。'}" />
                        <TextBox x:Name="ProcessBlacklistBox" Style="{StaticResource TextBox.Base}" MinHeight="40"
                                 MaxHeight="64" Margin="0,0,0,0" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Padding="8,6" TextChanged="OnTextChanged" Tag="ProcessBlacklist" />

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,4" />

                        <TextBlock Text="{loc:T '窗口例外'}" Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:T '按窗口标题或窗口类名排除，一行一条，* 通配。比如不想让任务切换器被接管就写 TaskSwitcherWnd。'}" />
                        <TextBox x:Name="WindowBlacklistBox" Style="{StaticResource TextBox.Base}" MinHeight="40"
                                 MaxHeight="64" Margin="0,8,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Padding="8,6" TextChanged="OnTextChanged" Tag="WindowBlacklist" />

                        <Border Style="{StaticResource Divider}" Margin="0,14,0,4" />

                        <TextBlock Text="{loc:T '怎么用'}" Style="{StaticResource Text.Body}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{loc:T '按住触发键不放，然后用鼠标左键拖窗口、右键改大小。拖的时候松不松触发键都行，松鼠标才算结束。'}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="{loc:T '拖的时候按住 Shift 强制贴边（比设置里的档位更高一档），按住空格临时关掉贴边。'}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="{loc:T '按住触发键双击左键：窗口最大化/还原。双击右键：按现在的窗口大小贴成半屏或四分之一屏。'}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="{loc:T '按住 Ctrl 拖：光标被锁在当前这块屏幕里。按住触发键时按一下 Ctrl，会让接下来拖的那个窗口重新接管一次。'}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="{loc:T '拖动中按 Esc 立刻收手（窗口停在原地，不会继续跟着走）。'}" />

                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Border Style="{StaticResource Divider}" Margin="0,0,0,10" />
                    <Button Content="&#xE7A7;" Style="{StaticResource Button.Icon}"
                            HorizontalAlignment="Left" Click="OnResetDefaults"
                            AutomationProperties.Name="{loc:T '恢复默认'}"
                            ToolTip="{loc:T '恢复默认：这一页所有设置都回到出厂值'}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
