<UserControl x:Class="InputPlus.UI.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
             xmlns:controls="clr-namespace:InputPlus.UI.Controls"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：触发键提示 + 筛选 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T '按住'}" Style="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Style="{StaticResource Keycap}" Padding="10,4">
                        <TextBlock x:Name="TriggerKeyText" Text="CapsLock" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="HintText"
                           Text="{loc:T '再看下面的按键 —— 未绑定的键可以到「按键映射」里自己加。'}"
                           Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="14,0,14,0" />

                <!-- 筛选框：换成全软件统一的 SearchField —— 放大镜、清空叉、分类下拉
                     都在框**里面**，外层不用再自己画图标和占位文字。
                     宽度 220 不变：右边还并着「复制速查表」，放宽会把那张卡撑变形。 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:SearchField x:Name="FilterSearch" Width="220"
                                          Placeholder="{loc:T '筛选快捷键…'}"
                                          SearchChanged="OnFilterChanged" />

                    <!-- 速查表最常见的用途是发给别人 / 贴进笔记，直接给一份纯文本 -->
                    <Button x:Name="CopySheetButton" Content="{loc:T '复制速查表'}"
                            Style="{StaticResource Button.Ghost}" Padding="12,7" Margin="8,0,0,0"
                            Click="OnCopySheet"
                            ToolTip="{loc:T '按当前筛选结果复制成纯文本（含层与分组）'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 使用指南 + 全部功能一览（都可折叠，上下排列） -->
        <StackPanel Grid.Row="1">
            <Expander x:Name="GuideExpander" Margin="0,0,0,12" IsExpanded="False"
                      Foreground="{DynamicResource Brush.TextPrimary}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T '使用指南'}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T '每一项功能都有说明：按键映射、手势、设备方案、备份恢复、命令行…（点开查看）'}"
                                   Style="{StaticResource Text.Tertiary}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>

                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,8,0,0">
                    <!-- 指南正文自己滚：章节越加越多（现在 20 节，编号到 ⑱），
                         展开后总高度早就超过一屏。外面这层 Grid 没有滚动条，
                         不限高就会被窗口裁掉下半截 —— 用户点开却读不到后面的章节。 -->
                    <ScrollViewer x:Name="GuideScroll" MaxHeight="420"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GuidePanel">
                            <!-- 由代码填充，内容跟随实际配置 -->
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Expander>

            <!-- 全部功能一览：动作表直接摊开。
                 以前想知道"到底能绑哪些功能"，只能到「按键映射」下拉里逐个分类翻，
                 或者去搜 —— 帮助页说"所有功能"却给不出清单，等于没说完。 -->
            <Expander x:Name="ActionCatalogExpander" Margin="0,0,0,12" IsExpanded="False"
                      Foreground="{DynamicResource Brush.TextPrimary}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T '全部功能一览'}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ActionCatalogHint"
                                   Style="{StaticResource Text.Tertiary}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Expander.Header>

                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,8,0,0">
                    <ScrollViewer x:Name="ActionCatalogScroll" MaxHeight="420"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ActionCatalogPanel">
                            <!-- 由代码从动作表生成 -->
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Expander>
        </StackPanel>

        <!-- 快捷键速查表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Groups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6,8,14">
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H3}" />
                                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource Badge.Text}" />
                                    </Border>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,10,8" Padding="11,9" CornerRadius="{DynamicResource Radius.All}"
                                                    Background="{DynamicResource Brush.SurfaceAlt}"
                                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Border Style="{StaticResource Keycap}" Padding="8,4">
                                                            <TextBlock Text="{Binding Combo}" FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Brush.Accent}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" />
                                                        <TextBlock Text="{Binding Desc}" Style="{StaticResource Text.Tertiary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空态：筛选没命中、或一条绑定都还没有。以前这里是一片空白，
                 用户分不清「没搜到」和「页面没加载」 -->
            <StackPanel x:Name="EmptyHint" Visibility="Collapsed" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Margin="24">
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="26" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextTertiary}" />
                <TextBlock x:Name="EmptyTitle" Text="{loc:T '没有匹配的快捷键'}"
                           Style="{StaticResource Text.Body}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock x:Name="EmptyDesc" Text="{loc:T '换个关键词试试，或到「按键映射」里添加绑定。'}"
                           Style="{StaticResource Text.Tertiary}" HorizontalAlignment="Center"
                           Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" />
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
