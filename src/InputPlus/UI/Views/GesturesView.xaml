<UserControl x:Class="InputPlus.UI.Views.GesturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
             xmlns:controls="clr-namespace:InputPlus.UI.Controls"
             FontFamily="{StaticResource Font.Ui}">
    <UserControl.Resources>
        <!-- 列表行：整行可点。
             Button.Base 的模板把 ContentPresenter 写死成 HorizontalAlignment=Center，
             行内容于是被居中成一小坨；这里换成"内容拉满"的模板，整行才是统一宽度。 -->
        <Style x:Key="Button.GestureRow" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 胶囊形次按钮：录制按键这类操作用它，一眼能看出是可点的按钮。 -->
        <Style x:Key="Button.Pill" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="34" Height="36" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#xE962;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T '鼠标手势：按住鼠标键画一笔，执行一个动作'}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{loc:T '在任意程序里按住右键 / 中键 / 侧键画个形状，松手即执行。不用离开键盘，也不依赖别的软件。'}"
                                   Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 总开关挪到「录制新手势」左边：开关状态一眼看得见，不用先翻设置。 -->
                    <TextBlock Text="{loc:T '启用手势'}" Style="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox x:Name="EnabledBox" Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center" Margin="0,0,14,0"
                              Checked="OnOptionsChanged" Unchecked="OnOptionsChanged"
                              ToolTip="{loc:T '总开关：关掉之后所有鼠标手势都不生效。'}" />
                    <Button Content="{loc:T '录制新手势'}" Style="{StaticResource Button.Primary}"
                            Padding="14,7" Click="OnRecordNewClick" />
                    <!-- 齿轮：外观 / 参数 / 开关快捷键都收进这颗按钮打开的「手势设置」窗。 -->
                    <Button Style="{StaticResource Button.Icon}" Margin="8,0,0,0"
                            Click="OnOpenGestureSettings" Content="&#xE713;"
                            ToolTip="{loc:T '手势设置：外观、参数、开关快捷键'}"
                            AutomationProperties.Name="{loc:T '手势设置'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 外观 / 参数 / 开关快捷键原来在这张卡下面，现在收进右上角齿轮打开的
             「手势设置」窗（GestureSettingsWindow）；这一行整个让出来，下面三栏直接铺满。 -->

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- 左：边缘手势 + 作用目标（全局 / 各个应用程序）
                 这一列必须是 Grid，不能是 StackPanel：StackPanel 给子项无限高，
                 「作用目标」卡里那行 * （手势列表的滚动区）就永远量不到边界，
                 卡片会长到窗口外面 —— 底下没有圆角，也不滚动。 -->
            <Grid Grid.Column="0" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 边缘手势单独一栏：四角悬停 + 贴边滚轮不针对某个程序，
                     混在“作用目标”里会被误认为是一个应用。 -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:T '边缘手势'}" Style="{StaticResource Text.Secondary}"
                                   FontWeight="SemiBold" Margin="6,0,0,8" />
                        <Button x:Name="EdgeTargetButton" HorizontalAlignment="Stretch"
                                Padding="8,7" Click="OnPickEdgeTarget"
                                ToolTip="{loc:T '屏幕四角悬停、上/下边缘滚轮触发的手势'}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.GestureRow}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE7FC;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15" Margin="2,0,9,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:T '边缘手势'}" Style="{StaticResource Text.Body}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{loc:T '四角悬停 / 贴边滚轮'}" Style="{StaticResource Text.Tertiary}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="EdgeTargetCount" Grid.Column="2"
                                           Style="{StaticResource Text.Tertiary}"
                                           Margin="8,0,2,0" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   Margin="6,8,4,0"
                                   Text="{loc:T '四角悬停、上/下边缘滚轮，动作可以单独设置。'}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,12" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{loc:T '作用目标'}" Style="{StaticResource Text.Secondary}"
                               FontWeight="SemiBold" Margin="6,0,0,8" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl x:Name="TargetList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <StackPanel>
                                        <!-- 分组标题（全局 / 分组 / 应用程序 / 特殊目标）：只当分隔线，不可点。 -->
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Tertiary}"
                                                   FontWeight="SemiBold" Margin="8,10,0,4"
                                                   Visibility="{Binding HeaderVisibility}" />
                                        <Grid Margin="0,0,0,2" Visibility="{Binding RowVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" HorizontalAlignment="Stretch" Padding="8,7"
                                                    Click="OnPickTarget" ToolTip="{Binding Tooltip}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Button.GestureRow}">
                                                        <Style.Triggers>
                                                            <!-- 禁用优先画浅红底；选中态放在后面，选中的那行仍然是强调色。 -->
                                                            <DataTrigger Binding="{Binding Disabled}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="15" Margin="2,0,9,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Disabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                                        <Setter Property="Opacity" Value="0.7" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- 「已禁用」不占名字的宽度：塞在名字第二行。
                                                         之前做成名字右边的胶囊，名字被挤成一个点，禁用状态倒是看见了，程序名没了。 -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Disabled}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{loc:T '已禁用'}"
                                                                   Visibility="{Binding DisabledVisibility}"
                                                                   FontSize="10.5" Margin="0,1,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Brush.Danger}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource Text.Tertiary}"
                                                               Margin="8,0,2,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                            <!-- 行尾只留一颗竖三点：禁用/删除收进菜单。
                                                 以前两个文字按钮常驻，一列里躺着几十个「禁用」「删除」，
                                                 名字本来就窄的（msedge / cmd）还被挤掉一截；而且这两件事
                                                 一行里用不了第二次，常驻纯占宽度。 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Button.Icon}" Width="26" Height="26"
                                                        FontSize="13" Content="&#xE712;" Margin="2,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding MenuVisibility}"
                                                        Click="OnTargetMenuClick" ContextMenuOpening="OnTargetMenuOpening"
                                                        ToolTip="{loc:T '更多操作：禁用 / 删除'}"
                                                        AutomationProperties.Name="{loc:T '更多操作'}">
                                                    <Button.ContextMenu>
                                                        <!-- 菜单本身是主题里的 ContextMenu（卡片底 + 圆角 + 悬停高亮）。
                                                             图标塞在 Header 里而不是 MenuItem.Icon：那套模板只渲染 Header。 -->
                                                        <ContextMenu Placement="Bottom">
                                                            <!-- 禁用 / 恢复走原来那颗按钮的处理函数，它认 sender 的 DataContext 当行对象。 -->
                                                            <MenuItem Click="OnToggleTargetDisabled"
                                                                      Visibility="{Binding ToggleVisibility}"
                                                                      ToolTip="{Binding ToggleTooltip}">
                                                                <MenuItem.Header>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding ToggleGlyph}"
                                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                                   FontSize="12" Margin="0,0,8,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                                                        <TextBlock Text="{Binding ToggleText}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </MenuItem.Header>
                                                            </MenuItem>
                                                            <!-- 应用的删除和分组的删除走同一个入口，由 OnDeleteTarget 分辨作用域。 -->
                                                            <MenuItem Click="OnDeleteTarget" Visibility="{Binding DeleteVisibility}"
                                                                      ToolTip="{Binding DeleteTooltip}">
                                                                <MenuItem.Header>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE74D;"
                                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                                   FontSize="12" Margin="0,0,8,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource Brush.Danger}" />
                                                                        <TextBlock Text="{loc:T '删除'}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </MenuItem.Header>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                      </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <controls:AppPickButtons Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                                     PickFile="OnPickTargetFile" PickWindow="OnPickTargetWindow" />
                            <Button Style="{StaticResource Button.Icon}" Width="26" Height="26"
                                    FontSize="12" Content="&#xE710;" Margin="0,6,0,0"
                                    HorizontalAlignment="Left" Click="OnNewGroup"
                                    ToolTip="{loc:T '把几个程序归成一组，共用一套触发方式。'}"
                                    AutomationProperties.Name="{loc:T '新建分组'}" />
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                               Margin="6,8,4,0"
                               Text="{loc:T '选中一个目标，只显示它自己的手势；应用手势优先于全局。'}" />
                </Grid>
                </Border>
            </Grid>

            <!-- 中：该目标下的手势列表 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,0" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题行右端集中放列表工具：按键筛选 → 搜索（平时只有放大镜，点开才长成输入框）
                         → 排序（按钮上只有图标，点开才是四档）。原来这些各占一行/一个胶囊，
                         挤得列表窄了一截，也让"排序"看起来像个设置而不是工具。 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,8,0">
                            <!-- 标题只留名字：条数统计挪到标题行下面单独一行，否则一挤就被截成「这个目标 56…」。 -->
                            <TextBlock x:Name="TargetTitle" Style="{StaticResource Text.H3}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{loc:T '全局的手势'}" />
                        </StackPanel>

                        <!-- 工具组：按键筛选 + 搜索。搜索展开时把前两个收起来、原地换成输入框，
                             这样中间这一栏的标题不会被挤没（卡片本来就窄）。 -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 宽度不写死：模板左右一共留 44px（12 + 32），写死 96 是按英文三四个字母算的，
                                 中文界面下「全部按键」四个字正好差一口气，右边那半个字就被吃掉了。
                                 这里只给下限，真正宽度在 FitFilterBoxWidth() 里按最长选项量出来。 -->
                            <ComboBox x:Name="ButtonFilterBox" Grid.Column="0" MinWidth="96" MinHeight="32"
                                      Style="{StaticResource ComboBox.Base}"
                                      DisplayMemberPath="Text" SelectedValuePath="Value"
                                      SelectionChanged="OnButtonFilterChanged"
                                      ToolTip="{loc:T '按鼠标按键筛选'}"
                                      AutomationProperties.Name="{loc:T '按鼠标按键筛选'}" />
                            <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource Button.Icon}"
                                    Margin="6,0,0,0" Click="OnToggleSearch" Content="&#xE721;"
                                    ToolTip="{loc:T '搜索手势'}"
                                    AutomationProperties.Name="{loc:T '搜索手势'}" />
                            <!-- 宽 = 筛选框 + 6 + 搜索键 32，正好盖住上面两件，不往标题上压。
                                 筛选框宽度是算出来的，所以这里也由 FitFilterBoxWidth() 一起同步。 -->
                            <Grid x:Name="SearchPanel" Grid.ColumnSpan="2" Width="134"
                                  HorizontalAlignment="Right" Visibility="Collapsed">
                                <TextBox x:Name="FilterBox" Style="{StaticResource TextBox.Base}" MinHeight="32"
                                         Padding="30,4,26,4" TextChanged="OnFilterChanged"
                                         KeyDown="OnFilterKeyDown" LostKeyboardFocus="OnFilterLostFocus" />
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextTertiary}" IsHitTestVisible="False" />
                                <TextBlock x:Name="FilterHint" Text="{loc:T '筛选手势…'}" Margin="30,0,26,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextTertiary}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button x:Name="SearchClear" Style="{StaticResource Button.Icon}"
                                        Width="24" Height="24" FontSize="10" Content="&#xE711;"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"
                                        Click="OnClearSearch" ToolTip="{loc:T '清空搜索'}" />
                            </Grid>
                        </Grid>

                        <!-- 排序：按钮只有图标（不带文字），点开才是四档菜单，当前档打勾。 -->
                        <Button x:Name="SortButton" Grid.Column="2" Style="{StaticResource Button.Icon}"
                                Margin="4,0,0,0" Content="&#xE8CB;" Click="OnSortButtonClick"
                                ToolTip="{loc:T '手势列表的排序方式'}"
                                AutomationProperties.Name="{loc:T '手势列表的排序方式'}">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SortMenu">
                                    <MenuItem Tag="custom" IsCheckable="True" Click="OnSortPick"
                                              Header="{loc:T '自定义顺序'}" />
                                    <MenuItem Tag="name" IsCheckable="True" Click="OnSortPick"
                                              Header="{loc:T '按名称'}" />
                                    <MenuItem Tag="trigger" IsCheckable="True" Click="OnSortPick"
                                              Header="{loc:T '按触发方式'}" />
                                    <MenuItem Tag="action" IsCheckable="True" Click="OnSortPick"
                                              Header="{loc:T '按动作'}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>

                    <!-- 这一行是列表的条数统计（「这个目标 N 条 · 全部 M 条」），
                         原来挂在总开关条最右边，开关条拆掉后放回列表自己头上。 -->
                    <TextBlock x:Name="SummaryText" Grid.Row="1" Style="{StaticResource Text.Tertiary}"
                               Margin="2,-6,0,10" TextTrimming="CharacterEllipsis" />

                    <!-- 该目标「允许的触发方式」：照 WGestures 的 TriggerList 抄的，
                         61 条三态（启用 / 禁用 / 默认）。默认 = 跟随上一层：应用 → 分组 → 全局。 -->
                    <Expander x:Name="TriggerExpander" Grid.Row="2" Margin="0,0,0,10" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TriggerHeader" Text="{loc:T '全局 允许的触发方式'}"
                                           Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" />
                                <TextBlock x:Name="TriggerSummary" Style="{StaticResource Text.Tertiary}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="{loc:T '全部启用'}" Tag="on" Click="OnAllTriggers"
                                        Style="{StaticResource Button.Ghost}" Padding="8,3" FontSize="11" />
                                <Button Content="{loc:T '全部禁用'}" Tag="off" Click="OnAllTriggers"
                                        Style="{StaticResource Button.Ghost}" Padding="8,3" FontSize="11" Margin="6,0,0,0" />
                                <Button Content="{loc:T '全部默认'}" Tag="auto" Click="OnAllTriggers"
                                        Style="{StaticResource Button.Ghost}" Padding="8,3" FontSize="11" Margin="6,0,0,0"
                                        ToolTip="{loc:T '清掉这一层的覆盖，全部跟随上一层。'}" />
                            </StackPanel>
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="TriggerList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Button.GestureRow}"
                                                    HorizontalAlignment="Stretch" Padding="8,5" Margin="0,0,0,2"
                                                    Tag="{Binding Key}" Click="OnTriggerClick"
                                                    ToolTip="{Binding Tooltip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               Style="{StaticResource Text.Body}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Background="{Binding StateBackground}"
                                                            CornerRadius="5" Padding="6,2" Margin="6,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StateText}" FontSize="10"
                                                                   Foreground="{Binding StateForeground}" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Expander>

                    <ScrollViewer x:Name="ListScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                        <!-- 拖动排序的收尾挂在列表上：长按满 2 秒后鼠标被列表捕获，
                             后续的移动/抬起都只有列表收得到（行里的 Button 收不到，自然也不会误触发"选中"） -->
                        <ItemsControl x:Name="GestureList" HorizontalAlignment="Stretch"
                                      MouseMove="OnDragMove" MouseLeftButtonUp="OnDragUp"
                                      LostMouseCapture="OnDragLostCapture">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 拖动排序没有手柄：按住这条 400ms，或者按住后直接往上/下拖（≥8px）就进拖动
                                         （见 OnRowPressDown / OnRowPressMove）。四个预览事件都挂在行按钮上，
                                         列表那边的 OnDragMove / OnDragUp / OnDragLostCapture 负责移动和落位。 -->
                                    <Button Style="{StaticResource Button.GestureRow}" HorizontalAlignment="Stretch"
                                            Padding="10,8" Margin="0,0,0,4" Click="OnPickGesture"
                                            Opacity="{Binding RowOpacity}"
                                            ToolTip="{Binding DragTooltip}"
                                            PreviewMouseLeftButtonDown="OnRowPressDown"
                                            PreviewMouseMove="OnRowPressMove"
                                            PreviewMouseLeftButtonUp="OnRowPressUp"
                                            LostMouseCapture="OnRowPressLostCapture">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                                                    Background="{DynamicResource Brush.AccentSoft}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                                               FontSize="14" Foreground="{DynamicResource Brush.Accent}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding GlyphVisibility}" />
                                                    <!-- 笔画手势直接画一条缩略轨迹，比统一鼠标图标更容易认。 -->
                                                    <Polyline Points="{Binding IconPoints}"
                                                              Stroke="{DynamicResource Brush.Accent}"
                                                              StrokeThickness="2"
                                                              StrokeLineJoin="Round"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              Margin="5"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Visibility="{Binding StrokeVisibility}" />
                                                    <!-- 边缘手势：灰框 = 屏幕，红点/红线 = 生效的角或边 -->
                                                    <Image Source="{Binding EdgeIcon}" Width="22" Height="18"
                                                           Stretch="Uniform" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding EdgeIconVisibility}" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Tertiary}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource Brush.AccentSoft}"
                                                        CornerRadius="5" Padding="6,2" Margin="0,0,6,0"
                                                        Visibility="{Binding StateVisibility}">
                                                    <TextBlock Text="{Binding StateText}" FontSize="10"
                                                               Foreground="{DynamicResource Brush.Accent}" />
                                                </Border>
                                                <TextBlock Text="{Binding Badge}" Style="{StaticResource Text.Tertiary}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 插入位置提示线：和列表占同一格、画在它上面。
                         只做视觉提示，不吃鼠标（IsHitTestVisible=False），拖动时鼠标仍在列表手里。 -->
                    <Canvas Grid.Row="3" x:Name="DropLayer" IsHitTestVisible="False" ClipToBounds="True">
                        <Rectangle x:Name="DropLine" Height="2" Width="0" RadiusX="1" RadiusY="1"
                                   Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                    </Canvas>

                    <TextBlock Grid.Row="4" x:Name="EmptyHint" Margin="0,16,0,4"
                               Text="{loc:T '还没有手势。点右上角「录制新手势」画一笔。'}"
                               Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- 右：编辑器 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T '手势详情'}" Style="{StaticResource Text.H3}" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:T '名称'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="NameBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                 Padding="10,4" VerticalContentAlignment="Center" Margin="0,0,0,8" />

                        <StackPanel Margin="0,0,0,12">
                            <CheckBox x:Name="GestureEnabledBox" Style="{StaticResource CheckBox.Text}"
                                      Content="{loc:T '启用手势'}"
                                      ToolTip="{loc:T '取消后这条手势（包括边缘手势）不会触发，配置会保留。'}" />
                            <CheckBox x:Name="ImmediateBox" Style="{StaticResource CheckBox.Text}" Margin="0,6,0,0"
                                      Content="{loc:T '识别手势立即执行'}"
                                      ToolTip="{loc:T '画到能唯一确定这条手势时就执行，不用等松手。默认关：松手后立即执行。'}" />
                            <CheckBox x:Name="HideLabelBox" Style="{StaticResource CheckBox.Text}" Margin="0,6,0,0"
                                      Content="{loc:T '执行时不显示手势名称'}"
                                      ToolTip="{loc:T '触发后不在鼠标旁闪现手势名称；轨迹仍按「显示轨迹」设置。'}" />
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:T '起始键'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,4" />
                                <ComboBox x:Name="ButtonBox" Style="{StaticResource ComboBox.Base}"
                                          SelectionChanged="OnEditorChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:T '触发方式'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,4" />
                                <ComboBox x:Name="KindBox" Style="{StaticResource ComboBox.Base}"
                                          SelectionChanged="OnEditorChanged" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{loc:T '组合键（按住起始键时再点它，可留空）'}"
                                   Style="{StaticResource Text.Secondary}" Margin="0,0,0,4" />
                        <ComboBox x:Name="ChordBox" Style="{StaticResource ComboBox.Base}"
                                  Margin="0,0,0,12" SelectionChanged="OnEditorChanged" />

                        <Grid x:Name="WheelRow" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="{loc:T '滚轮方向'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="WheelBox" Style="{StaticResource ComboBox.Base}" Margin="0,22,0,0" />
                        </Grid>

                        <Grid x:Name="CornerRow" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="{loc:T '感应角落'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CornerBox" Style="{StaticResource ComboBox.Base}" Margin="0,22,0,0" />
                        </Grid>

                        <Grid x:Name="EdgeRow" Margin="0,0,0,12" Visibility="Collapsed"
                              ToolTip="{loc:T '贴边滚轮生效的屏幕边缘；选「任意边缘」则四条边都生效。'}">
                            <TextBlock x:Name="EdgeLabel" Text="{loc:T '屏幕边缘'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="EdgeBox" Style="{StaticResource ComboBox.Base}" Margin="0,22,0,0" />
                        </Grid>

                        <StackPanel x:Name="StrokeRow" Margin="0,0,0,12">
                            <TextBlock Text="{loc:T '笔画'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                            <Border CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Height="120">
                                <Grid>
                                    <Canvas x:Name="PreviewCanvas" ClipToBounds="True">
                                        <Polyline x:Name="PreviewLine" Stroke="{DynamicResource Brush.Accent}"
                                                  StrokeThickness="3" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <!-- 回放画在这一层：底下的静态线压暗，上面一笔一笔走，
                                             笔尖跟一个小圆点。整个动画都在这块框里，不糊屏幕。 -->
                                        <Polyline x:Name="ReplayLine" Stroke="{DynamicResource Brush.Accent}"
                                                  StrokeThickness="3.4" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Visibility="Collapsed" />
                                        <Ellipse x:Name="ReplayHead" Width="9" Height="9"
                                                 Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                                    </Canvas>
                                    <!-- 笔画：存下来的轨迹画在框里，改的时候一眼能对上 -->
                                    <TextBlock x:Name="PatternBadge"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Margin="0,8,12,0"
                                               FontSize="20" FontWeight="Bold"
                                               FontFamily="Segoe UI Symbol"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </Grid>
                            </Border>
                            <!-- 录制和回放并排一行：回放只是"把这一笔重画一遍看看"，不该独占一行（v1.6.0）。 -->
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource Button.Base}"
                                        Padding="14,7" Margin="0,0,8,0"
                                        Click="OnRecordClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7C9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:T '重新录制'}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 回放：只有播放图标 + 提示。放慢之后这一笔要两三秒，
                                     旁边那颗是"重新录制"，两颗并排时"回放"两个字纯占宽度。
                                     名字只留「重新录制」四个字（用户反馈：别把"按住鼠标键画一笔"和括号塞进按钮）。 -->
                                <Button Style="{StaticResource Button.Icon}" Width="36" Height="32"
                                        FontSize="13" Content="&#xE768;" Click="OnReplayClick"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                        Background="{DynamicResource Brush.SurfaceAlt}"
                                        ToolTip="{loc:T '回放这一笔'}"
                                        AutomationProperties.Name="{loc:T '回放这一笔'}" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- 多步手势：一步接一步，按住起始键一路做下来（v1.5.0） -->
                        <StackPanel x:Name="StepsRow" Margin="0,0,0,12" Visibility="Collapsed">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{loc:T '步骤'}" Style="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="StepsHint" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Style="{StaticResource Text.Tertiary}" />
                            </Grid>

                            <Border CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    Padding="8,4" Margin="0,0,0,8">
                                <ItemsControl x:Name="StepList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1"
                                                    BorderBrush="{DynamicResource Brush.Border}" Padding="2,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Index}" Style="{StaticResource Text.Tertiary}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                               Style="{StaticResource Text.Body}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <!-- 每行一颗垃圾桶就够：这里一行只有一个动作，写「删除」会跟步骤标题抢宽度。 -->
                                                    <Button Grid.Column="2" Content="&#xE74D;"
                                                            Style="{StaticResource Button.Icon}" Width="24" Height="24"
                                                            FontSize="11" Margin="4,0,0,0"
                                                            Foreground="{DynamicResource Brush.Danger}"
                                                            Tag="{Binding Step}" Click="OnRemoveStep"
                                                            ToolTip="{loc:T '删掉这一步'}"
                                                            AutomationProperties.Name="{loc:T '删掉这一步'}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <TextBlock x:Name="StepsEmpty" Text="{loc:T '还没有步骤 —— 下面挑一种往里加，停一下再做下一步。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                       Margin="0,0,0,8" />

                            <WrapPanel>
                                <Button Content="{loc:T '画一笔'}" Style="{StaticResource Button.Pill}"
                                        Margin="0,0,6,6" Click="OnAddStrokeStep" />
                                <Button Content="{loc:T '按一组键'}" Style="{StaticResource Button.Pill}"
                                        Margin="0,0,6,6" Click="OnAddKeyStep" />
                                <Button Content="{loc:T '清空'}" Style="{StaticResource Button.Ghost}"
                                        Margin="0,0,0,6" Click="OnClearSteps" />
                            </WrapPanel>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="{loc:T '滚轮'}" Style="{StaticResource Text.Tertiary}"
                                               Margin="0,0,0,3" />
                                    <ComboBox x:Name="StepWheelBox" Style="{StaticResource ComboBox.Base}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock Text="{loc:T '角落'}" Style="{StaticResource Text.Tertiary}"
                                               Margin="0,0,0,3" />
                                    <ComboBox x:Name="StepCornerBox" Style="{StaticResource ComboBox.Base}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:T '屏幕边缘'}" Style="{StaticResource Text.Tertiary}"
                                               Margin="0,0,0,3" />
                                    <ComboBox x:Name="StepEdgeBox" Style="{StaticResource ComboBox.Base}" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="{loc:T '加滚轮'}" Style="{StaticResource Button.Pill}"
                                        Margin="0,0,6,0" Click="OnAddWheelStep" />
                                <Button Content="{loc:T '加角落'}" Style="{StaticResource Button.Pill}"
                                        Margin="0,0,6,0" Click="OnAddCornerStep" />
                                <Button Content="{loc:T '加贴边'}" Style="{StaticResource Button.Pill}"
                                        Click="OnAddEdgeStep" />
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock Text="{loc:T '动作'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,4" />

                        <Border Margin="0,0,0,6" Height="38" CornerRadius="9"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;" FontSize="14"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                                <TextBox x:Name="ActionSearchBox" Grid.Column="1"
                                         Style="{StaticResource TextBox.Base}"
                                         Foreground="{DynamicResource Brush.TextPrimary}"
                                         CaretBrush="{DynamicResource Brush.Accent}"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="0,4" MinHeight="34"
                                         VerticalContentAlignment="Center"
                                         TextChanged="OnActionSearchChanged"
                                         ToolTip="{loc:T '输入功能名称，例如 复制、音量、窗口'}" />
                                <TextBlock x:Name="ActionSearchHint" Grid.Column="1"
                                           Text="{loc:T '搜索功能，例如：复制、音量、窗口'}"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           VerticalAlignment="Center" Margin="2,0,0,0"
                                           IsHitTestVisible="False" />
                                <Button x:Name="ActionSearchClear" Grid.Column="2"
                                        Style="{StaticResource Button.Ghost}"
                                        Width="26" Height="26" Padding="0"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed" Focusable="False"
                                        ToolTip="{loc:T '清除搜索'}"
                                        AutomationProperties.Name="{loc:T '清除搜索'}" Click="OnClearActionSearch">
                                    <TextBlock Text="&#xE711;" FontSize="11"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                </Button>
                            </Grid>
                        </Border>
                        <Border x:Name="ActionSearchPanel" Visibility="Collapsed" Margin="0,0,0,8"
                                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <ListBox x:Name="ActionSearchList" MaxHeight="180" BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource Brush.TextPrimary}"
                                     SelectedValuePath="Value" SelectionChanged="OnActionSearchPicked">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="Transparent"
                                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background"
                                                                    Value="{DynamicResource Brush.BackgroundAlt}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background"
                                                                    Value="{DynamicResource Brush.AccentSoft}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{loc:T '分类'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,5" />
                                <ComboBox x:Name="ActionCategoryBox" Style="{StaticResource ComboBox.Base}"
                                          SelectionChanged="OnActionCategoryChanged" MaxDropDownHeight="420" />
                            </StackPanel>
                            <StackPanel x:Name="ActionFunctionPanel" Grid.Column="1">
                                <TextBlock Text="{loc:T '功能'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,5" />
                                <ComboBox x:Name="ActionBox" Style="{StaticResource ComboBox.Base}"
                                          SelectionChanged="OnActionChanged" MaxDropDownHeight="420" />
                            </StackPanel>
                        </Grid>

                        <TextBox x:Name="ArgBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                 Padding="10,4" VerticalContentAlignment="Center"
                                 Margin="0,0,0,12" Visibility="Collapsed"
                                 LostFocus="OnArgBoxCommit" KeyDown="OnArgBoxKeyDown" />
                        <TextBlock x:Name="ArgHint" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   Margin="0,-8,0,10" Visibility="Collapsed"
                                   Text="{loc:T '直接输按键即可，例如 ctrl+c；多段用空格分开，例如 ctrl+v enter。'}" />
                        <Button x:Name="ArgCaptureButton" Content="{loc:T '录制按键'}" Style="{StaticResource Button.Pill}"
                                Margin="0,0,0,12" HorizontalAlignment="Left"
                                Visibility="Collapsed" Click="OnCaptureArgKey" />
                        <controls:AppPickButtons x:Name="ActionAppPicker" Margin="0,0,0,8"
                                                 Visibility="Collapsed"
                                                 PickFile="OnPickActionAppFile"
                                                 PickWindow="OnPickActionAppWindow" />
                        <TextBlock x:Name="ActionAppStatus" Style="{StaticResource Text.Tertiary}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

                        <TextBlock x:Name="EditorNote" Style="{StaticResource Text.Tertiary}"
                                   TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed" />
                    </StackPanel>
                    </ScrollViewer>

                    <!-- 保存/新建/删除固定在底部：编辑器内容再长也不用滚到底找按钮 -->
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}"
                            Padding="0,12,0,0" Margin="0,4,0,0">
                        <!-- 「保存」留文字（它是这一栏的主行动，也是四个字里唯一不该靠猜的）；
                             旁边两颗各有明确图标，只留图标 + 提示，省下来的宽度让上面那几张下拉喘口气。 -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:T '保存'}" Style="{StaticResource Button.Primary}"
                                    Padding="18,7" Click="OnSaveClick" />
                            <Button Style="{StaticResource Button.Icon}" Width="34" Height="32"
                                    FontSize="13" Content="&#xE710;" Margin="8,0,0,0" Click="OnNewClick"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    ToolTip="{loc:T '新建一条手势'}"
                                    AutomationProperties.Name="{loc:T '新建一条手势'}" />
                            <Button Style="{StaticResource Button.Icon}" Width="34" Height="32"
                                    FontSize="13" Content="&#xE74D;" Margin="8,0,0,0" Click="OnDeleteClick"
                                    Foreground="{DynamicResource Brush.Danger}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    ToolTip="{loc:T '删掉当前这条手势'}"
                                    AutomationProperties.Name="{loc:T '删掉当前这条手势'}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
