<UserControl x:Class="InputPlus.UI.Views.ScrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
             xmlns:controls="clr-namespace:InputPlus.UI.Controls"
             FontFamily="{StaticResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：名字 + 一句话 + 总开关。
             这一页只放"滚轮怎么滚"，不碰手势/按键，所以顶部卡也只有一个开关。 -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="34" Height="36" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#xE74C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T '平滑滚动'}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{loc:T '滚轮不再一格一跳，而是按缓动曲线滑过去。参数与 SmoothScroll 一致。'}"
                                   Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T '启用'}" Style="{StaticResource Text.Secondary}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox x:Name="EnabledBox" Style="{StaticResource ToggleSwitch}"
                              Click="OnEnabledChanged"
                              ToolTip="{loc:T '打开之后，所有程序的滚轮都按下面的参数平滑滚动。'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 左：参数。版式与设置页一致 —— 左边标题 + 说明，右边控件，行间一条分隔线。 -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="18,10,18,14" Margin="0,0,14,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- 右侧多让 12px：这一页的滚动条是叠在内容上的，不留位置会压住单位文字。 -->
                <StackPanel Margin="0,0,12,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '步长'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '滚轮滚一格，内容移动多少像素。SmoothScroll 出厂是 120。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="StepBox" Style="{StaticResource TextBox.Base}" Width="70"
                                     MinHeight="30" Padding="8,2" VerticalContentAlignment="Center"
                                     TextChanged="OnNumberChanged" />
                            <TextBlock Text="{loc:T '像素'}" Style="{StaticResource Text.Tertiary}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '动画时长'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '一格滚轮滑完这段距离用多久。越短越跟手，越长越顺滑。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="DurationBox" Style="{StaticResource TextBox.Base}" Width="70"
                                     MinHeight="30" Padding="8,2" VerticalContentAlignment="Center"
                                     TextChanged="OnNumberChanged" />
                            <TextBlock Text="{loc:T '毫秒'}" Style="{StaticResource Text.Tertiary}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '曲线尾巴'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '越大，后半段拖得越长（4 = 尾巴是前半段的 4 倍长）。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="PulseSlider" Width="130" Minimum="1" Maximum="8"
                                    SmallChange="0.5" LargeChange="1" TickFrequency="0.5"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="OnPulseChanged" />
                            <TextBlock x:Name="PulseText" Style="{StaticResource Text.Secondary}" Width="34"
                                       Margin="8,0,0,0" VerticalAlignment="Center" Text="4.0" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '连续快滚时加速'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '两格之间的间隔小于下面的值时，每格再多滚一点。SmoothScroll 默认关。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="AccelBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Tag="Acceleration" Click="OnToggleField" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '加速触发间隔'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '两次滚轮之间不超过这个毫秒数才算「连着滚」。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="AccelDeltaBox" Style="{StaticResource TextBox.Base}" Width="70"
                                     MinHeight="30" Padding="8,2" VerticalContentAlignment="Center"
                                     TextChanged="OnNumberChanged" />
                            <TextBlock Text="{loc:T '毫秒'}" Style="{StaticResource Text.Tertiary}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '最多加速到几倍'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '再快也不会超过这个倍数，避免一下滚出去半页。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="AccelMaxBox" Style="{StaticResource TextBox.Base}" Width="70"
                                     MinHeight="30" Padding="8,2" VerticalContentAlignment="Center"
                                     TextChanged="OnNumberChanged" />
                            <TextBlock Text="{loc:T '倍'}" Style="{StaticResource Text.Tertiary}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '横向滚动也平滑'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '触摸板左右滑、滚轮左右拨也走同一条曲线。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="HorizontalBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Tag="Horizontal" Click="OnToggleField" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T 'Shift + 滚轮转横向'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '按住 Shift 滚轮，垂直滚动变成平滑的左右滚动（上滚 = 往左）。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ShiftBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Tag="HorizontalShift" Click="OnToggleField" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '反转方向'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '滚轮往上拨，内容往下走。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ReverseBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Tag="Reverse" Click="OnToggleField" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '触摸板精细滚动交给系统'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '触摸板一格会发几十个小 delta，本来就是连续的；再插一层缓动会发黏。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="TouchpadBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Tag="IgnoreTouchpad" Click="OnToggleField" />
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右：程序例外 + 状态行 -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T '程序例外'}" Style="{StaticResource Text.Secondary}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <!-- 添加程序走全软件统一的这两个入口：挑 exe 或准星点窗口，
                         和「按键映射」「手势作用程序」那边长得一模一样。 -->
                    <controls:AppPickButtons Grid.Column="1" Width="212" Margin="8,0,0,0"
                                             PickFile="OnAddApp" PickWindow="OnAddAppWindow" />
                </Grid>

                <TextBlock Grid.Row="1" Margin="0,8,0,2" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                           Text="{loc:T '列表里的程序按各自开关处理；没列出来的都跟随左边的全局参数。'}" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="0,6,0,0">
                    <StackPanel>
                        <ItemsControl x:Name="AppList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                                            Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Tertiary}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ToggleText}"
                                                    Tag="{Binding Rule}" Click="OnToggleApp"
                                                    Style="{StaticResource Button.Ghost}" Padding="8,3" Margin="8,0,0,0" />
                                            <!-- 图标化（m01050）：每行两个文字按钮，应用名被挤得只剩几个字 -->
                                            <Button Grid.Column="2" Content="&#xE74D;"
                                                    Tag="{Binding Rule}" Click="OnDeleteApp"
                                                    Style="{StaticResource Button.Icon}" Margin="6,0,0,0"
                                                    Foreground="{DynamicResource Brush.Danger}"
                                                    AutomationProperties.Name="{loc:T '删除'}"
                                                    ToolTip="{loc:T '删除这条应用例外'}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="{loc:T '还没有例外程序：所有程序都用左边的全局参数。'}" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="3" Style="{StaticResource Divider}" Margin="0,10,0,0" />

                <TextBlock Grid.Row="4" x:Name="StatusText" Style="{StaticResource Text.Tertiary}"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
