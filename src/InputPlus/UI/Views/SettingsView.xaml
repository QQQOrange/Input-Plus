<UserControl x:Class="InputPlus.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
             xmlns:controls="clr-namespace:InputPlus.UI.Controls"
             FontFamily="{DynamicResource Font.Ui}">
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" Padding="24,4,20,20">
        <!-- 不再单独限宽 880：其它页面（快速上手 / 同步与备份 / 按键映射）都是铺满的，
             只有设置页缩在左边，1240 宽时右边空出 130 多、最大化时能空出 700 多，
             切页面时整块内容会"跳一下宽度"。 -->
        <StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T '启动与运行'}" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:T '这些选项会立刻保存，不需要重启程序。'}" Style="{StaticResource Text.Tertiary}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '开机自动启动'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '登录 Windows 后自动在托盘运行'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="StartupBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnStartupChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '关闭窗口时最小化到托盘'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '保留热键继续工作；从托盘菜单可以完全退出'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="TrayBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnTrayChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '启动时打开设置窗口'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '关闭后只在托盘运行，按 Caps+Q 依然可用'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="OpenOnStartBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnOpenOnStartChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '操作后显示轻提示'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '例如切换置顶、复制到剪贴板时，在屏幕角落提示一下'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ToastBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnToastChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 使用统计：把"省时间"量化出来。
                         原来只有一行汇总，用户看得见"共执行 N 次"却不知道是哪些动作，
                         所以这里加了「查看明细」：按动作排行 + 最近 7 天逐日次数。 -->
                    <StackPanel>
                        <TextBlock Text="{loc:T '使用统计'}" Style="{StaticResource Text.Body}" />
                        <TextBlock x:Name="UsageText" Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="UsageDetailButton" Style="{StaticResource Button.Base}" Padding="12,5"
                                    HorizontalAlignment="Left" Content="{loc:T '查看明细'}"
                                    Click="OnUsageDetailClick" />
                            <Button x:Name="UsageResetButton" Style="{StaticResource Button.Base}" Padding="12,5"
                                    Margin="8,0,0,0" HorizontalAlignment="Left"
                                    Content="{loc:T '清空统计'}" Click="OnUsageResetClick" />
                        </StackPanel>

                        <Border x:Name="UsageDetailPanel" Visibility="Collapsed" Margin="0,10,0,0"
                                Padding="12,10" CornerRadius="{DynamicResource Radius.All}" Background="{DynamicResource Brush.SurfaceAlt}">
                            <StackPanel>
                                <TextBlock Text="{loc:T '动作排行'}" Style="{StaticResource Text.Tertiary}" />
                                <ItemsControl x:Name="UsageRankList" Margin="0,6,0,0" />
                                <Border Style="{StaticResource Divider}" Margin="0,10" />
                                <TextBlock Text="{loc:T '最近 7 天'}" Style="{StaticResource Text.Tertiary}" />
                                <TextBlock x:Name="UsageDayText" Style="{StaticResource Text.Secondary}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 按应用自动启用层：只叠加，不接管。
                         分隔线放在小节**内部**：这一节默认折叠，线放外面会与相邻的线并成两条。 -->
                    <StackPanel x:Name="AppLayerSection" Background="Transparent" Visibility="Collapsed">
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="{loc:T '按应用自动启用层'}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{loc:T '切到这些程序时自动叠加它绑定的层：只接管该层绑过的组合，其余按键照常输入。'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AppLayerProcessBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                     ToolTip="{loc:T '进程名，如 Code.exe（大小写不敏感）'}" />
                            <ComboBox x:Name="AppLayerLayerBox" Grid.Column="1" Width="168" Margin="8,0,0,0"
                                      Style="{StaticResource ComboBox.Base}" />
                            <Button x:Name="AppLayerAddButton" Grid.Column="2" Content="{loc:T '添加'}"
                                    Margin="8,0,0,0" Padding="14,6"
                                    Style="{StaticResource Button.Base}" Click="OnAddAppLayerClick" />
                        </Grid>
                        <ItemsControl x:Name="AppLayerList" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- 文本片段（同样默认折叠，分隔线放在内部） -->
                    <StackPanel x:Name="SnippetSection" Background="Transparent" Visibility="Collapsed">
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="{loc:T '文本片段'}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{loc:T '输入触发词后自动展开成一段文字。触发词须以 ; / . 等符号开头（不能是字母数字），且必须落在词首。'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <!-- 两个框各配一行小标签：只靠 ToolTip 的话，空框看起来一模一样，分不清哪个填什么 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T '触发词（如 ;mail）'}" Style="{StaticResource Text.Tertiary}" />
                            <TextBlock Grid.Column="1" Text="{loc:T '展开成什么（可换行）'}" Margin="8,0,0,0"
                                       Style="{StaticResource Text.Tertiary}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SnippetTriggerBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                     ToolTip="{loc:T '例如 ;mail'}" TextChanged="OnSnippetTriggerChanged" />
                            <TextBox x:Name="SnippetTextBox" Grid.Column="1" Margin="8,0,0,0" MinHeight="64"
                                     Style="{StaticResource TextBox.Base}" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="{loc:T '展开后的内容，可换行'}" />
                            <Button x:Name="SnippetSaveButton" Grid.Column="2" Content="{loc:T '添加'}"
                                    Margin="8,0,0,0" Padding="14,6"
                                    Style="{StaticResource Button.Base}" Click="OnAddSnippetClick" />
                            <Button x:Name="SnippetCancelEditButton" Grid.Column="3" Content="{loc:T '取消编辑'}"
                                    Margin="6,0,0,0" Padding="12,6" Visibility="Collapsed"
                                    Style="{StaticResource Button.Ghost}" Click="OnCancelSnippetEdit" />
                        </Grid>
                        <TextBlock x:Name="SnippetTriggerHint" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBox x:Name="SnippetCommentBox" Margin="0,6,0,0" MinHeight="32"
                                 Style="{StaticResource TextBox.Base}"
                                 ToolTip="{loc:T '备注（可选）：只在列表里显示，不影响展开'}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SnippetAppsBox" MinHeight="32"
                                     Style="{StaticResource TextBox.Base}"
                                     ToolTip="{loc:T '留空 = 所有程序都展开'}"
                                     TextChanged="OnSnippetAppsHint" />
                            <controls:AppPickButtons Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0"
                                                     PickFile="OnSnippetPickExeClick"
                                                     PickWindow="OnSnippetPickWindowClick" />
                            <Button Grid.Column="3" Content="{loc:T '填入示例'}" Margin="6,0,0,0" Padding="12,6"
                                    Style="{StaticResource Button.Ghost}" Click="OnSnippetExampleClick"
                                    ToolTip="{loc:T '用一条现成的范例填好表单，照着改就行'}" />
                        </Grid>
                        <TextBlock x:Name="SnippetAppsHint" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="{loc:T '可选：只在哪些程序里展开（进程名，逗号分隔，如 code.exe, notepad.exe）。留空 = 所有程序。'}" />
                        <TextBox x:Name="SnippetTestBox" Margin="0,8,0,0" MinHeight="32"
                                 Style="{StaticResource TextBox.Base}"
                                 ToolTip="{loc:T '试算：在这里敲一段示例，看会不会命中（不会真的展开）'}"
                                 TextChanged="OnSnippetTestChanged" />
                        <TextBlock x:Name="SnippetTestHint" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="{loc:T '试算：在上面随便打一段（例如 ;mail），这里会说命中哪一条、为什么没命中。'}" />
                        <ItemsControl x:Name="SnippetList" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 键盘设备：只读，用于排查"为什么另一只键盘不生效" -->
                    <StackPanel x:Name="KeyboardSection">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:T '键盘设备'}" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="{loc:T '只列出系统认到的键盘，不改任何按键行为。复合键盘常被系统拆成多条，这里已按物理设备归并。'}"
                                           Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:T '刷新'}" Padding="12,5" VerticalAlignment="Top"
                                    Style="{StaticResource Button.Base}" Click="OnRefreshKeyboardsClick" />
                        </Grid>
                        <TextBlock x:Name="KeyboardEmptyText" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,8,0,0" Visibility="Collapsed"
                                   Text="{loc:T '没有枚举到键盘设备。'}" />
                        <TextBlock x:Name="DeviceTrackingHint" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{DynamicResource Brush.Danger}" />
                        <ItemsControl x:Name="KeyboardList" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 权限：普通权限下对着管理员程序按快捷键会静默失效，所以要显眼 -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:T '以管理员身份启动'}" Style="{StaticResource Text.Body}" />
                                    <Border x:Name="AdminBadge" Margin="8,0,0,0" Padding="7,1"
                                            CornerRadius="{DynamicResource Radius.All}" Background="{DynamicResource Brush.WarningSoft}"
                                            BorderBrush="{DynamicResource Brush.WarningBorder}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="AdminBadgeText" Text="{loc:T '管理员'}" FontSize="10.5"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="PermissionText" Style="{StaticResource Text.Tertiary}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />

                                <!-- 管理员模式下热键可能整体失效：给一个一键回到普通权限的出口。
                                     注意这是**用户点击**才执行，程序自己不会擅自重启。 -->
                                <Button x:Name="RestartUnelevatedButton" Content="{loc:T '以普通权限重启'}"
                                        Style="{StaticResource Button.Base}" Padding="10,5" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Click="OnRestartUnelevatedClick"
                                        Visibility="Collapsed"
                                        ToolTip="{loc:T '热键没反应时点一下：关掉管理员模式并用普通权限重新启动'}" />
                            </StackPanel>

                            <!--
                                提权开关。
                                ⚠ 切到管理员后，「选中文字 → 直接搜索」会失效 ——
                                管理员进程无法向普通权限的浏览器 / 编辑器注入输入
                                （Windows 的 UIPI 限制）。所以默认关闭。
                            -->
                            <CheckBox Grid.Column="1" x:Name="RunAsAdminBox" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="OnRunAsAdminChanged"
                                      ToolTip="{loc:T '开启后下次启动会弹一次 UAC 确认。注意：管理员权限下部分机器（安全软件 / UIPI）会让键盘钩子收不到按键，热键会完全失效 —— 遇到这种情况请关掉它'}" />
                        </Grid>

                        <!--
                            状态行：把"设置成什么"和"现在实际是什么"分开显示。
                            两者不一致时给一个「立即重启」按钮 ——
                            否则用户改完开关以为已经生效，实际上要等下次启动，
                            中间会一直以为功能坏了。
                        -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AdminStateText" Grid.Column="0"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button x:Name="RestartElevatedButton" Grid.Column="1"
                                    Style="{StaticResource Button.Base}" Padding="12,5"
                                    Content="{loc:T '立即重启以生效'}" Visibility="Collapsed"
                                    Click="OnRestartForElevation" />
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <!--
                        启动密码：和「同步与备份」页的备份密码完全是两回事。
                        那一个给备份文件和本地数据加密；这一个只卡启动 ——
                        用户点名要求分开，所以字段、校验、入口全都独立。
                    -->
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:T '启动密码保护'}" Style="{StaticResource Text.Body}" />
                                <TextBlock Text="{loc:T '每次启动软件时先要求输入密码，正确才进入主界面'}"
                                           Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="StartupPwBox" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="OnStartupPasswordChanged"
                                      ToolTip="{loc:T '开启时需要先设置一个新密码；关闭时需要验证当前密码'}" />
                        </Grid>

                        <!-- 状态行 + 修改密码按钮（设了才显示） -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StartupPwStateText" Grid.Column="0"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ChangeStartupPwButton" Grid.Column="1"
                                    Style="{StaticResource Button.Base}" Padding="12,5"
                                    Content="{loc:T '修改密码'}" Visibility="Collapsed"
                                    Click="OnChangeStartupPassword" />
                        </Grid>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '更新完成后弹提示'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '自动更新装上新版后，在屏幕角落提示一句「已更新到 x.x.x」'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="UpdateToastBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnUpdateToastChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '显示按键反馈'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '每次组合键生效时在屏幕角落闪一下功能名，用来确认按键有没有被识别'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="FeedbackBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnFeedbackChanged" />
                    </Grid>

                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T '按键行为'}" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />

                    <!-- 唤出窗口的缩放动画：开关 + 时长（Capslox 绑窗唤出的观感）。
                         关掉只影响"播不播"，窗口切换本身照旧（WindowBindingService.Summon 里先判开关）。 -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '唤出窗口时播缩放动画'}" Style="{StaticResource Text.Body}" />
                            <TextBlock x:Name="SummonAnimText" Text="{loc:T '170 毫秒（60~400）'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="SummonAnimBox" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="OnSummonAnimChanged" />
                            <Slider x:Name="SummonAnimSlider" Width="140" Margin="12,0,0,0"
                                    Minimum="60" Maximum="400" IsSnapToTickEnabled="True" TickFrequency="10"
                                    VerticalAlignment="Center" ValueChanged="OnSummonAnimDurationChanged" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 短按触发键的行为（原来这里有个「短按 CapsLock」下拉）已经删掉：
                         触发键的短按 / 长按 / 双击统一在「触发键与层」页编辑，
                         同一个手势在两处能设成不同结果只会让人困惑。
                         这里只留“怎么打字 / 连发 / 灵敏度”这类全局参数。 -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '输入文本方式'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '「输入文本」怎么把文字打进光标处。默认「自动」：长文本走剪贴板粘贴（粘完把剪贴板还原），短文本英文走真实按键（密码框也认）、中文走 Unicode 注入；中文输入法开着时会临时切到英文输入，打完自动切回。密码框仍打不进时改选「真实按键」（此时长文本也逐字敲，可能被程序吞字）。'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="TextInputBox" Style="{StaticResource ComboBox.Base}"
                                  SelectionChanged="OnTextInputModeChanged">
                            <ComboBoxItem Content="{loc:T '自动（推荐）'}" Tag="auto" />
                            <ComboBoxItem Content="{loc:T '真实按键'}" Tag="keys" />
                            <ComboBoxItem Content="{loc:T 'Unicode 注入'}" Tag="unicode" />
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '按住组合键时连续触发'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '按住 Caps+S 不松手可以一直向左移动光标'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="RepeatBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnRepeatChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '鼠标移动速度'}" Style="{StaticResource Text.Body}" />
                            <TextBlock x:Name="MouseSpeedText" Text="{loc:T '3（Caps+LAlt+滚轮 可快速调整）'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Slider Grid.Column="1" x:Name="MouseSpeedSlider" Width="180" Minimum="1" Maximum="20"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                ValueChanged="OnMouseSpeedChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '音量调节幅度'}" Style="{StaticResource Text.Body}" />
                            <TextBlock x:Name="VolumeStepText" Text="5%"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Slider Grid.Column="1" x:Name="VolumeStepSlider" Width="180" Minimum="1" Maximum="20"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                ValueChanged="OnVolumeStepChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '亮度调节幅度'}" Style="{StaticResource Text.Body}" />
                            <TextBlock x:Name="BrightnessStepText" Text="10%"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Slider Grid.Column="1" x:Name="BrightnessStepSlider" Width="180" Minimum="1" Maximum="50"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                ValueChanged="OnBrightnessStepChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T '外观'}" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '主题'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '跟随系统会随 Windows 的深浅色设置自动切换'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="ThemeBox" Style="{StaticResource ComboBox.Base}"
                                  SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="{loc:T '浅色'}" Tag="light" />
                            <ComboBoxItem Content="{loc:T '深色'}" Tag="dark" />
                            <ComboBoxItem Content="{loc:T '跟随系统'}" Tag="system" />
                        </ComboBox>
                    </Grid>

                    <!-- 界面字体（v1.4.3）：整个软件的文字都跟着这一项走 ——
                         菜单、按钮、各页面、附加功能窗口、浮层与提示条都在内。
                         下拉里每一项用它**自己的字体**渲染（一眼看出是哪种字），
                         选中的那套字立刻套到界面上，不用重启。
                         条目在 Refresh() 里按需建一次，见 BuildFontList。 -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '界面字体'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '系统里已安装的字体都能选：菜单、按钮和各附加功能窗口一起换，改完立即生效。'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock x:Name="FontPreviewText"
                                           Text="{loc:T '预览：输入增强 Aa 0123'}"
                                           Style="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Center" />
                                <Button Content="{loc:T '恢复默认'}" Style="{StaticResource Button.Ghost}" Padding="8,3"
                                        Margin="12,0,0,0" VerticalAlignment="Center" Click="OnResetFont"
                                        ToolTip="{loc:T '改回出厂字体（微软雅黑 + 西文兜底）。'}" />
                                <Button Content="{loc:T '重新扫描'}" Style="{StaticResource Button.Ghost}" Padding="8,3"
                                        Margin="6,0,0,0" VerticalAlignment="Center" Click="OnRescanFonts"
                                        ToolTip="{loc:T '刚装了新字体、下拉里还看不到时点这里。'}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <!-- 统一搜索框（这一页**没有分类**：字体只有"名字"一列，
                                 中文名和注册表英文名本来就该一起匹配，见 BuildFontList）。
                                 放大镜和清空叉都在框里，外层不用再画一层占位文字。
                                 ↓ / Enter 直接进下拉：PreviewKeyDown 挂在控件上，它比
                                 里面那个输入框先收到隧道事件，所以 Enter 先由这里处理。 -->
                            <controls:SearchField x:Name="FontSearchBox"
                                                  Placeholder="{loc:T '搜索字体…'}"
                                                  SearchChanged="OnFontSearchChanged"
                                                  PreviewKeyDown="OnFontSearchKeyDown"
                                                  ToolTip="{loc:T '输入字体名过滤（中文或英文都行），按 ↓ 进入列表'}" />
                            <ComboBox x:Name="FontBox" Margin="0,6,0,0" Style="{StaticResource ComboBox.Base}"
                                      MaxDropDownHeight="420" SelectionChanged="OnFontChanged" />
                        </StackPanel>
                    </Grid>

                    <!-- 等宽区域：脚本、公式、计时这几处本来是刻意用等宽的。
                         默认也跟随（用户要的是"整个软件一起换"），留这一行是给
                         "要等宽观感"的人一条退路。 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '等宽区域也跟随'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T 'Lua 脚本、公式输入、录制计时这几处。关掉就保持等宽字体（Cascadia Mono / Consolas）。'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="FontMonoBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnFontMonoChanged" />
                    </Grid>

                        <!-- 触发键的星标大小：以前写死在代码里（1.5 倍），用户没法调。 -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:T '触发键星标大小'}" Style="{StaticResource Text.Body}" />
                                <TextBlock x:Name="TriggerStarText" Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Slider Grid.Column="1" x:Name="TriggerStarSlider" Minimum="1.0" Maximum="2.5"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="OnTriggerStarScaleChanged" />
                        </Grid>

                    <!-- 界面语言：条目来自内置语言包（Assets/Lang/*.json），
                         丢一个新 json 进来就会自动出现在这个下拉里，不用改代码。 -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '界面语言'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '切换后立即生效，不用重启'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="LanguageBox" Style="{StaticResource ComboBox.Base}"
                                  SelectionChanged="OnLanguageChanged">
                            <!-- 用 ItemTemplate 而不是 DisplayMemberPath：
                                 胶囊里显示的是 ComboBox 的 SelectionBoxItem，
                                 这条路径对 DisplayMemberPath 的处理不可靠 ——
                                 v4.5.26 就在这里显示成 `LocLanguage { Code …`。
                                 明细模板两条路（胶囊 + 下拉项）都会走，最稳。 -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 提示条（v1.6.3）：这里只管右下角那类提示 —— 动作反馈、复制成功、音量百分比。
                 手势名称有自己的外观（「鼠标手势 → 手势设置」），两套不再互相牵制：
                 名称框要跟着手势调出现高度、要分「认出来 / 已执行」两档底色，
                 提示条固定贴右下角、只有一种底色。 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T '提示条'}" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:T '除手势名称以外的提示都从屏幕右下角浮出来：动作反馈、复制成功、音量百分比…… 描边和底色在这里调，改完立刻生效。'}"
                               Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:T '画手势时的手势名称请到『鼠标手势 → 手势设置』里调。'}"
                               Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '描边'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '提示条外面的那圈白边。'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="ToastBorderBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnToastToggleChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '描边粗细'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '0.5 是一条细线，3.0 是一圈明显的白框。'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="ToastBorderSlider" Width="120" Minimum="0.5" Maximum="3"
                                    SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" ValueChanged="OnToastBorderChanged" />
                            <TextBlock x:Name="ToastBorderText" Style="{StaticResource Text.Secondary}" Width="40"
                                       Margin="8,0,0,0" VerticalAlignment="Center" Text="1.0" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '底色'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '带透明度也行：淡一点能看见后面的窗口，但不挡字。'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Ghost}" Padding="8,3"
                                    Tag="toast" Click="OnPickToastColor"
                                    ToolTip="{loc:T '提示条的底色（保留透明度）。'}">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="ToastColorSwatch" Width="16" Height="16" CornerRadius="{DynamicResource Radius.All}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                    <TextBlock Text="{loc:T '选择颜色'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Content="{loc:T '默认'}" Style="{StaticResource Button.Ghost}" Padding="8,3"
                                    Margin="6,0,0,0" VerticalAlignment="Center" Click="OnResetToastColor" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '预览'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '弹一条真提示看看效果 —— 用的就是上面这些设置，不用先去保存。'}"
                                       Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{loc:T '弹一条'}" Style="{StaticResource Button.Ghost}"
                                VerticalAlignment="Center" Click="OnPreviewToast" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:T '数据与维护'}" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />
                    <TextBlock x:Name="DataPathText" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                               Margin="0,6,0,14" />
                    <WrapPanel>
                        <Button Content="{loc:T '导入'}" Style="{StaticResource Button.Base}"
                                Margin="0,0,8,8" Click="OnImportClick"
                                ToolTip="{loc:T '导入导出的配置（.clpconf）或备份文件；旧版 CapsLock+ 的 settings.ini 也能直接选'}" />
                        <Button Content="{loc:T '打开设置文件'}" Style="{StaticResource Button.Base}" Margin="0,0,8,8"
                                Click="OnOpenSettingsFile" />
                        <Button Content="{loc:T '打开日志'}" Style="{StaticResource Button.Base}" Margin="0,0,8,8"
                                Click="OnOpenLog" />
                        <Button Content="{loc:T '重新加载配置'}" Style="{StaticResource Button.Base}" Margin="0,0,8,8"
                                Click="OnReload" />
                        <Button Content="{loc:T '重置全部设置'}" Style="{StaticResource Button.Danger}" Margin="0,0,8,8"
                                Click="OnResetAll" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
