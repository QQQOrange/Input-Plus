<UserControl x:Class="InputPlus.UI.Views.HotstringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
             xmlns:controls="clr-namespace:InputPlus.UI.Controls"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ① 页头：和 Qbar / 按键映射同一套版式（图标 + 标题 + 说明） -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,15" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Margin="0">
                    <TextBlock Style="{StaticResource Text.H2}" Text="{loc:T '打一个别名，自动变成一大段文字'}" />
                    <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="{loc:T '打完别名再按空格就替换（也可以关掉，改用 Caps+Tab 展开）。触发符号点开胶囊挑一个，别名前面打它就会展开。'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ② 别名设置：标签在上、控件在下，和设置页一致 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:T '别名设置'}" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="AuditButton" Content="{loc:T '体检'}"
                                Style="{StaticResource Button.Ghost}" Padding="9,4"
                                Click="OnAuditClick"
                                ToolTip="{loc:T '检查重复触发词、空内容、前缀不对、分组未登记等问题'}" />
                        <Button x:Name="RecoverButton" Content="{loc:T '找回丢失的别名'}"
                                Style="{StaticResource Button.Ghost}" Padding="9,4" Margin="8,0,0,0"
                                Click="OnRecoverClick"
                                ToolTip="{loc:T '从以前的设置备份里找出当前没有的别名，挑着恢复回来'}" />
                    </StackPanel>
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="{loc:T '触发符号'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,5" />
                        <Button x:Name="PrefixCapsule" Style="{StaticResource Button.Base}" MinHeight="34"
                                Padding="12,3" HorizontalContentAlignment="Left" Click="OnPrefixCapsuleClick"
                                ToolTip="{loc:T '点开挑一个符号：别名前面打它就会展开'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PrefixGlyphText" Text=":" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="PrefixNameText" Style="{StaticResource Text.Tertiary}"
                                           Margin="8,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="▾" Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Popup x:Name="PrefixPopup" PlacementTarget="{Binding ElementName=PrefixCapsule}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               PopupAnimation="Fade" VerticalOffset="6">
                            <Border Style="{StaticResource Card.Popup}" Padding="6" MinWidth="164">
                                <StackPanel x:Name="PrefixChoiceList" />
                            </Border>
                        </Popup>
                    </StackPanel>

                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="{loc:T '展开方式'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,7" />
                        <CheckBox x:Name="SpaceBox" Content="{loc:T '空格展开'}" Click="OnOptionsChanged"
                                  ToolTip="{loc:T '打完别名按空格就替换；关掉则只认 Caps+Tab'}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="{loc:T '空格处理'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,7" />
                        <CheckBox x:Name="SwallowBox" Content="{loc:T '吞掉那个空格'}" Click="OnOptionsChanged"
                                  ToolTip="{loc:T '替换后不再多出一个空格'}" />
                    </StackPanel>

                    <!-- 原来这里有个「输入法：展开后自动按一下 Shift」的勾选。
                         已按用户要求整条删掉：按 Shift 就是替用户切中/英模式，
                         等于"软件自己换输入法"。现在展开前后都不碰输入法状态。 -->

                    <StackPanel MaxWidth="360">
                        <TextBlock Text="{loc:T '列表显示'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,7" />
                        <!-- 以前这里写着"只显示备注"：那时正文列其实是备注列。
                             现在正文 / 备注各占一列，这句必须跟上，否则用户会以为列表里看不到正文。 -->
                        <TextBlock Text="{loc:T '正文与备注分成两列；格子放不下时把鼠标停上去看全文'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ③ 主体：左分组 / 中列表 / 右编辑 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 分组 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,14,16,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T '分组'}" Style="{StaticResource Text.H3}" />
                            <TextBlock Text="{loc:T '筛选 · 拖动排序'}" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />

                        </StackPanel>
                        <Button Grid.Column="1" x:Name="NewGroupButton" Content="+"
                                Style="{StaticResource Button.Ghost}" Padding="8,2" FontSize="15"
                                VerticalAlignment="Top" Click="OnNewGroupClick"
                                ToolTip="{loc:T '新建分组（也可以右键列表里的别名「移到分组」）'}"
                                AutomationProperties.Name="{loc:T '新建分组'}" />
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="GroupList" Background="Transparent" BorderThickness="0"
                             Margin="10,6,10,12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnGroupChanged"
                             ContextMenuOpening="OnGroupContextMenuOpening"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnGroupMouseDown"
                             PreviewMouseMove="OnGroupMouseMove"
                             PreviewKeyDown="OnGroupListKeyDown"
                             DragEnter="OnGroupDragOver" DragOver="OnGroupDragOver"
                             DragLeave="OnGroupDragLeave" Drop="OnGroupDrop">
                        <!-- 菜单挂在**每个列表项**上：WPF 只有在事件源元素自己带 ContextMenu 时才会
                             抛 ContextMenuOpening 并打开菜单；挂在 ListBox 上是不会冒泡触发的。 -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8B7;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextTertiary}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <!-- 分组名**左对齐**：以前 TextAlignment=Center，一列组名像居中的
                                         标题，扫视时对不齐；名称长短不一时中心点各不同，找组很费眼。 -->
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               TextAlignment="Left" HorizontalAlignment="Stretch" Margin="8,0,12,0"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />


                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 底部操作条：选中分组后可直接改名 / 删除（和右侧列表的操作条同一套版式） -->
                    <!-- 底部操作条：三等分，宽度固定，避免最后一个按钮被卡片边缘裁掉。 -->
                    <!-- 图标化（m01050）：分组条原来是「重命名 / 删除 / 导出」三个文字按钮，
                         12px 字号下中文在窄列里要挤成两行，改成图标 + 读屏名 + 提示，横排三等分各放一颗。 -->
                    <UniformGrid Grid.Row="2" Columns="3" Margin="10,0,10,12">
                        <Button x:Name="RenameGroupButton" Content="&#xE8AC;"
                                Style="{StaticResource Button.Icon}" HorizontalAlignment="Center"
                                IsEnabled="False" Click="OnRenameGroupClick"
                                AutomationProperties.Name="{loc:T '重命名分组'}"
                                ToolTip="{loc:T '重命名分组'}" />
                        <Button x:Name="DeleteGroupButton" Content="&#xE74D;"
                                Style="{StaticResource Button.Icon}" HorizontalAlignment="Center"
                                Foreground="{DynamicResource Brush.Danger}"
                                IsEnabled="False" Click="OnDeleteGroupClick"
                                AutomationProperties.Name="{loc:T '删除分组'}"
                                ToolTip="{loc:T '删除分组（组里的别名不会删，会变成未分组）'}" />
                        <Button x:Name="ExportGroupButton" Content="&#xE896;"
                                Style="{StaticResource Button.Icon}" HorizontalAlignment="Center"
                                Click="OnExportGroupClick"
                                AutomationProperties.Name="{loc:T '导出分组'}"
                                ToolTip="{loc:T '只导出当前分组的别名；选「全部」时导出全部'}" />
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- 列表 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{loc:T '全部别名'}" Style="{StaticResource Text.H3}"
                                   VerticalAlignment="Center" />

                        <!-- 单行：搜索框自适应（最小 180），计数靠右。
                             用 Grid 而不是 StackPanel —— 右侧控件按内容定宽，搜索框吃掉剩余空间。
                             搜索框是**全软件统一那个控件**（放大镜/清空/分类都在框里），
                             分类 = 别名关键字 / 别名正文 / 备注：先选列，再打字，就只搜这一列。
                             「从未使用」勾选与排序下拉已按用户要求删除 —— 排序只剩点列头那一套。 -->
                        <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <controls:SearchField Grid.Column="0" x:Name="FilterField"
                                                  Placeholder="{loc:T '搜索别名…'}"
                                                  SearchChanged="OnFilterChanged"
                                                  SearchSubmitted="OnFilterSubmitted"
                                                  SearchCancelled="OnFilterCancelled" />

                            <TextBlock Grid.Column="1" x:Name="FilterCount" Style="{StaticResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="52"
                                       TextAlignment="Right" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.Resources>
                            <!-- 停用的别名整行压暗：DataGrid 没有 ItemTemplate，
                                 所以用行样式去绑 Row.Opacity（和之前的 ListBox 行一致）。 -->
                            <Style x:Key="EntryRow" TargetType="DataGridRow" BasedOn="{StaticResource Grid.Row}">
                                <Setter Property="Opacity" Value="{Binding Opacity}" />
                                <!-- 右键菜单由 OnEntryContextMenuOpening 现场填，这里只挂一个空壳：
                                     ContextMenuOpening 只会从**带 ContextMenu 的元素**上冒出来。 -->
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>

                        <!-- 这张表与 Qbar 设置页「搜索指令」那张表**是同一份实现**：
                             DataGrid + Grid.Row / Grid.Cell / Grid.Header 三套样式，
                             底色也是 Brush.SurfaceAlt + 圆角 8。
                             为什么不继续用 ListBox 自己画表头：列头、点击排序、拖列宽都是
                             DataGrid 的原生能力，手搓的按钮表头永远差一截（字重、箭头、
                             悬停、发丝线都要一像素一像素对），改一次对一次太脆。 -->
                        <!-- 列头排序由我们自己接管（见 OnEntryHeaderClick）：交给 DataGrid 的话，
                             它会在 ItemsSource 换掉之后再排一遍，两套 comparer 打架，
                             屏幕上看到的顺序就和列头对不上。所以 CanUserSortColumns=False。 -->
                        <Border x:Name="EntryGridHost" Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="{DynamicResource Radius.All}" Padding="0,2" Margin="8,0,8,4">
                            <DataGrid x:Name="EntryList"
                                      Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                                      HeadersVisibility="Column" GridLinesVisibility="None"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="False"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      FontFamily="{DynamicResource Font.Ui}" FontSize="12"
                                      RowHeight="30" ColumnHeaderHeight="28"
                                      HorizontalScrollBarVisibility="Disabled"
                                      RowStyle="{StaticResource EntryRow}"
                                      CellStyle="{StaticResource Grid.Cell}"
                                      ColumnHeaderStyle="{StaticResource Grid.Header}"
                                      SelectionChanged="OnSelectionChanged"
                                      ContextMenuOpening="OnEntryContextMenuOpening"
                                      PreviewMouseLeftButtonDown="OnEntryMouseDown"
                                      PreviewMouseMove="OnEntryMouseMove"
                                      AllowDrop="True" DragOver="OnEntryListDragOver" Drop="OnEntryListDrop">
                                <DataGrid.Columns>
                                    <!-- 关键字：前缀小方块 + 别名，和 Qbar 那列「图标 + 文字」同一个版式。 -->
                                    <DataGridTemplateColumn Header="{loc:T '别名关键字'}" Width="160"
                                                            CanUserSort="True" SortMemberPath="KeyLabel">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="{DynamicResource Radius.All}"
                                                            Margin="0,0,6,0" VerticalAlignment="Center"
                                                            Background="{DynamicResource Brush.AccentSoft}"
                                                            ToolTip="{loc:T '当前前缀符号'}">
                                                        <TextBlock Text="{Binding PrefixLabel}" FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brush.Accent}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding KeyLabel}"
                                                               Style="{StaticResource Grid.CellText}"
                                                               FontWeight="SemiBold"
                                                               ToolTip="{Binding KeyLabel}"
                                                               Foreground="{DynamicResource Brush.Accent}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="{loc:T '别名正文'}" Width="*"
                                                            CanUserSort="True" SortMemberPath="Preview">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Preview}" Style="{StaticResource Grid.CellText}"
                                                           ToolTip="{Binding Preview}"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="{loc:T '备注'}" Width="150"
                                                            CanUserSort="True" SortMemberPath="CommentLabel">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CommentLabel}"
                                                           Style="{StaticResource Grid.CellText}"
                                                           ToolTip="{Binding CommentLabel}"
                                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="{loc:T '分组'}" Width="110"
                                                            CanUserSort="True" SortMemberPath="GroupLabel">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding GroupLabel}"
                                                           Style="{StaticResource Grid.CellText}"
                                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="{loc:T '使用'}" Width="64"
                                                            CanUserSort="True" SortMemberPath="UsageLabel">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding UsageLabel}"
                                                           Style="{StaticResource Grid.CellText}"
                                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- 空态浮在表的上面（表自己不能没有，否则列头也跟着消失） -->
                        <TextBlock x:Name="EmptyHint" Text="{loc:T '还没有别名。点下面的「新增」建一条。'}"
                                   Style="{StaticResource Text.Tertiary}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap"
                                   MaxWidth="260" TextAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <!-- 图标化（m01050）：这一排原来全是文字按钮，列表的底部空间被吃掉一截。 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,8,16,14">
                        <Button Content="&#xE710;" Style="{StaticResource Button.Icon}" Click="OnAddClick"
                                Background="{DynamicResource Brush.Accent}"
                                BorderBrush="{DynamicResource Brush.Accent}" Foreground="White"
                                AutomationProperties.Name="{loc:T '新增别名'}"
                                ToolTip="{loc:T '新增别名'}" />
                        <Button x:Name="DeleteButton" Content="&#xE74D;" Style="{StaticResource Button.Icon}"
                                Margin="6,0,0,0" Foreground="{DynamicResource Brush.Danger}" Click="OnDeleteClick"
                                AutomationProperties.Name="{loc:T '删除别名'}"
                                ToolTip="{loc:T '删除选中的别名'}" />
                        <Button x:Name="MoveButton" Content="&#xE8DE;" Style="{StaticResource Button.Icon}"
                                Margin="6,0,0,0" Click="OnMoveClick" IsEnabled="False"
                                AutomationProperties.Name="{loc:T '移到分组'}"
                                ToolTip="{loc:T '把选中的别名放到某个分组里（也可以直接把别名拖到左侧分组上）'}" />
                        <Button x:Name="ImportButton" Content="&#xE898;" Style="{StaticResource Button.Icon}"
                                Margin="6,0,0,0" Click="OnImportClick"
                                AutomationProperties.Name="{loc:T '导入别名'}"
                                ToolTip="{loc:T '从 JSON 文件导入别名（合并，不会删掉已有的）'}" />
                        <Button x:Name="ExportButton" Content="&#xE896;" Style="{StaticResource Button.Icon}"
                                Margin="6,0,0,0" Click="OnExportClick"
                                AutomationProperties.Name="{loc:T '导出别名'}"
                                ToolTip="{loc:T '把全部别名导出成 JSON，换机器时用得上'}" />
                        <TextBlock Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="360"
                                   Text="{loc:T '别名不显示前缀符号；保存时会自动补回去。右键条目可以复制或移到分组。'}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 编辑（没选片段时整栏隐藏）
                 结构：标题行固定 + 正文自己滚。以前整块是一个 StackPanel，窗口一矮，
                 下半截（分组、启用、状态）就被裁在卡片外面 —— 用户看到的是
                 "编辑别名展开了，关不掉，也不能上下滚"。 -->
            <Border Grid.Column="2" x:Name="EditorCard" Style="{StaticResource Card}" Padding="0"
                    Width="360" Margin="12,0,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T '编辑别名'}" Style="{StaticResource Text.H3}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="CloseEditorButton" Content="&#xE8BB;"
                                Style="{StaticResource Button.Icon}" Width="28" Height="28"
                                Click="OnCloseEditorClick"
                                AutomationProperties.Name="{loc:T '关闭编辑'}"
                                ToolTip="{loc:T '关闭编辑（Esc 也行）'}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" x:Name="EditorScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="18,0,10,14" Focusable="False">
                        <StackPanel>
                            <TextBlock x:Name="EditTitle" Text="" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,0,0,12" TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{loc:T '别名关键字'}" Style="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="PasteTriggerButton" Content="{loc:T '从剪贴板'}"
                                Style="{StaticResource Button.Ghost}" Padding="9,3,9,3"
                                HorizontalAlignment="Right" FontSize="11"
                                Click="OnPasteTriggerClick"
                                ToolTip="{loc:T '输入法打不出中文时，把触发词先复制到剪贴板，点这里粘进来'}" />
                    </Grid>
                    <TextBox x:Name="KeyBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                             VerticalContentAlignment="Center" TextChanged="OnEditorChanged"
                             ToolTip="{loc:T '打完它再按空格就替换；中文和符号都可以，但不能以英文字母/数字开头'}" />

                    <TextBlock Text="{loc:T '别名正文'}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                    <TextBox x:Name="ValueBox" Height="150" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Style="{StaticResource TextBox.Base}"
                             TextChanged="OnEditorChanged" />

                    <TextBlock Text="{loc:T '备注（鼠标停在列表左侧图标上即可看到）'}" Style="{StaticResource Text.Secondary}"
                               Margin="0,12,0,6" />
                    <TextBox x:Name="CommentBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                             VerticalContentAlignment="Center" TextChanged="OnEditorChanged" />

                    <TextBlock Text="{loc:T '只在这些程序里展开（可选）'}" Style="{StaticResource Text.Secondary}"
                               Margin="0,12,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="AppsBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                                 VerticalContentAlignment="Center" TextChanged="OnEditorChanged"
                                 ToolTip="{loc:T '进程名，逗号分隔，例如 code.exe, notepad.exe；留空 = 所有程序'}" />

                        <controls:AppPickButtons Grid.Column="1" Grid.ColumnSpan="2" Margin="6,0,0,0"
                                                 PickFile="OnPickAppFile"
                                                 PickWindow="OnPickAppWindow" />
                    </Grid>

                    <TextBlock Text="{loc:T '分组'}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 用 TextBox 而不是可编辑 ComboBox：下拉框在失焦时会把用户手打的新组名
                             还原成"选中的那一项"，这正是"分组改不了"的来源。 -->
                        <TextBox Grid.Column="0" x:Name="GroupBox" Style="{StaticResource TextBox.Base}"
                                 MinHeight="36" VerticalContentAlignment="Center"
                                 TextChanged="OnEditorChanged"
                                 ToolTip="{loc:T '可以直接输入新组名；也可以点右边的「选择…」从已有分组里挑'}" />

                        <Button Grid.Column="1" Content="{loc:T '选择…'}" Style="{StaticResource Button.Base}"
                                Padding="9,5" Margin="6,0,0,0" Click="OnPickGroupClick"
                                ToolTip="{loc:T '从现有分组里选一个'}" />
                        <Button Grid.Column="2" Content="{loc:T '新建…'}" Style="{StaticResource Button.Base}"
                                Padding="9,5" Margin="6,0,0,0" Click="OnNewGroupClick"
                                ToolTip="{loc:T '新建一个分组'}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,5,0,0" TextWrapping="Wrap"
                               Text="{loc:T '换一个分组 = 把这条别名移过去；也可以把列表里的别名直接拖到左边的分组上。'}" />

                    <TextBlock x:Name="UsageText" Style="{StaticResource Text.Tertiary}"
                               Margin="0,8,0,0" Text="" />

                    <!-- 分组选择弹层 -->
                    <Popup x:Name="GroupPicker" StaysOpen="False" AllowsTransparency="True"
                           Placement="Bottom" PlacementTarget="{Binding ElementName=GroupBox}">
                        <Border Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.All}" Padding="5" Margin="8"
                                TextElement.Foreground="{DynamicResource Brush.TextPrimary}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.32" Color="#000000" />
                            </Border.Effect>
                            <StackPanel MinWidth="180">
                                <TextBlock Text="{loc:T '选一个分组'}" Style="{StaticResource Text.Tertiary}"
                                           Margin="9,6,9,4" />
                                <ListBox x:Name="GroupPickerList" Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource RowItem}" MaxHeight="220"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonUp="OnGroupPickerPicked" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <CheckBox x:Name="EnabledBox" Content="{loc:T '启用这个别名'}" Margin="0,14,0,0"
                              Click="OnEditorChanged" />

                    <TextBlock x:Name="StatusText" Text="" Style="{StaticResource Text.Tertiary}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
