<UserControl x:Class="InputPlus.UI.Views.QbarSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
             xmlns:controls="clr-namespace:InputPlus.UI.Controls"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid Margin="24,4,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <Border x:Name="IntroCard" Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="34" Height="36" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#xE773;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T 'Qbar：一个输入框搞定搜索、启动、计算'}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{loc:T '按 Caps+Q 打开。输入 bd 关键词 搜索、输入程序名回车启动、输入 =1+2*3 直接算。'}"
                                   Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:T '现在试一下'}" Style="{StaticResource Button.Primary}"
                        Click="OnTryClick" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 左：条目管理 -->
        <Border x:Name="EntriesCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0"
                                SelectionChanged="OnTabChanged">
                        <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Cursor" Value="Hand" />
                            <!-- 这排标签压在 Brush.Surface 卡片上，未选中态必须自己给前景色：
                                 不给就会继承 WPF 默认黑字，夜间 Surface(#1A1E27) 上就是黑底黑字。
                                 底/字全走主题画刷，日间夜间都过 4.5:1（自检 TestQbarTabContrast 守着）。 -->
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <!-- 底边 2px 常驻，选中只换颜色，避免切换标签时高度跳动 -->
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                                Padding="12,6" Margin="0,0,4,0">
                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Brush.Hover}" />
                                                <Setter Property="TextElement.Foreground"
                                                        Value="{DynamicResource Brush.TextPrimary}" />
                                            </Trigger>
                                            <!-- 选中：AccentSoft 底 + TextPrimary 字。不用 Accent 字是因为
                                                 日间 Accent(#2B6CF6)/AccentSoft(#E8F0FF) 只有约 4.0:1，压线。 -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Brush.AccentSoft}" />
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource Brush.Accent}" />
                                                <Setter Property="TextElement.Foreground"
                                                        Value="{DynamicResource Brush.TextPrimary}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>
                    <TabItem Header="{loc:T '搜索指令'}" Tag="search" />
                    <!-- 文件搜排在「搜索指令」和「启动程序」之间：它也是"输入关键字得出结果"，
                         和搜索指令同类；而它是唯一需要逐条编辑过滤器/优先级的页面，放最后会被忽略。 -->
                    <TabItem Header="{loc:T '文件搜索'}" Tag="files" />
                    <TabItem Header="{loc:T '启动程序'}" Tag="run" />
                    <TabItem Header="{loc:T '常用网址'}" Tag="web" />
                    <TabItem Header="{loc:T '固定项'}" Tag="pinned" />
                    <!-- 中键菜单独立成一页：它是一整条功能的三个开关（总开关 / 用哪份 / 范围），
                         塞进别的标签只会被当成那页的一个小选项。 -->
                    <TabItem Header="{loc:T '附加菜单'}" Tag="middle" />
                </TabControl>

                <!-- 过滤框：按关键字或备注模糊搜索当前标签下的条目（「文件搜」标签下整块隐藏） -->
                <Grid x:Name="EntriesFilter" Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" x:Name="FilterBox" Style="{StaticResource TextBox.Base}"
                             MinHeight="34" VerticalContentAlignment="Center"
                             TextChanged="OnFilterChanged" />
                    <TextBlock Grid.Column="2" x:Name="FilterCount" Style="{StaticResource Text.Tertiary}"
                               VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="70"
                               TextAlignment="Right" />
                </Grid>
                </Grid>

                <!-- 四个列表（搜索指令 / 启动程序 / 常用网址 / 固定项）共用这张表。
                     用 DataGrid 而不是 ListView+GridView：列头、点击排序、列宽拖动都是原生能力。
                     外面套一层圆角 8 的 SurfaceAlt —— 和本页「过滤器」「优先级」两张表格同一个底色，
                     左栏里就不会只有这张表是直角的"外挂表格"。
                     行 / 格 / 列头三套样式都在 Theme\Controls.xaml（Grid.Row / Grid.Cell / Grid.Header）：
                     系统默认选中是"直角 + 实心系统蓝 + 整行盖满"，那里换成了和 RowItem
                     同一套的圆角选中块（悬停 Brush.Hover、选中 Brush.Selected）。 -->
                <Border x:Name="EntryGridHost" Grid.Row="2" Margin="0,10,0,0"
                        Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="0,2">
                    <DataGrid x:Name="EntryGrid"
                              Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserSortColumns="True"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              FontFamily="{DynamicResource Font.Ui}" FontSize="12"
                              RowHeight="30" ColumnHeaderHeight="28"
                              HorizontalScrollBarVisibility="Disabled"
                              RowStyle="{StaticResource Grid.Row}"
                              CellStyle="{StaticResource Grid.Cell}"
                              ColumnHeaderStyle="{StaticResource Grid.Header}"
                              PreviewMouseLeftButtonDown="OnEntryRowPressDown"
                              PreviewMouseMove="OnEntryRowMouseMove"
                              PreviewMouseLeftButtonUp="OnEntryRowMouseUp"
                              LostMouseCapture="OnEntryLostCapture"
                              SelectionChanged="OnEntrySelected"
                              Sorting="OnEntryGridSorting">
                        <DataGrid.Columns>
                            <!-- 关键字：72 → 96。
                                 72 的时候 8 个字母（deepseek / github 这类）就显示成 "deepse…"，
                                 关键字这一列一眼看不出是哪一条。96 能让常见英文关键字整词显示，
                                 更长的靠省略号；用户自己拖过的宽度由 ColumnWidthChanged 记下来。 -->
                            <DataGridTemplateColumn Header="{loc:T '关键字'}" Width="96" CanUserSort="True"
                                                    SortMemberPath="Key">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,5,0"
                                                  VerticalAlignment="Center">
                                                <Border Background="{Binding LetterBrush}" CornerRadius="4"
                                                        Visibility="{Binding NoIconVisibility}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="9" FontWeight="SemiBold"
                                                               Foreground="White" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{Binding Icon}" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasIconVisibility}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Key}"
                                                       Style="{StaticResource Grid.CellText}" FontWeight="SemiBold"
                                                       ToolTip="{Binding Key}"
                                                       Foreground="{DynamicResource Brush.Accent}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 内容 / 备注用模板列，不用 DataGridTextColumn。
                                 DataGridTextColumn 生成的 TextBlock 自带一套行盒，和关键字那列
                                 （图标 + 文字的 Grid）各按各的行盒居中，上下就差一两个像素 ——
                                 用户看到的就是"关键字、内容、备注不在一条水平线上"。
                                 模板列里四列共用 Grid.CellText 的字号 / 行高 / 行盒策略，偏差归零。 -->
                            <DataGridTemplateColumn Header="{loc:T '内容'}" Width="*" CanUserSort="True"
                                                    SortMemberPath="Value">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource Grid.CellText}"
                                                   ToolTip="{Binding Value}"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{loc:T '备注'}" Width="140" CanUserSort="True"
                                                    SortMemberPath="Comment">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Comment}" Style="{StaticResource Grid.CellText}"
                                                   ToolTip="{Binding Comment}"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 附加菜单：84 → 70，刚好放得下四个字。
                                 "附加菜单" 11.5px 约 46 + 左右内边距 16 = 62，留 8 给拖动把手；
                                 再宽就是白占「内容」那列的地方。 -->
                            <DataGridTemplateColumn Header="{loc:T '附加菜单'}" Width="70"
                                                    CanUserSort="True" SortMemberPath="ShowInMiddleMenu">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  Visibility="{Binding MiddleMenuVisibility}"
                                                  IsChecked="{Binding ShowInMiddleMenu, Mode=OneWay}"
                                                  ToolTip="{loc:T '勾上后这一条会出现在附加菜单里。'}"
                                                  Click="OnEntryMiddleMenuClick" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <StackPanel x:Name="EntriesActions" Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{loc:T '新增'}" Style="{StaticResource Button.Primary}" Click="OnAddClick" />
                    <Button Content="{loc:T '删除'}" Style="{StaticResource Button.Danger}" Margin="8,0,0,0"
                            Click="OnDeleteClick" />
                    <TextBlock x:Name="EntryHint" Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center"
                               Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="380" />
                </StackPanel>

                <!-- 中键菜单：三个开关 + 一句说明（说明只在设置页里出现，菜单本身不显示任何介绍）。 -->
                <!-- 附加菜单：一整页。鼠标唤出只认中键/侧键且只在桌面；键盘唤出所有场景可用；
                     例外程序用「选择程序 / 点选窗口」加；全屏不接管直接复用鼠标手势那个开关。
                     版式紧凑：每组一行，行距 6，说明用 11px 三级字。 -->
                <Grid x:Name="MiddleMenuPanel" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,2,10,10">

                            <Border Style="{StaticResource Card}" Padding="16,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="{loc:T '启用附加菜单'}" Style="{StaticResource Text.Body}" />
                                            <TextBlock Text="{loc:T '桌面空白处、资源管理器（文件/文件夹上或空白处）、打开保存与选文件夹对话框里，按下面勾选的鼠标键即可唤出；键盘组合键在任何程序里都能唤出。'}"
                                                       Style="{StaticResource Text.Tertiary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" x:Name="MiddleMenuEnabledBox" Style="{StaticResource ToggleSwitch}"
                                                  VerticalAlignment="Center" Click="OnMiddleMenuToggleChanged" />
                                    </Grid>

                                    <Border Style="{StaticResource Divider}" Margin="0,10,0,0" />

                                    <!-- 鼠标唤出 -->
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{loc:T '鼠标唤出'}" Style="{StaticResource Text.Body}" />
                                        <TextBlock Text="{loc:T '桌面空白处、资源管理器、打开保存与选文件夹对话框里生效；浏览器正文、编辑器、终端这些地方不接管。'}"
                                                   Style="{StaticResource Text.Tertiary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{loc:T '菜单右上角的星标可以把当前网页、文件夹或程序一键收藏进 Qbar 固定项。'}"
                                                   Style="{StaticResource Text.Tertiary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <CheckBox x:Name="MouseMiddleBox" Content="{loc:T '中键'}" Margin="0,0,16,0"
                                                      Click="OnMouseButtonChanged" />
                                            <CheckBox x:Name="MouseX1Box" Content="{loc:T '侧键 1'}" Margin="0,0,16,0"
                                                      Click="OnMouseButtonChanged" />
                                            <CheckBox x:Name="MouseX2Box" Content="{loc:T '侧键 2'}"
                                                      Click="OnMouseButtonChanged" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <Border Style="{StaticResource Divider}" Margin="0,10,0,0" />

                                    <!-- 当前文件（v1.5.1）：菜单最上面那两条 -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="{loc:T '收藏当前文件 / 打开文件所在位置'}" Style="{StaticResource Text.Body}" />
                                            <TextBlock Text="{loc:T '菜单最上面那两条：把前台程序正在打开的那个文件收进固定项，或在资源管理器里定位它。前台是资源管理器、桌面、任务栏时这两条是灰的。'}"
                                                       Style="{StaticResource Text.Tertiary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <!-- 皮肤必须跟本页其它下拉一致（v1.5.1）：
                                             这里以前漏了 Style，用的是 WPF 默认的灰白 3D 下拉，
                                             跟整套主题完全不是一个东西（用户一眼就看出来了）。 -->
                                        <ComboBox x:Name="RevealModeBox" Grid.Column="1" MinWidth="148"
                                                  Style="{StaticResource ComboBox.Base}" VerticalAlignment="Center"
                                                  SelectionChanged="OnRevealModeChanged">
                                            <ComboBoxItem Content="{loc:T '打开并选中文件'}" Tag="selectFile" />
                                            <ComboBoxItem Content="{loc:T '只打开文件夹'}" Tag="openFolderOnly" />
                                        </ComboBox>
                                    </Grid>

                                    <Border Style="{StaticResource Divider}" Margin="0,10,0,0" />
                                    <!-- 键盘唤出 -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="{loc:T '键盘唤出'}" Style="{StaticResource Text.Body}" />
                                            <TextBlock Text="{loc:T '任何程序里都能唤出（全屏程序与例外程序除外），弹出位置仍在鼠标处。'}"
                                                       Style="{StaticResource Text.Tertiary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBox x:Name="MiddleHotkeyBox" Style="{StaticResource TextBox.Base}" Width="112"
                                                     MinHeight="28" Padding="8,2" IsReadOnly="True" VerticalContentAlignment="Center" />
                                            <Button Content="{loc:T '录制'}" Style="{StaticResource Button.Ghost}"
                                                    Margin="4,0,0,0" Padding="8,2" Click="OnCaptureAttachHotkey" />
                                            <Button Content="{loc:T '清除'}" Style="{StaticResource Button.Ghost}"
                                                    Margin="2,0,0,0" Padding="8,2" Click="OnClearAttachHotkey" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource Divider}" Margin="0,10,0,0" />

                                    <!-- 例外程序 -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="{loc:T '例外程序'}" Style="{StaticResource Text.Body}" />
                                            <TextBlock Text="{loc:T '这些程序里连键盘唤出也不弹（鼠标那一路只在桌面、资源管理器与文件对话框里生效）。'}"
                                                       Style="{StaticResource Text.Tertiary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                            <!-- 与「文件搜索 → 命令」「按应用」同一个控件：两个并列入口，别处长什么样这里就什么样 -->
                                            <controls:AppPickButtons x:Name="ExceptionPicker" MinWidth="230"
                                                                     PickFile="OnAddExceptionFile" PickWindow="OnAddExceptionWindow" />
                                            <Button Content="{loc:T '删除'}" Style="{StaticResource Button.Ghost}"
                                                    HorizontalAlignment="Right" Margin="0,4,0,0" Padding="8,2"
                                                    Click="OnRemoveException" />
                                        </StackPanel>
                                    </Grid>
                                    <ListBox x:Name="ExceptionList" Background="{DynamicResource Brush.SurfaceAlt}"
                                             BorderThickness="0" Margin="0,6,0,0"
                                             MaxHeight="108" Padding="4"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Tertiary}"
                                                               FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Style="{StaticResource Divider}" Margin="0,10,0,0" />

                                    <!-- 全屏 + 用哪份菜单 -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="{loc:T '全屏程序里不接管'}" Style="{StaticResource Text.Body}" />
                                            <TextBlock Text="{loc:T '和「鼠标手势 → 手势设置」里那一条是同一个开关：真全屏（游戏 / 播放器 / F11）时不弹。'}"
                                                       Style="{StaticResource Text.Tertiary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" x:Name="AttachFullscreenBox" Style="{StaticResource ToggleSwitch}"
                                                  VerticalAlignment="Center" Click="OnAttachFullscreenChanged" />
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <!-- 文件搜：Qbar 文件搜索的全部设置都在这一页。
                     为什么单独一页：过滤器和优先级规则是「列表 + 逐条编辑」型数据，
                     360px 的右栏连一张扩展名表都塞不下一行；而且它们改的是「搜什么、怎么排」，
                     和左边的搜索指令/启动程序不是一类东西，混在一起只会让人找不着。 -->
                <Grid x:Name="FileSearchPanel" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        页内目录：这一页有索引、过滤器、优先级、命令、语法五张卡，
                        连起来要滚三屏多。目录固定在顶上（不随内容滚走），点一下就跳到卡，
                        滚动时反过来点亮当前卡 —— 不然看完优先级就分不清自己在第几屏。
                    -->
                    <Border Grid.Row="0" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="9"
                            Padding="6,5" Margin="0,0,0,10">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Padding="0">
                            <StackPanel x:Name="FileToc" Orientation="Horizontal" />
                        </ScrollViewer>
                    </Border>

                    <ScrollViewer Grid.Row="1" x:Name="FileScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="OnFileScrollChanged">
                        <StackPanel x:Name="FileScrollContent">

                            <!-- 文件对话框浮层：第三方程序弹「打开 / 保存」时，在对话框下沿浮出一条 qbar 风格的搜索栏。
                                 这张卡只管配置；真正的浮层由 FileDialogBarService 按总开关/类型/进程三重判定后挂出，
                                 所以这里的开关都必须在“判定阶段”生效，关掉就不会建窗口。
                                 浮条菜单里的「设置」会直接把这一卡滚进视野（见 ScrollToFileDialogBar）。 -->
                            

                            <!-- 索引与后端 -->
                            <Border x:Name="CardBackend" Style="{StaticResource Card}" Padding="18,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:T '索引与后端'}" Style="{StaticResource Text.H3}" />
                                    <TextBlock Text="{loc:T '索引与检索全部在本程序里完成：文件和文件夹的索引放在数据目录下的 file-index-tantivy 文件夹，随建随用，不安装、不启动任何外部程序，也不写注册表。'}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,5,0,12" TextWrapping="Wrap" />

                                    <Border Background="{DynamicResource Brush.SurfaceAlt}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="9" Padding="11,9">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="IndexDot" Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{DynamicResource Brush.TextTertiary}" />
                                                <TextBlock x:Name="IndexState" Style="{StaticResource Text.Secondary}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Text="{loc:T '正在检测…'}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:Name="IndexInfo" Style="{StaticResource Text.Tertiary}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                                            <TextBlock x:Name="IndexDetail" Style="{StaticResource Text.Tertiary}"
                                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 只读状态行：后端固定为进程内索引（单一后端）。以前这里是个「优先用外部索引 / 否则本地快照」的开关，留着只会让人以为还能切回去。 -->
                                    <TextBlock x:Name="SemanticBackendNote" Style="{StaticResource Text.Tertiary}" Margin="0,12,0,0"
                                               TextWrapping="Wrap"
                                               Text="{loc:T '检索后端：进程内 tantivy 索引（固定，没有第二条路）。索引没就绪时搜索会明确提示，不会悄悄换源。'}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{loc:T '刷新状态'}" Style="{StaticResource Button.Ghost}"
                                                Padding="10,5" Click="OnRefreshIndex" />
                                        <Button x:Name="RebuildIndexButton" Content="{loc:T '重建索引'}" Style="{StaticResource Button.Ghost}"
                                                Padding="10,5" Margin="8,0,0,0" Click="OnRebuildIndex"
                                                ToolTip="{loc:T '丢掉现有索引重扫一遍（索引就在本程序里，不装任何外部软件）。'}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 过滤器 -->
                            <Border x:Name="CardFilters" Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:T '过滤器'}" Style="{StaticResource Text.H3}" />
                                    <TextBlock Text="{loc:T '在搜索框里打「关键字 + 空格」就生效（例如 doc␣ 会立刻只剩 49 类文档，再接着打关键词就是在这类文件里搜）；老写法 doc: 也照样认。内置过滤器可以改扩展名、可以停用，但不能删除 —— 删掉 doc: 这种肌肉记忆，比不支持还难用。'}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,5,0,12" TextWrapping="Wrap" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 表格化：一行一个过滤器，开关就在行尾。选中行在下面改细节。 -->
                                        <Border Grid.Column="0" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="0,2">
                                            <ScrollViewer MaxHeight="264" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <Grid Margin="12,7,58,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="86" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{loc:T '名称'}" Style="{StaticResource Text.Tertiary}" />
                                                        <TextBlock Grid.Column="1" Text="{loc:T '关键字'}" Style="{StaticResource Text.Tertiary}" />
                                                        <TextBlock Grid.Column="2" Text="{loc:T '文件类型'}" Style="{StaticResource Text.Tertiary}" />
                                                        <TextBlock Grid.Column="3" Text="{loc:T '搜索范围'}" Style="{StaticResource Text.Tertiary}" />
                                                    </Grid>
                                                    <StackPanel x:Name="FilterRows" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <Button Content="{loc:T '新增'}" Style="{StaticResource Button.Primary}" Click="OnFilterAdd" />
                                            <Button Content="{loc:T '删除'}" Style="{StaticResource Button.Danger}" Margin="0,8,0,0" Click="OnFilterDelete" />
                                            <Button Content="{loc:T '恢复内置'}" Style="{StaticResource Button.Ghost}" Margin="0,8,0,0" Padding="10,5" Click="OnFilterResetBuiltin"
                                                    ToolTip="{loc:T '把内置过滤器的扩展名表和关键字改回出厂值；自定义过滤器不受影响。'}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:T '名称'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                                            <TextBox x:Name="FilterNameBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                                     VerticalContentAlignment="Center" TextChanged="OnFilterFieldChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:T '关键字（输入 关键字: 生效）'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                                            <TextBox x:Name="FilterKeywordBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                                     VerticalContentAlignment="Center" TextChanged="OnFilterFieldChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{loc:T '扩展名（分号或空格分隔，不带点；目录过滤器可以留空）'}"
                                               Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                                    <TextBox x:Name="FilterExtBox" Style="{StaticResource TextBox.Base}" MinHeight="62"
                                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             TextChanged="OnFilterFieldChanged" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:T '自动追加的搜索词（可选）'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                                            <TextBox x:Name="FilterExtraBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                                     VerticalContentAlignment="Center" TextChanged="OnFilterFieldChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:T '限定目录（可选，多个用分号分隔）'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                                            <TextBox x:Name="FilterFolderBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                                     VerticalContentAlignment="Center" TextChanged="OnFilterFieldChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{loc:T '只看某个时间之后改过的（可选：today / week / 2026-07 / 2026-07-01..2026-07-31）'}"
                                               Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                                    <TextBox x:Name="FilterDateBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                             VerticalContentAlignment="Center" TextChanged="OnFilterFieldChanged" />

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <CheckBox x:Name="FilterEnabledBox" Content="{loc:T '启用'}"
                                                  Style="{StaticResource CheckBox.Text}" Click="OnFilterFlagChanged" />
                                        <CheckBox x:Name="FilterFilesBox" Content="{loc:T '包含文件'}" Margin="16,0,0,0"
                                                  Style="{StaticResource CheckBox.Text}" Click="OnFilterFlagChanged" />
                                        <CheckBox x:Name="FilterFoldersBox" Content="{loc:T '包含目录'}" Margin="16,0,0,0"
                                                  Style="{StaticResource CheckBox.Text}" Click="OnFilterFlagChanged" />
                                    </StackPanel>

                                    <TextBlock x:Name="FilterHint" Style="{StaticResource Text.Tertiary}"
                                               TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 优先级 -->
                            <Border x:Name="CardPriority" Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:T '优先级'}" Style="{StaticResource Text.H3}" />
                                    <TextBlock Text="{loc:T '索引层没有优先级这个概念，所以规则只在查询结果上跑：改一条立刻生效，不重建索引、也不把文件从索引里弄丢。目录是子树（含子目录），正则是文件名正则，空正则表示整个目录。'}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,5,0,12" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="{loc:T '+ 添加优先级'}" Style="{StaticResource Button.Primary}" Click="OnRuleAdd" />
                                        <Button Content="{loc:T '排除文件夹'}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Click="OnRuleExcludeFolder"
                                                ToolTip="{loc:T '选一个目录，它会从搜索结果里彻底消失（当作没索引）。'}" />
                                        <Button Content="{loc:T '规则清单'}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Padding="10,5" Click="OnShowSemanticInfo"
                                                ToolTip="{loc:T '把内置规则包和自定义规则一起列出来，用来确认到底哪条规则在起作用。'}" />
                                        <Button Content="{loc:T '删除'}" Style="{StaticResource Button.Danger}" Margin="8,0,0,0" Click="OnRuleDelete" />
                                    </StackPanel>
                                    <!-- 分组照 Listary 那张表：高 / 正常 / 低 / 从搜索结果中排除，行尾都是开关。 -->
                                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="0,2">
                                        <ScrollViewer MaxHeight="352" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="RuleRows" />
                                        </ScrollViewer>
                                    </Border>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:T '目录（可留空 = 任意目录）'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{loc:T '选…'}" Style="{StaticResource Button.Ghost}"
                                                        Padding="9,4" Margin="6,0,0,0" Click="OnRulePickFolder" />
                                                <TextBox x:Name="RuleFolderBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                                         VerticalContentAlignment="Center" TextChanged="OnRuleFieldChanged" />
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:T '文件名正则（可留空 = 目录内全部）'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                                            <TextBox x:Name="RuleRegexBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                                     VerticalContentAlignment="Center" TextChanged="OnRuleFieldChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:T '档位'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                                            <ComboBox x:Name="RuleLevelBox" Style="{StaticResource ComboBox.Base}" MinHeight="34"
                                                      SelectionChanged="OnRuleLevelChanged">
                                                <ComboBoxItem Content="{loc:T '最高优先（前置）'}" Tag="high" />
                                                <ComboBoxItem Content="{loc:T '正常'}" Tag="normal" />
                                                <ComboBoxItem Content="{loc:T '靠后'}" Tag="low" />
                                                <ComboBoxItem Content="{loc:T '忽略（隐藏并提示条数）'}" Tag="ignored" />
                                                <ComboBoxItem Content="{loc:T '完全不显示（当作未索引）'}" Tag="dontindex" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:T '备注（可选，用来记住为什么加这条）'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                                            <TextBox x:Name="RuleNoteBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                                     VerticalContentAlignment="Center" TextChanged="OnRuleFieldChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <CheckBox x:Name="RuleEnabledBox" Content="{loc:T '启用这条规则'}"
                                                  Style="{StaticResource CheckBox.Text}" Click="OnRuleFlagChanged" />
                                    </StackPanel>

                                    <TextBlock x:Name="RuleHint" Style="{StaticResource Text.Tertiary}"
                                               TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 命令：输入「关键字 空格 参数」就执行。让 ol / cmd 这类关键字有地方改。 -->
                            <Border x:Name="CardCommands" Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:T '命令'}" Style="{StaticResource Text.H3}" />
                                    <TextBlock Text="{loc:T '在输入框里打「关键字 空格 参数」就执行。参数里 {query} 代表关键字后面那段原文；带空格要自己加引号。内置命令（cmd / psh / ol / 新建文件 …）全都能改：程序、参数、工作目录、关键字，改完立刻生效，按「恢复默认」退回出厂值。新建文件 / 复制路径 / 上一级这类内部动作默认由软件自己完成，在「程序」里填了 exe 就改成启动它。'}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,5,0,12" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="{loc:T '+ 新增命令'}" Style="{StaticResource Button.Primary}" Click="OnCommandAdd" />
                                        <Button Content="{loc:T '删除'}" Style="{StaticResource Button.Danger}" Margin="8,0,0,0" Click="OnCommandDelete" />
                                        <Button Content="{loc:T '命令清单'}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Padding="10,5"
                                                Click="OnShowSemanticInfo"
                                                ToolTip="{loc:T '列出内置命令和自己的命令，用来确认关键字到底被谁占了。'}" />
                                        <Button Content="{loc:T '恢复默认'}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Padding="10,5"
                                                Click="OnCommandRevert"
                                                ToolTip="{loc:T '把当前选中的内置命令退回出厂值；自己加的命令不受影响（直接删）。'}" />
                                    </StackPanel>
                                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="0,2">
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="CommandRows" />
                                        </ScrollViewer>
                                    </Border>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:T '关键字'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                                            <TextBox x:Name="CommandKeywordBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                                     VerticalContentAlignment="Center" TextChanged="OnCommandFieldChanged" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:T '标题（列表里显示的名字）'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                                            <TextBox x:Name="CommandTitleBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                                     VerticalContentAlignment="Center" TextChanged="OnCommandFieldChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{loc:T '程序（可以只写 notepad 这样的裸程序名，交给系统 PATH 解析）'}"
                                               Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                                    <TextBox x:Name="CommandPathBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                             VerticalContentAlignment="Center" TextChanged="OnCommandFieldChanged" />
                                    <!-- 和「按应用」「窗口绑定」用同一个控件：两个并列入口 ——
                                         「选择程序…」挑 exe（程序没启动也能选），「点选窗口」直接在屏幕上点那扇窗，
                                         由窗口反查 exe 路径。比一个「选…」按钮清楚，也不用为了填路径先去找文件。 -->
                                    <controls:AppPickButtons x:Name="CommandPicker" Margin="0,8,0,0"
                                                             PickFile="OnCommandPickPath"
                                                             PickWindow="OnCommandPickWindow" />

                                    <TextBlock Text="{loc:T '参数（可选）'}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                                    <TextBox x:Name="CommandArgsBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                             VerticalContentAlignment="Center" TextChanged="OnCommandFieldChanged"
                                             ToolTip="{loc:T '例如欧路词典填 -w &quot;{query}&quot;；留空表示只启动程序。'}" />

                                    <TextBlock Text="{loc:T '工作目录（可选）'}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                                    <TextBox x:Name="CommandWorkDirBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                             VerticalContentAlignment="Center" TextChanged="OnCommandFieldChanged"
                                             ToolTip="{loc:T '程序启动时的「当前目录」，相当于快捷方式里的「起始位置」。写 {current_folder} 就是当前选中的文件夹；留空则用系统默认。'}" />
                                    <TextBlock Text="{loc:T '工作目录 = 程序启动时所在的文件夹（快捷方式里的「起始位置」）。程序按相对路径找文件、或者要在某个仓库里跑脚本时才需要填；写 {current_folder} 表示当前选中的文件夹，留空用系统默认。'}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,5,0,0" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <CheckBox x:Name="CommandAdminBox" Content="{loc:T '以管理员身份运行'}"
                                                  Style="{StaticResource CheckBox.Text}" Click="OnCommandFlagChanged" />
                                        <CheckBox x:Name="CommandSilentBox" Content="{loc:T '静默运行（不闪窗口）'}" Margin="16,0,0,0"
                                                  Style="{StaticResource CheckBox.Text}" Click="OnCommandFlagChanged" />
                                    </StackPanel>

                                    <TextBlock x:Name="CommandHint" Style="{StaticResource Text.Tertiary}"
                                               TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 语义层其余开关 -->
                            <Border x:Name="CardSyntax" Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:T '语法与调试'}" Style="{StaticResource Text.H3}" />
                                    <TextBlock Text="{loc:T '输入框里的 doc: / ext: / size: / date: / -词 这些写法由翻译层换成索引查询；关掉就退回最朴素的关键词搜索。'}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,5,0,12" TextWrapping="Wrap" />

                                    <CheckBox x:Name="SemanticRulesBox" Content="{loc:T '按优先级规则重排（系统目录、临时文件往后放）'}"
                                              Style="{StaticResource CheckBox.Text}"
                                              Checked="OnSemanticOptionsChanged" Unchecked="OnSemanticOptionsChanged" />
                                    <CheckBox x:Name="SemanticBuiltinRulesBox" Content="{loc:T '使用内置规则包'}" Margin="0,8,0,0"
                                              Style="{StaticResource CheckBox.Text}"
                                              Checked="OnSemanticOptionsChanged" Unchecked="OnSemanticOptionsChanged" />
                                    <CheckBox x:Name="SemanticPinyinBox" Content="{loc:T '拼音与模糊匹配（yinhang → 银行、rprt → report）'}" Margin="0,8,0,0"
                                              Style="{StaticResource CheckBox.Text}"
                                              Checked="OnSemanticOptionsChanged" Unchecked="OnSemanticOptionsChanged" />
                                    <CheckBox x:Name="SemanticFacetsBox" Content="{loc:T '在底栏显示本页分面统计'}" Margin="0,8,0,0"
                                              Style="{StaticResource CheckBox.Text}"
                                              Checked="OnSemanticOptionsChanged" Unchecked="OnSemanticOptionsChanged" />
                                    <CheckBox x:Name="SemanticHistoryBox" Content="{loc:T '记录使用历史（只在本机，用来做空面板建议）'}" Margin="0,8,0,0"
                                              Style="{StaticResource CheckBox.Text}"
                                              Checked="OnSemanticOptionsChanged" Unchecked="OnSemanticOptionsChanged" />
                                    <CheckBox x:Name="SemanticDebugBox" Content="{loc:T '显示查询调试面板（在 Qbar 里也可以按 Ctrl+D 切换）'}" Margin="0,8,0,0"
                                              Style="{StaticResource CheckBox.Text}"
                                              Checked="OnSemanticOptionsChanged" Unchecked="OnSemanticOptionsChanged" />

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                                        <TextBlock Text="{loc:T '候选窗口'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SemanticWindowValue" Style="{StaticResource Text.Tertiary}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Slider x:Name="SemanticWindowSlider" Minimum="200" Maximum="20000" TickFrequency="200"
                                            IsSnapToTickEnabled="True" ValueChanged="OnSemanticOptionsChanged" />
                                    <TextBlock Text="{loc:T '从索引里取多少条候选到本地重排。窗口越大越不容易漏掉「看着不像、其实最该在前面」的结果，代价是每次查询多几毫秒。'}"
                                               Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                                        <TextBlock Text="{loc:T '输入防抖'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SemanticDebounceValue" Style="{StaticResource Text.Tertiary}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Slider x:Name="SemanticDebounceSlider" Minimum="0" Maximum="200" TickFrequency="5"
                                            IsSnapToTickEnabled="True" ValueChanged="OnSemanticOptionsChanged" />
                                    <TextBlock Text="{loc:T '输入法还在上屏（候选框没落定）时不查询，上屏后只查一次；这个值是打字的停顿阈值。'}"
                                               Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Content="{loc:T '刷新拼音索引'}" Style="{StaticResource Button.Ghost}"
                                                Padding="10,5" Click="OnRefreshPinyin"
                                                ToolTip="{loc:T '名字里的汉字改过之后用：重建那张只收汉字名字的拼音表（后台进行）。'}" />
                                        <Button Content="{loc:T '规则与命令清单'}" Style="{StaticResource Button.Ghost}"
                                                Padding="10,5" Margin="8,0,0,0" Click="OnShowSemanticInfo"
                                                ToolTip="{loc:T '列出当前生效的过滤器、命令关键字和优先级规则。'}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 搜索前建议：Qbar 唤出、还没打字时那组「最近文件」。
                                 放在「文件搜索」页而不是右栏：它和过滤器/优先级一样属于
                                 「搜什么、怎么排」，而且选项多到右栏塞不下。 -->
                            <Border x:Name="CardSuggestions" Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:T '搜索前建议'}" Style="{StaticResource Text.H3}" />
                                    <TextBlock Text="{loc:T 'Qbar 唤出后、还没输入时列出最近用过的文件 / 文件夹 / 应用；一打字就让位给搜索结果。来源在后台线程采集，首屏先读缓存。'}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,5,0,12" TextWrapping="Wrap" />

                                    <CheckBox x:Name="SgShowBox" Content="{loc:T '启用搜索前建议'}"
                                              Style="{StaticResource CheckBox.Text}" Click="OnSuggestionsChanged"
                                              ToolTip="{loc:T '关掉后空态与改造前完全一致：只有老的「最近打开」+ 提示命令。'}" />

                                    <TextBlock Text="{loc:T '来源（关掉的来源不采集；目录不存在时自动计 0，不报错）'}"
                                               Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="10,6">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="210" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="{loc:T '来源'}" Style="{StaticResource Text.Tertiary}" />
                                                <TextBlock Grid.Column="2" Text="{loc:T '权重'}" Style="{StaticResource Text.Tertiary}" />
                                                <TextBlock Grid.Column="3" Text="{loc:T '上次采集'}" Style="{StaticResource Text.Tertiary}" />
                                            </Grid>

                                            <!-- 来源行本身就是拖拽手柄：按住文字区域上下拖即可排序，
                                                 不放任何"≡"之类的小图标。复选框区域留给勾选，不参与拖拽。 -->
                                            <ItemsControl x:Name="SgSourceList"
                                                          Background="Transparent"
                                                          AllowDrop="True"
                                                          PreviewMouseLeftButtonDown="OnSuggestionSourceMouseDown"
                                                          PreviewMouseMove="OnSuggestionSourceMouseMove"
                                                          DragOver="OnSuggestionSourceDragOver"
                                                          Drop="OnSuggestionSourceDrop">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="30" Background="Transparent">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="210" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" Tag="{Binding Id}"
                                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                      Style="{StaticResource CheckBox.Text}"
                                                                      Click="OnSuggestionSourceToggle"
                                                                      VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                                       Style="{StaticResource Text.Secondary}"
                                                                       VerticalAlignment="Center" Margin="2,0,0,0"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Weight}"
                                                                       Style="{StaticResource Text.Tertiary}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Status}"
                                                                       Style="{StaticResource Text.Tertiary}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{loc:T '按住任意一行（复选框以外的区域）上下拖即可排序；Qbar 空态按这个顺序分组展示，不拖则按修改时间倒序。'}"
                                                       Style="{StaticResource Text.Tertiary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{loc:T '显示与采集'}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:T '空态显示条数'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Width="150" />
                                        <TextBlock x:Name="SgCountValue" Style="{StaticResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Slider x:Name="SgCountSlider" Minimum="0" Maximum="50" TickFrequency="1"
                                            IsSnapToTickEnabled="True" ValueChanged="OnSuggestionsChanged" />

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{loc:T '候选硬上限'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Width="150" />
                                        <TextBlock x:Name="SgMaxValue" Style="{StaticResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Slider x:Name="SgMaxSlider" Minimum="200" Maximum="5000" TickFrequency="100"
                                            IsSnapToTickEnabled="True" ValueChanged="OnSuggestionsChanged" />
                                    <TextBlock Text="{loc:T '采集阶段最多收多少条再去重排序；超出的直接丢，避免大目录把后台线程拖死。'}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{loc:T '采集时间预算'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Width="150" />
                                        <TextBlock x:Name="SgBudgetValue" Style="{StaticResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Slider x:Name="SgBudgetSlider" Minimum="200" Maximum="5000" TickFrequency="100"
                                            IsSnapToTickEnabled="True" ValueChanged="OnSuggestionsBudgetChanged" />
                                    <TextBlock Text="{loc:T '超过预算的来源提前收手；已经采到的照常展示，不阻塞启动器唤出。'}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                    <TextBlock Text="{loc:T '文件类型与排除'}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:T '只保留这些扩展名'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,5" />
                                            <TextBox x:Name="SgFilterBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                                     VerticalContentAlignment="Center"
                                                     ToolTip="{loc:T '分号或逗号分隔，留空 = 不过滤。例如 docx;pdf;xlsx'}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:T '排除这些扩展名'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,5" />
                                            <TextBox x:Name="SgExtBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                                     VerticalContentAlignment="Center"
                                                     ToolTip="{loc:T '默认 tmp;bak;log'}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{loc:T '应用过滤'}" Style="{StaticResource Button.Primary}" Click="OnSuggestionsApplyFilters" />
                                        <Button Content="{loc:T '立即重新采集'}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                                Click="OnSuggestionsRefresh" />
                                        <TextBlock Text="{loc:T '系统目录（Windows / Program Files / AppData 等）始终不采集；黑名单优先于一切规则。'}"
                                                   Style="{StaticResource Text.Tertiary}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Text="{loc:T '隐藏与还原'}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:T '隐藏热键'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBox x:Name="SgHotkeyBox" Width="150" Margin="10,0,0,0" Style="{StaticResource TextBox.Base}"
                                                 InputMethod.IsInputMethodEnabled="False" />
                                        <Button Content="{loc:T '应用'}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                                Click="OnSuggestionsApplyHotkey" />
                                        <TextBlock Text="{loc:T '选中建议后按热键或右键「不建议此文件」即可隐藏。'}"
                                                   Style="{StaticResource Text.Tertiary}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <TextBlock Text="{loc:T '已隐藏的建议'}" Style="{StaticResource Text.Tertiary}" Margin="0,12,0,4" />
                                    <ListBox x:Name="SgHiddenList" Height="96" Background="Transparent" BorderThickness="0" />
                                    <TextBlock x:Name="SgHiddenEmpty" Text="{loc:T '还没有隐藏任何建议。'}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="{loc:T '还原选中'}" Style="{StaticResource Button.Ghost}" Click="OnSuggestionsUnhide" />
                                        <Button Content="{loc:T '还原全部'}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                                Click="OnSuggestionsUnhideAll" />
                                    </StackPanel>

                                    <TextBlock x:Name="SgStatsText" Style="{StaticResource Text.Tertiary}" Margin="0,12,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>


<Border x:Name="FileDialogBarCard" Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:T '文件对话框浮层'}" Style="{StaticResource Text.H3}" />
                                    <TextBlock Text="{loc:T '别的程序弹出「打开 / 保存」对话框时，在对话框下沿浮出一条搜索栏；输入关键词、回车，文件就填回那个对话框。'}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,5,0,12" TextWrapping="Wrap" />

                                    <CheckBox x:Name="FdEnabledBox" Content="{loc:T '启用文件对话框浮层'}"
                                              Style="{StaticResource CheckBox.Text}" Click="OnFileDialogBarChanged"
                                              ToolTip="{loc:T '关掉后卸载窗口监听和热键，任何对话框都不会浮出搜索栏，也不留后台轮询。'}" />

                                    <TextBlock Text="{loc:T '什么时候显示'}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                                    <CheckBox x:Name="FdShowOnAppearBox" Content="{loc:T '对话框一出现就浮出'}"
                                              Style="{StaticResource CheckBox.Text}" Click="OnFileDialogBarChanged" />
                                    <CheckBox x:Name="FdShowOnHotkeyBox" Content="{loc:T '按热键才浮出（推荐，不打扰）'}"
                                              Style="{StaticResource CheckBox.Text}" Margin="0,6,0,0" Click="OnFileDialogBarChanged" />

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="{loc:T '显示热键'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBox x:Name="FdHotkeyBox" Width="150" Margin="10,0,0,0" Style="{StaticResource TextBox.Base}"
                                                 InputMethod.IsInputMethodEnabled="False" />
                                        <Button Content="{loc:T '应用'}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Click="OnFileDialogApplyHotkey" />
                                    </StackPanel>
                                    <TextBlock x:Name="FdHotkeyHint" Text="{loc:T '写法：Ctrl+Alt+F，修饰键可用 Ctrl / Shift / Alt / Win。'}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                    <TextBlock Text="{loc:T '接管哪几类窗口'}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                                    <CheckBox x:Name="FdTypeFileBox" Content="{loc:T '文件对话框（打开 / 保存）'}"
                                              Style="{StaticResource CheckBox.Text}" Click="OnFileDialogTypeChanged" />
                                    <CheckBox x:Name="FdTypeFolderBox" Content="{loc:T '文件夹选择对话框'}"
                                              Style="{StaticResource CheckBox.Text}" Margin="0,6,0,0" Click="OnFileDialogTypeChanged" />
                                    <CheckBox x:Name="FdTypeExplorerBox" Content="{loc:T '资源管理器窗口（只占位，本次不浮出）'}"
                                              Style="{StaticResource CheckBox.Text}" Margin="0,6,0,0" Click="OnFileDialogTypeChanged" />

                                    <TextBlock Text="{loc:T '不回填的进程'}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="FdProcessBox" Width="200" Style="{StaticResource TextBox.Base}"
                                                 ToolTip="{loc:T '进程可执行文件名，例如 game.exe；不区分大小写。'}" />
                                        <Button Content="{loc:T '添加'}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Click="OnFileDialogAddProcess" />
                                        <Button Content="{loc:T '删除选中'}" Style="{StaticResource Button.Ghost}" Margin="4,0,0,0" Click="OnFileDialogRemoveProcess" />
                                    </StackPanel>
                                    <!-- 这个列表以前是「透明底 + 无边框 + 写死 84 高」：一条排除项都没有的时候，
                                         它就是一整块空白，看着像"文本框下面空了一大片"。
                                         现在换成和别处一样的圆角底色，没有内容时只留一行空态提示。 -->
                                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8"
                                            Padding="6,3" Margin="0,8,0,0">
                                        <Grid>
                                            <ListBox x:Name="FdProcessList" MinHeight="26" MaxHeight="120"
                                                     Background="Transparent" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                            <TextBlock x:Name="FdProcessEmpty" Text="{loc:T '还没有排除任何程序'}"
                                                       Style="{StaticResource Text.Tertiary}" Margin="8,4,0,0"
                                                       VerticalAlignment="Top" IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{loc:T '列在这里的程序弹对话框时不会浮出搜索栏；别的程序不受影响。'}"
                                               Style="{StaticResource Text.Tertiary}" Margin="0,4,0,0" TextWrapping="Wrap" />

                                    <TextBlock Text="{loc:T '回填方式'}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                                    <CheckBox x:Name="FdUiaBox" Content="{loc:T '优先用 UI Automation 写入文件名框（失败自动退回键盘 + 剪贴板）'}"
                                              Style="{StaticResource CheckBox.Text}" Click="OnFileDialogBarChanged" />

                                    <!-- 一次呈现几条 = 快捷键 Ctrl+1..N 的 N。默认 6，可调 1..9。 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                                        <TextBlock Text="{loc:T '一次呈现几条（Ctrl+1..N）'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FdRowValue" Style="{StaticResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Slider x:Name="FdRowSlider" Minimum="1" Maximum="9" TickFrequency="1"
                                            IsSnapToTickEnabled="True" ValueChanged="OnFileDialogBarChanged" />

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                                        <TextBlock Text="{loc:T '最多显示条数'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FdMaxValue" Style="{StaticResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Slider x:Name="FdMaxSlider" Minimum="20" Maximum="500" TickFrequency="10"
                                            IsSnapToTickEnabled="True" ValueChanged="OnFileDialogBarChanged" />

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                                        <TextBlock Text="{loc:T '浮层高度'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FdHeightValue" Style="{StaticResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Slider x:Name="FdHeightSlider" Minimum="40" Maximum="48" TickFrequency="1"
                                            IsSnapToTickEnabled="True" ValueChanged="OnFileDialogBarChanged" />

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                                        <TextBlock Text="{loc:T '兜底轮询间隔'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FdPollValue" Style="{StaticResource Text.Tertiary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Slider x:Name="FdPollSlider" Minimum="0" Maximum="2000" TickFrequency="100"
                                            IsSnapToTickEnabled="True" ValueChanged="OnFileDialogBarChanged" />
                                    <TextBlock Text="{loc:T '窗口事件偶发丢失时用低频顶层枚举补发现；设成 0 就只靠窗口事件，完全不轮询。'}"
                                               Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                <CheckBox x:Name="FdFollowMetricsBox" Content="{loc:T '记录跟随度量（排查拖动滞后时打开）'}"
                                          Style="{StaticResource CheckBox.Text}" Margin="0,14,0,0"
                                          Click="OnFileDialogBarChanged"
                                          ToolTip="{loc:T '每秒往日志写一行：事件→摆位的 p50/p99 耗时、与对话框底边的像素误差、几何重算次数。默认关，关着不产生日志。'}" />
                                <TextBlock Text="{loc:T '拖动时浮条只挪位置、不改尺寸；几何（宽度/列表高/翻转）只在尺寸变化或停手 200ms 后重算一次。'}"
                                           Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,4,0,0" />

                                </StackPanel>
                            </Border>                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- 右：编辑 + 外观。
             纵向滚动条自己占 10px（见 Theme 里的 ScrollBar 宽度），右栏的卡片因此比
             顶部那张说明卡窄 10px —— 看着就是"上面那张比下面宽一截"。
             处理：说明卡也留出这 10px（Margin 右边距），两边右边缘就落在同一条竖线上；
             这一栏内容永远比视口高，滚动条是常驻的，所以这个补偿不会时有时无。 -->
        <ScrollViewer x:Name="RightScroll" Grid.Row="1" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{loc:T '编辑条目'}" Style="{StaticResource Text.H3}" />
                        <TextBlock x:Name="EditTitle" Text="{loc:T '（选择左边的条目，或点新增）'}" Style="{StaticResource Text.Tertiary}"
                                   Margin="0,5,0,12" TextWrapping="Wrap" />

                        <TextBlock Text="{loc:T '关键字'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                        <TextBox x:Name="KeyBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                                 VerticalContentAlignment="Center" TextChanged="OnFieldChanged" />

                        <TextBlock x:Name="ValueLabel" Text="{loc:T '内容'}" Style="{StaticResource Text.Secondary}"
                                   Margin="0,12,0,6" />
                        <TextBox x:Name="ValueBox" Style="{StaticResource TextBox.Base}" MinHeight="70"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnFieldChanged" />

                        <StackPanel x:Name="ArgumentsRow">
                            <TextBlock Text="{loc:T '参数（可选）'}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                            <TextBox x:Name="ArgumentsBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                                     VerticalContentAlignment="Center" TextChanged="OnFieldChanged"
                                     ToolTip="{loc:T '传给程序的命令行参数。用 {q} 代表用户输入，例如欧路词典填 -w {q}。'}" />
                            <CheckBox x:Name="AdminBox" Content="{loc:T '以管理员身份运行'}"
                                      Style="{StaticResource CheckBox.Text}" Margin="0,8,0,0"
                                      Click="OnFlagsChanged" />
                        </StackPanel>

                        <TextBlock Text="{loc:T '备注（可选）'}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                        <TextBox x:Name="CommentBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                                 VerticalContentAlignment="Center" TextChanged="OnFieldChanged" />

                        <TextBlock Text="{loc:T '图标（可选）'}" Style="{StaticResource Text.Secondary}" Margin="0,12,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="IconBox" Style="{StaticResource TextBox.Base}" MinHeight="36"
                                     VerticalContentAlignment="Center" TextChanged="OnFieldChanged"
                                     ToolTip="{loc:T '图片（png/ico）或 exe 路径；留空则自动使用程序图标'}" />
                            <Border Grid.Column="1" Width="34" Height="36" CornerRadius="8" Margin="8,0,0,0"
                                    Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <Grid>
                                    <Image x:Name="IconPreview" Stretch="Uniform" Margin="5" />
                                    <TextBlock x:Name="IconFallback" Text="?" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextTertiary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Button Grid.Column="2" Content="{loc:T '选择…'}" Style="{StaticResource Button.Base}"
                                    Padding="10,5" Margin="8,0,0,0" Click="OnPickIcon" />
                        </Grid>

                        <TextBlock x:Name="ValueHelp" Style="{StaticResource Text.Tertiary}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="{loc:T '外观'}" Style="{StaticResource Text.H3}" Margin="0,0,0,12" />

                        <TextBlock Text="{loc:T '主色调'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl x:Name="ColorSwatches">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="{loc:T '列表显示行数'}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                        <Slider x:Name="ListCountSlider" Minimum="3" Maximum="12" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OnAppearanceChanged" />

                        <!-- 空面板最上面的「最近打开」：只影响直接唤出 Qbar 时的样子 -->
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                            <TextBlock Text="{loc:T '空面板先显示最近打开的项目'}" Style="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="RecentCountValue" Style="{StaticResource Text.Tertiary}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Slider x:Name="RecentCountSlider" Minimum="0" Maximum="20" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OnAppearanceChanged" />
                        <TextBlock Text="{loc:T '0 = 不显示；只在直接唤出 Qbar 时出现，带搜索引擎/带关键字唤出时不显示'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="{loc:T '输入框字号'}" Style="{StaticResource Text.Secondary}" Margin="0,10,0,6" />
                        <Slider x:Name="FontSizeSlider" Minimum="14" Maximum="30" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OnAppearanceChanged" />

                        <!-- 实时预览：所见即所得，字号调大时能立刻看出会不会被裁 -->
                        <Border Background="{DynamicResource Brush.SurfaceAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="9" Padding="10,0" Margin="0,8,0,0">
                            <TextBlock x:Name="FontPreview" Text="{loc:T '预览 Preview 文字测试 qgp'}"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       VerticalAlignment="Center" Padding="0,5" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <CheckBox x:Name="ShowIconsBox" Content="{loc:T '显示图标'}" Style="{StaticResource CheckBox.Text}"
                                      VerticalAlignment="Center" Click="OnAppearanceChanged" />
                        </StackPanel>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{loc:T '输入法'}" Style="{StaticResource Text.Tertiary}" Margin="0,0,0,7" />
                            <CheckBox x:Name="ImeOnOpenBox" Content="{loc:T '面板打开时切到英文输入'}"
                                      Style="{StaticResource CheckBox.Text}" Click="OnAppearanceChanged"
                                      ToolTip="{loc:T '引擎关键字只能用英文字母打；勾上之后打开面板就替你按一下 Shift。'}" />
                            <CheckBox x:Name="ImeBackBox" Content="{loc:T '认出引擎后切回中文'}"
                                      Style="{StaticResource CheckBox.Text}" Margin="0,6,0,0" Click="OnAppearanceChanged"
                                      ToolTip="{loc:T '按空格把关键字变成标签之后，替你按一下 Shift 切回中文，直接打搜索内容。'}" />
                        </StackPanel>
                        <Button Content="{loc:T '恢复默认外观'}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                Margin="-10,10,0,0" Click="OnResetAppearance" />

                        <!-- 面板位置：直接拖面板空白处就能挪，松手即记住；
                              这里只显示当前是不是自定义过，并提供一键回默认。 -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="{loc:T '面板位置'}" Style="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="PositionValue" Style="{StaticResource Text.Tertiary}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{loc:T '拖动面板空白处（不要按在输入框、结果行、按钮上）就能挪位置，松手即记住，下次唤出还在那儿。'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Button Content="{loc:T '恢复默认位置'}" Style="{StaticResource Button.Ghost}"
                                HorizontalAlignment="Left" Margin="-10,8,0,0" Click="OnResetPosition" />
                    </StackPanel>
                </Border>

                <!-- 搜索联想：Qbar 里「已选定搜索引擎 + 有关键词」时，在输入框下方列出候选词。
                     这张卡只管联想请求本身；关掉它不影响任何搜索路径，回车照旧搜原文。
                     联想只走一次 HTTP，失败/超时就静默不显示，所以这里不需要“重试”按钮。
                     **只在「搜索指令」那一页出现**：联想是"选中搜索引擎之后打关键词"才有的事，
                     启动程序 / 常用网址 / 固定项 三页里它一个控件都用不上，摆在那儿只会碍事。 -->
                <Border x:Name="SuggestCard" Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T '搜索联想'}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{loc:T '选定搜索引擎后，边打字边列出候选词；↑↓ 选择，Enter 用当前引擎搜索。'}"
                                   Style="{StaticResource Text.Tertiary}" Margin="0,5,0,12" TextWrapping="Wrap" />

                        <CheckBox x:Name="SuggestEnabledBox" Content="{loc:T '启用搜索联想'}"
                                  Style="{StaticResource CheckBox.Text}" Click="OnSuggestOptionsChanged"
                                  ToolTip="{loc:T '关掉后 Qbar 不再发联想请求；搜索、结果列表和快捷键都不受影响。'}" />

                        <TextBlock Text="{loc:T '联想词来源'}" Style="{StaticResource Text.Secondary}" Margin="0,14,0,6" />
                        <ComboBox x:Name="SuggestEngineBox" Style="{StaticResource ComboBox.Base}"
                                  SelectionChanged="OnSuggestEngineChanged">
                            <ComboBoxItem Content="{loc:T '跟随当前搜索引擎'}" Tag="auto" />
                            <ComboBoxItem Content="{loc:T '百度'}" Tag="baidu" />
                            <ComboBoxItem Content="{loc:T '谷歌'}" Tag="google" />
                            <ComboBoxItem Content="{loc:T '必应'}" Tag="bing" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                            <TextBlock Text="{loc:T '显示条数'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SuggestMaxValue" Style="{StaticResource Text.Tertiary}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Slider x:Name="SuggestMaxSlider" Minimum="1" Maximum="10" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="OnSuggestOptionsChanged" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                            <TextBlock Text="{loc:T '请求超时'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SuggestTimeoutValue" Style="{StaticResource Text.Tertiary}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Slider x:Name="SuggestTimeoutSlider" Minimum="200" Maximum="5000" TickFrequency="100"
                                IsSnapToTickEnabled="True" ValueChanged="OnSuggestOptionsChanged" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                            <TextBlock Text="{loc:T '缓存时间'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SuggestCacheValue" Style="{StaticResource Text.Tertiary}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Slider x:Name="SuggestCacheSlider" Minimum="0" Maximum="1440" TickFrequency="5"
                                IsSnapToTickEnabled="True" ValueChanged="OnSuggestOptionsChanged" />
                        <TextBlock Text="{loc:T '缓存只放在内存里，关掉 Qbar 就清空；设成 0 表示每次都重新请求。'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="{loc:T '跟随当前搜索引擎：用 bd 就取百度联想，用 gg 就取谷歌联想；认不出的引擎按必应处理。'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>


            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
