<UserControl x:Class="InputPlus.UI.Views.GestureOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
             FontFamily="{DynamicResource Font.Ui}">
    <!-- 手势设置：从手势页那张「总开关条」里整块搬出来的。
         页面上现在只留「启用手势」开关、录制新手势和右边的齿轮；
         外观 / 参数 / 开关快捷键都收在这个设置窗里 —— 和 WGestures 2 一个思路：
         天天用的（画手势、开开关）留在首页，偶尔调的收进设置。 -->
    <ScrollViewer x:Name="OptionsScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0">
            <!-- 手势开关快捷键：出厂是空的 —— 不占用任何组合键，用户自己按「录制」定。
                 以前这行和「启用手势」挤在页面的开关条上，开关留在页面、快捷键跟着设置走。
                 版式跟设置页一致：一张卡、卡头标题 + 说明，下面一行控件。 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T '开关快捷键'}" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:T '按一下就能开 / 关全部手势，不用回到这一页。出厂是空的，也就是没占用任何组合键；点「录制」自己定一个。'}"
                               Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T '当前快捷键'}" Style="{StaticResource Text.Body}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="ToggleHotkeyBox" Style="{StaticResource TextBox.Base}" Width="112"
                                     MinHeight="30" Padding="8,2" IsReadOnly="True" VerticalContentAlignment="Center"
                                     ToolTip="{loc:T '鼠标手势总开关的快捷键（点右侧按钮录制）'}" />
                            <Button Content="{loc:T '录制'}" Style="{StaticResource Button.Ghost}"
                                    Margin="4,0,0,0" Padding="8,3" Click="OnCaptureToggleHotkey" />
                            <Button Content="{loc:T '清除'}" Style="{StaticResource Button.Ghost}"
                                    Margin="2,0,0,0" Padding="8,3" Click="OnClearToggleHotkey"
                                    ToolTip="{loc:T '回到出厂状态：不占用任何组合键'}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ① 外观：WGestures 2 的偏好（run\Resources\prefs.json）。
                 轨迹、名称、超时三块的字段名和出厂值都跟它一致；
                 同一个设置只在这里出现一次，开关条上不再重复。
                 版式跟设置页一致：一张卡、卡头标题 + 说明，行间一条分隔线。 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T '手势外观'}" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:T '画出来的轨迹长什么样、名字写在哪、迟迟不画算不算数 —— 字段名和出厂值都跟 WGestures 2 的 prefs.json 一致。'}"
                               Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '显示轨迹'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '画手势时在屏幕上跟着描出这一笔。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="PathBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Tag="ShowPath" Click="OnWg2ToggleChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '轨迹描边'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '轨迹两侧描一圈白边，深色背景上也看得清。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="PathBorderBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Tag="ShowPathBorder" Click="OnWg2ToggleChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '轨迹粗细'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '1 最细、4 最粗；WGestures 出厂值是 1.5。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="PathWidthSlider" Width="130" Minimum="1" Maximum="4"
                                    SmallChange="0.5" LargeChange="0.5" TickFrequency="0.5"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="OnWg2SliderChanged" />
                            <TextBlock x:Name="PathWidthText" Style="{StaticResource Text.Secondary}" Width="34"
                                       Margin="8,0,0,0" VerticalAlignment="Center" Text="1.5" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '轨迹透明度'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '20% 淡淡一层，100% 完全不透明。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="TrailOpacitySlider" Width="130" Minimum="0.2" Maximum="1"
                                    SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="OnTrailOpacityChanged" />
                            <TextBlock x:Name="TrailOpacityText" Style="{StaticResource Text.Secondary}" Width="44"
                                       Margin="8,0,0,0" VerticalAlignment="Center" Text="100%" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '轨迹颜色'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '还没认出来时一种色，认出来之后换成另一种。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Ghost}" Padding="8,3"
                                    Tag="pathNormal" Click="OnPickWg2Color"
                                    ToolTip="{loc:T '还没认出、以及认不出来的轨迹颜色。'}">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="PathNormalSwatch" Width="16" Height="16" CornerRadius="{DynamicResource Radius.All}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                    <TextBlock Text="{loc:T '未识别'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}" Padding="8,3" Margin="6,0,0,0"
                                    Tag="pathRecognized" Click="OnPickWg2Color"
                                    ToolTip="{loc:T '认出手势之后，轨迹换成这个颜色。'}">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="PathRecognizedSwatch" Width="16" Height="16" CornerRadius="{DynamicResource Radius.All}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                    <TextBlock Text="{loc:T '已识别'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 分键颜色：WGestures 2 全程一种颜色，这一层是我们多出来的，
                         留给「右键一个色、中键一个色」。不配就用上面的未识别色。 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '分键颜色'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '每个鼠标键各配一色；不配就跟随上面的「未识别」。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            <Button Content="{loc:T '全部回落到未识别色'}" Style="{StaticResource Button.Ghost}"
                                    HorizontalAlignment="Left" Padding="0" Margin="0,3,0,0"
                                    Foreground="{DynamicResource Brush.Accent}" Click="OnResetTrailColors"
                                    ToolTip="{loc:T '清掉所有分键颜色，五个键都回落到上面的「未识别」色。'}" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="520">
                            <Button Style="{StaticResource Button.Ghost}" Padding="8,3" Tag="right" Click="OnPickTrailColor"
                                    ToolTip="{loc:T '单独配色；不配就用上面的「未识别」色。'}">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="RightSwatch" Width="16" Height="16" CornerRadius="{DynamicResource Radius.All}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                    <TextBlock Text="{loc:T '右键'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}" Padding="8,3" Margin="6,0,0,0" Tag="middle"
                                    Click="OnPickTrailColor"
                                    ToolTip="{loc:T '单独配色；不配就用上面的「未识别」色。'}">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="MiddleSwatch" Width="16" Height="16" CornerRadius="{DynamicResource Radius.All}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                    <TextBlock Text="{loc:T '中键'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}" Padding="8,3" Margin="6,0,0,0" Tag="x1"
                                    Click="OnPickTrailColor"
                                    ToolTip="{loc:T '单独配色；不配就用上面的「未识别」色。'}">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="X1Swatch" Width="16" Height="16" CornerRadius="{DynamicResource Radius.All}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                    <TextBlock Text="{loc:T '侧键 1'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}" Padding="8,3" Margin="6,0,0,0" Tag="x2"
                                    Click="OnPickTrailColor"
                                    ToolTip="{loc:T '单独配色；不配就用上面的「未识别」色。'}">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="X2Swatch" Width="16" Height="16" CornerRadius="{DynamicResource Radius.All}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                    <TextBlock Text="{loc:T '侧键 2'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}" Padding="8,3" Margin="6,0,0,0" Tag="left"
                                    Click="OnPickTrailColor"
                                    ToolTip="{loc:T '单独配色；不配就用上面的「未识别」色。'}">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="LeftSwatch" Width="16" Height="16" CornerRadius="{DynamicResource Radius.All}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                    <TextBlock Text="{loc:T '左键'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 笔画平滑（v1.6.3）：只修饰画出来的线条，认手势用的点列照旧 ——
                         所以开关放在「外观」这一组，而不是识别参数那一组。 -->

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '显示手势名称'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '画完（或认出来）在光标旁写出手势的名字。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="GestureNameBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Tag="ShowGestureName" Click="OnWg2ToggleChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '执行后淡出'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '勾上：执行完立刻消失；不勾：停一下再慢慢淡出。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="FadeOutBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Tag="FadeOutExecuted" Click="OnWg2ToggleChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 名称框（v1.6.3 从「通知样式」搬回来）：v1.6.0 曾把它和右下角提示条
                         合并成一套外观，用下来两边的需求并不一样 —— 名称框要跟着手势调出现高度、
                         要分「认出来 / 已执行」两档底色。这里只调手势名称，改完立刻生效。 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '名称描边'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '名称色块外面那圈白边，深色背景上也看得清。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="LabelBorderBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="OnLabelBorderToggleChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '名称描边粗细'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '0.5 是一条细线，3.0 是一圈明显的白框；WGestures 出厂值是 1.0。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="LabelBorderWidthSlider" Width="130" Minimum="0.5" Maximum="3"
                                    SmallChange="0.1" LargeChange="0.5" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="OnLabelBorderWidthChanged" />
                            <TextBlock x:Name="LabelBorderWidthText" Style="{StaticResource Text.Secondary}" Width="34"
                                       Margin="8,0,0,0" VerticalAlignment="Center" Text="1.0" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '名称颜色'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '平时一种、动作执行完换一种，用来区分「认出来」和「已经跑了」。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="380">
                            <Button Style="{StaticResource Button.Ghost}" Padding="8,3" Tag="normal"
                                    Click="OnPickLabelColor" ToolTip="{loc:T '名字刚认出来时的底色（保留透明度）。'}">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="LabelNormalSwatch" Width="16" Height="16" CornerRadius="{DynamicResource Radius.All}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                    <TextBlock Text="{loc:T '平时'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}" Padding="8,3" Margin="6,0,0,0" Tag="executed"
                                    Click="OnPickLabelColor" ToolTip="{loc:T '动作执行完之后的底色（保留透明度）。'}">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="LabelExecutedSwatch" Width="16" Height="16" CornerRadius="{DynamicResource Radius.All}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                    <TextBlock Text="{loc:T '执行后'}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '名称位置'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '名字停在屏幕的哪个高度：0 贴底、100% 贴顶，水平始终居中。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="LabelPosSlider" Width="130" Minimum="0" Maximum="1"
                                    SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="OnLabelPositionChanged" />
                            <TextBlock x:Name="LabelPosText" Style="{StaticResource Text.Secondary}" Width="44"
                                       Margin="8,0,0,0" VerticalAlignment="Center" Text="25%" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <!-- 预览直接用 GestureOverlayWindow.ApplyLabelLook 画：跟真正弹出来的框
                         共用同一份配色算式，预览才不会和实际效果对不上。 -->
                    <StackPanel Margin="0,10,0,4">
                        <TextBlock Text="{loc:T '预览'}" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{loc:T '左边是刚认出来的样子，右边是动作执行完之后的样子 —— 改上面任何一项，这里立刻跟着变。'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.All}" Padding="16,14"
                                Margin="0,10,0,0" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border x:Name="LabelPreviewNormal" Padding="24,14,24,16" MinWidth="120" MinHeight="52">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.45" />
                                    </Border.Effect>
                                    <TextBlock Text="{loc:T '手势名称'}" Foreground="White" FontSize="24"
                                               FontFamily="{DynamicResource Font.Ui}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.55" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Border>
                                <Border x:Name="LabelPreviewExecuted" Padding="24,14,24,16" MinWidth="120" MinHeight="52"
                                        Margin="16,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.45" />
                                    </Border.Effect>
                                    <TextBlock Text="{loc:T '已执行'}" Foreground="White" FontSize="24"
                                               FontFamily="{DynamicResource Font.Ui}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.55" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '起始超时提示'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '按下鼠标后迟迟不画，就在指针处闪个红点，表示这一笔作废了。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="TimeoutIndicatorBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Tag="ShowStartTimeoutIndicator" Click="OnWg2ToggleChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '起始超时时长'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '按下鼠标后多久还没开始画，就判定这一笔不算手势。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="StartTimeoutBox" Style="{StaticResource TextBox.Base}" Width="70"
                                     MinHeight="30" Padding="8,2" VerticalContentAlignment="Center"
                                     TextChanged="OnOptionsTextChanged" />
                            <TextBlock Text="{loc:T '毫秒'}" Style="{StaticResource Text.Tertiary}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ② 识别与起手：WGestures 2 的界面上没有这些旋钮（它只写死在引擎里），
                 所以单独一张卡；行版式和上面外观卡完全一致。 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:T '手势参数'}" Style="{StaticResource Text.H2}" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:T '一笔多短才算数、形状多像才认、动作发给谁 —— WGestures 2 把这些写死在引擎里，这里放开给你调。'}"
                               Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" />

                    <!-- 作用目标：一笔画完，动作到底发给谁。
                         两种模式的差别是「会不会把窗口切到前面」，属于行为而不是外观。 -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '作用目标'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '这一笔画完之后，动作发给哪个程序。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <RadioButton x:Name="TargetPointerRadio" GroupName="GestureTargetMode"
                                         Content="{loc:T '指针下方的应用'}"
                                         ToolTip="{loc:T '手势画在哪个程序上，动作就发给哪个程序；执行前会把它切到前面。'}"
                                         Checked="OnTargetModeChanged" />
                            <RadioButton x:Name="TargetActiveRadio" GroupName="GestureTargetMode" Margin="0,6,0,0"
                                         Content="{loc:T '活动的应用窗口'}"
                                         ToolTip="{loc:T '动作只发给当前的活动窗口，不切换窗口；画手势不会把别的程序顶到前面。'}"
                                         Checked="OnTargetModeChanged" />
                        </StackPanel>
                        <TextBlock x:Name="TargetModeHint" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '最小识别距离'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '画得比它短就当没画，这次点击照常传给程序。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="MinMoveBox" Style="{StaticResource TextBox.Base}" Width="70"
                                     MinHeight="30" Padding="8,2" VerticalContentAlignment="Center"
                                     TextChanged="OnOptionsTextChanged" />
                            <TextBlock Text="{loc:T '像素'}" Style="{StaticResource Text.Tertiary}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '匹配容差'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '笔画形状距离的上限，越小越严。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="ThresholdBox" Style="{StaticResource TextBox.Base}" Width="70"
                                     MinHeight="30" Padding="8,2" VerticalContentAlignment="Center"
                                     TextChanged="OnOptionsTextChanged" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '起手距离'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '先走完这段才真的开始画，手抖不会触发。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="ActivationBox" Style="{StaticResource TextBox.Base}" Width="70"
                                     MinHeight="30" Padding="8,2" VerticalContentAlignment="Center"
                                     TextChanged="OnOptionsTextChanged" />
                            <TextBlock Text="{loc:T '像素'}" Style="{StaticResource Text.Tertiary}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '换向系数'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '0~1，越大越容易在拐角处断开成两笔。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TurnBox" Style="{StaticResource TextBox.Base}" Width="70"
                                     MinHeight="30" Padding="8,2" VerticalContentAlignment="Center"
                                     TextChanged="OnOptionsTextChanged" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '全屏程序里不接管'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '只认真正的全屏：无边框、铺满整块屏幕的那种（游戏、播放器、浏览器 F11）。最大化窗口照常能用。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="FullscreenBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Tag="DisableInFullscreen" Click="OnWg2ToggleChanged" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,8,16,8">
                            <TextBlock Text="{loc:T '设置窗口置顶'}" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="{loc:T '打开时压在别的窗口上面，对着别的程序调手势不用来回切。'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="TopmostBox" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Tag="PrefWindowTopmost" Click="OnWg2ToggleChanged" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
