<Window x:Class="InputPlus.UI.Windows.TriggerKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
        Title="{loc:T '设置触发键'}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}">

    <StackPanel Margin="24">
        <TextBlock Text="{loc:T '按一个键'}" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="{loc:T '按下哪个键，就用哪个键当触发键 —— 键盘上任意一个键都行，包括 Enter 回车、空格、Shift、Ctrl、Alt、F1~F24、鼠标侧键。'}"
                   TextWrapping="Wrap" FontSize="12" Margin="0,8,0,14"
                   Foreground="{DynamicResource Brush.TextSecondary}" />

        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{DynamicResource Radius.Control}" Padding="16,14"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="CurrentText" FontSize="12"
                           Foreground="{DynamicResource Brush.TextTertiary}" TextWrapping="Wrap" />
                <TextBlock x:Name="KeyText" Text="{loc:T '请按键…'}" FontSize="22" FontWeight="SemiBold"
                           Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:T '取消'}" Style="{StaticResource Button.Ghost}" Padding="14,7"
                    Click="OnCancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
