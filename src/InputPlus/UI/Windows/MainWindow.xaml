<Window x:Class="InputPlus.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
        xmlns:views="clr-namespace:InputPlus.UI.Views"
        Title="{loc:T 'Input Plus'}" Height="800" Width="1240"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowGradient}"
        FontFamily="{StaticResource Font.Ui}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 窗口底色 = 侧栏色。Win11 会按圆角把窗口四角裁掉，右侧卡片周围还留 8px 缝，
         这两处都靠这一层底色衔接：整体只有"侧栏色 + 卡片"两种面，不会多出第三种白/黑。 -->
    <Grid Background="{DynamicResource Brush.Sidebar}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 侧栏 ============ -->
        <!-- 不再画右边那条 1px 竖线：侧栏与右侧内容之间改成"卡片浮在底色上"，
             由 ContentCard 的圆角和 8px 缝过渡，直来直去的分割线就没了。 -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,20,12,18">
                    <!-- 这里的图标必须和 exe / 任务栏上的应用图标**完全一致**。
                         以前用 Segoe 图标字体的键盘 glyph 配渐变底，
                         跟应用程序图标 (Assets/app.ico) 根本不是一个东西。 -->
                    <Image Width="40" Height="40" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="pack://application:,,,/Assets/app.png" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T 'Input Plus'}" Style="{StaticResource Text.H3}" />
                        <TextBlock Text="{loc:T '键盘 · 鼠标 · 自动化'}" Style="{StaticResource Text.Tertiary}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <!-- 导航 -->
                <ListBox Grid.Row="1" x:Name="NavList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="OnNavSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="guide">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '快速上手'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="keys">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '按键映射'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="hotstrings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '别名替换'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="qbar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE773;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T 'Qbar 面板'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '剪贴板'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="macros">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '宏'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="layers">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '触发键与层'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="gestures">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE962;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '鼠标手势'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="scroll">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '平滑滚动'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="holddrag">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '按住拖拽'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="backup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '同步与备份'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '设置'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="test">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '测试'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="help">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE897;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '快捷键速查'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="about">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <TextBlock Text="{loc:T '关于'}" Margin="11,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Body}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- 状态卡 -->
                <Border Grid.Row="2" Margin="12,8,12,14" CornerRadius="12" Padding="13,11"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Brush.Success}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="{loc:T '正在运行'}" Margin="7,0,0,0"
                                       Style="{StaticResource Text.Secondary}" FontSize="12.5" />
                        </StackPanel>
                        <TextBlock x:Name="HookText" Text="{loc:T '键盘钩子正常'}" Margin="0,4,0,0"
                                   Style="{StaticResource Text.Tertiary}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 右侧内容 ============ -->
        <!-- 标题栏和页面同处一张圆角卡片里。以前标题栏是透明的、直接透出窗口渐变，
             而左侧栏是纯色 #FBFCFE —— 一条 1px 竖线两边两套底，看着像两块 UI 拼起来的
             （用户原话「顶部那一栏颜色和整体 UI 不一致，很割裂」）。
             现在右侧整块（含标题栏）共用 WindowGradient，圆角与描边统一收在 ContentCard 上。 -->
        <Border Grid.Column="1" x:Name="ContentCard" Margin="8" CornerRadius="16"
                Background="{DynamicResource Brush.WindowGradient}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏（透明 = 透出卡片自己的渐变，与下方页面同一张底） -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="{loc:T '快速上手'}" Style="{StaticResource Text.H2}" />
                    <Border Style="{StaticResource Badge}" Margin="12,0,0,0">
                        <TextBlock x:Name="PageBadge" Text="{loc:T 'CapsLock 增强'}" Style="{StaticResource Badge.Text}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- 标题栏只放图标：原先「搜索」「暂停」是两颗带字的灰按钮，和右边几颗图标按钮挤在一行，
                         标题栏被撑得高低不齐，还占掉页面标题的位置。文字信息搬到 ToolTip 与
                         AutomationProperties.Name（读屏照样念得出来）。 -->
                    <Button x:Name="SearchButton" Style="{StaticResource Button.Icon}" Click="OnSearchClick"
                            Content="&#xE721;" Margin="0,0,2,0"
                            AutomationProperties.Name="{loc:T '搜索'}"
                            ToolTip="{loc:T '全局搜索（Ctrl+K）：页面、功能、动作、手势、别名、按键绑定'}" />

                    <Button x:Name="PauseButton" Style="{StaticResource Button.Icon}" Click="OnPauseClick"
                            Content="&#xE769;" Margin="2,0,0,0"
                            AutomationProperties.Name="{loc:T '暂停'}"
                            ToolTip="{loc:T '暂停 Input Plus 的全部功能：热键、鼠标手势、平滑滚动、按住拖拽'}" />
                    <Button Style="{StaticResource Button.Icon}" Click="OnThemeClick" Content="&#xE793;"
                            AutomationProperties.Name="{loc:T '切换深浅色'}"
                            ToolTip="{loc:T '切换深浅色'}" Margin="2,0,0,0" />
                    <Button Style="{StaticResource Button.Icon}" Click="OnMinimizeClick" Content="&#xE921;"
                            AutomationProperties.Name="{loc:T '最小化'}"
                            ToolTip="{loc:T '最小化'}" Margin="2,0,0,0" />
                    <!-- 最大化/还原：原先标题栏只有最小化和关闭，窗口最大化之后就再也还原不回来
                         （只能去双击标题栏）。字形随窗口状态在 OnStateChanged 里换（E922 / E923）。 -->
                    <Button x:Name="MaxButton" Style="{StaticResource Button.Icon}" Click="OnMaximizeClick"
                            Content="&#xE922;" AutomationProperties.Name="{loc:T '最大化'}"
                            ToolTip="{loc:T '最大化'}" Margin="2,0,0,0" />
                    <Button Style="{StaticResource Button.Icon}" Click="OnCloseClick" Content="&#xE8BB;"
                            AutomationProperties.Name="{loc:T '关闭到托盘'}"
                            ToolTip="{loc:T '关闭到托盘'}" Margin="2,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- 页面容器：按需创建，避免启动时把 8 个页面全部构建出来 -->
            <Grid Grid.Row="1">
                <ContentControl x:Name="PageHost" />
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
