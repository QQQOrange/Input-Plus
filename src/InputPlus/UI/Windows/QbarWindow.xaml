<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="InputPlus.UI.Windows.QbarWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization" xmlns:w="clr-namespace:InputPlus.UI.Windows" Title="Qbar" Width="760" SizeToContent="Height" WindowStyle="None" AllowsTransparency="False" Background="#00FFFFFF" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual" ShowActivated="True" FontFamily="{DynamicResource Font.Ui}" UseLayoutRounding="True">
  <Grid Margin="0">
    <Border Name="Panel" CornerRadius="8" BorderThickness="1.5" Background="#00FFFFFF" BorderBrush="{DynamicResource Brush.OverlayBorder}">
      <UIElement.RenderTransform>
        <TranslateTransform x:Name="Slide" Y="10" />
      </UIElement.RenderTransform>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Name="TintFill" Grid.Row="0" Grid.RowSpan="5" CornerRadius="8" IsHitTestVisible="False" Background="{DynamicResource Brush.OverlayCard}" />
        <Grid Row="0" Margin="18,16,18,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Name="ModeIconBox" Grid.Column="0" Width="30" Height="30" CornerRadius="{DynamicResource Radius.All}" VerticalAlignment="Center" Visibility="Collapsed" Background="{DynamicResource Brush.OverlayRowHover}">
            <TextBlock Name="ModeIcon" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.OverlayText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
            <Border Name="ChipBox" Visibility="Collapsed" CornerRadius="{DynamicResource Radius.Chip}" Height="32" Padding="8,0" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource Brush.OverlayAccentSoft}" BorderThickness="1" BorderBrush="{DynamicResource Brush.OverlayBorderAccent}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Name="ChipIconBox" Width="18" Height="18" CornerRadius="{DynamicResource Radius.All}" Visibility="Collapsed" ClipToBounds="True">
                  <Image Name="ChipIcon" Stretch="UniformToFill" />
                </Border>
                <Border Name="ChipInitialBox" Width="18" Height="18" CornerRadius="{DynamicResource Radius.All}" Visibility="Collapsed">
                  <TextBlock Name="ChipInitial" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Name="ChipLabel" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.OverlayText}" Text="{loc:T 百度}" />
                <Button Name="ChipClose" Content="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource Brush.OverlayTextSecondary}" Background="#00FFFFFF" BorderThickness="0" Margin="7,0,-2,0" Padding="2" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{loc:T 移除标签（Backspace）}" Click="OnChipClose" />
              </StackPanel>
            </Border>
            <Border Name="FilterChipBox" Visibility="Collapsed" CornerRadius="{DynamicResource Radius.Chip}" Height="32" Padding="8,0" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource Brush.OverlayRowHover}" BorderThickness="1" BorderBrush="{DynamicResource Brush.OverlayBorderAccent}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.OverlayTextSecondary}" />
                <TextBlock Name="FilterChipLabel" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource Brush.OverlayText}" Text="{loc:T 文档}" />
                <Button Name="FilterChipClose" Content="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource Brush.OverlayTextSecondary}" Background="#00FFFFFF" BorderThickness="0" Margin="7,0,-2,0" Padding="2" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{loc:T 清除过滤器（Esc）}" Click="OnFilterChipClose" />
              </StackPanel>
            </Border>
            <TextBox Name="Input" FontSize="21" Background="#00FFFFFF" BorderThickness="0" Foreground="{DynamicResource Brush.OverlayText}" CaretBrush="{DynamicResource Brush.OverlayText}" VerticalContentAlignment="Center" Padding="0,4" MinHeight="42" MinWidth="120" FontFamily="{DynamicResource Font.Ui}" TextChanged="OnInputChanged" PreviewKeyDown="OnInputKeyDown" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border CornerRadius="{DynamicResource Radius.All}" Padding="8,4" VerticalAlignment="Center" Background="{DynamicResource Brush.OverlayRowHover}">
              <TextBlock Name="HintText" FontSize="11" Foreground="{DynamicResource Brush.OverlayTextSecondary}" Text="{loc:T Enter 执行}" />
            </Border>
            <Button Name="ExpandButton" Margin="6,0,0,0" Width="30" Height="30" Padding="0" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{loc:T 展开为文件搜索窗口}" Click="OnExpandClick">
              <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Brush.OverlayTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </Grid>
        <Border Name="SuggestBox" Grid.Row="1" Visibility="Collapsed" Margin="16,0,16,8" Padding="6,4" CornerRadius="{DynamicResource Radius.All}" Background="{DynamicResource Brush.OverlayRowHover}">
          <ListBox Name="SuggestList" Background="#00FFFFFF" BorderThickness="0" MaxHeight="248" Padding="0" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource QbarRow}" PreviewMouseLeftButtonUp="OnSuggestionClick">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Height="30">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="2,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.OverlayTextTertiary}" />
                  <TextBlock Grid.Column="1" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.OverlayText}" Text="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
        </Border>
        <Grid Row="3">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Name="MenuHeaderBox" Grid.Row="0" Visibility="Collapsed" Margin="16,4,16,0" Padding="10,7" CornerRadius="{DynamicResource Radius.All}" Background="{DynamicResource Brush.OverlayRowHover}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.OverlayTextSecondary}" />
              <TextBlock Name="MenuHeaderText" FontSize="11.5" MaxWidth="600" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Brush.OverlayTextSecondary}" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="1">
            <Border Name="GroupHeaderBox" Visibility="Collapsed" Margin="16,4,16,2">
              <TextBlock Name="GroupHeaderText" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.OverlayTextSecondary}" />
            </Border>
            <ListBox Name="Results" Margin="8,8,8,4" Background="#00FFFFFF" BorderThickness="0" MaxHeight="420" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ItemContainerStyle="{StaticResource QbarRow}" PreviewMouseRightButtonDown="OnResultsRightClick" PreviewMouseLeftButtonUp="OnResultClick">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Height="42">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Column="0" Width="28" Height="28" Margin="0,0,11,0" VerticalAlignment="Center">
                      <Border Name="IconTile" CornerRadius="{DynamicResource Radius.All}" Background="{DynamicResource Brush.OverlayRowHover}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5" Foreground="{DynamicResource Brush.OverlayTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding IconGlyph}" />
                      </Border>
                      <Border Name="IconImageTile" CornerRadius="{DynamicResource Radius.All}" Visibility="Collapsed" ClipToBounds="True">
                        <Image Stretch="UniformToFill" Source="{Binding IconSource}" />
                      </Border>
                      <Border Name="IconLetterTile" CornerRadius="{DynamicResource Radius.All}" Visibility="Collapsed" Background="{Binding LetterBrush}">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Letter}" />
                      </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock FontSize="14" Foreground="{DynamicResource Brush.OverlayText}" TextTrimming="CharacterEllipsis" w:QbarTitleHighlight.Segments="{Binding TitleSegments}" />
                      <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.OverlayTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Text="{Binding Subtitle}" />
                    </StackPanel>
                    <Border Name="BadgeChip" Grid.Column="2" CornerRadius="{DynamicResource Radius.All}" Padding="7,2" Background="{DynamicResource Brush.OverlayRowHover}" VerticalAlignment="Center">
                      <TextBlock FontSize="10.5" Foreground="{DynamicResource Brush.OverlayTextTertiary}" Text="{Binding Badge}" />
                    </Border>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Value="" Binding="{Binding Badge}">
                      <Setter TargetName="BadgeChip" Property="UIElement.Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Value="True" Binding="{Binding HasIcon}">
                      <Setter TargetName="IconTile" Property="UIElement.Visibility" Value="Collapsed" />
                      <Setter TargetName="IconImageTile" Property="UIElement.Visibility" Value="Visible" />
                    </DataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Value="False" Binding="{Binding HasIcon}" />
                        <Condition Value="True" Binding="{Binding HasLetter}" />
                      </MultiDataTrigger.Conditions>
                      <Setter TargetName="IconTile" Property="UIElement.Visibility" Value="Collapsed" />
                      <Setter TargetName="IconLetterTile" Property="UIElement.Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ListBox>
          </StackPanel>
          <Border Name="DebugBox" Grid.Row="2" Visibility="Collapsed" Margin="16,2,16,8" Padding="10,7" CornerRadius="{DynamicResource Radius.All}" Background="{DynamicResource Brush.OverlayRowHover}">
            <TextBlock Name="DebugText" FontFamily="Consolas, Cascadia Mono" FontSize="10.5" TextWrapping="Wrap" MaxHeight="170" Foreground="{DynamicResource Brush.OverlayTextSecondary}" />
          </Border>
        </Grid>
        <Grid Row="4" Margin="20,4,20,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="FooterHint" Grid.Column="0" FontSize="10.5" Foreground="{DynamicResource Brush.OverlayTextTertiary}" TextTrimming="CharacterEllipsis" Text="{loc:T ↑↓ 选择    Enter 执行    Tab 补全    Esc 关闭}" />
          <TextBlock Name="FacetText" Grid.Column="1" Visibility="Collapsed" Margin="12,0,0,0" FontSize="10.5" Foreground="{DynamicResource Brush.OverlayTextTertiary}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>