<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="InputPlus.UI.Windows.QbarExpandWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization" xmlns:w="clr-namespace:InputPlus.UI.Windows" Width="1120" Height="720" MinWidth="860" MinHeight="520" WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.WindowGradient}" FontFamily="{DynamicResource Font.Ui}" UseLayoutRounding="True" Title="{loc:T 文件搜索}" PreviewKeyDown="OnWindowKeyDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="{DynamicResource Radius.All}" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <TextBlock Style="{StaticResource Text.H3}" Margin="20,0,0,0" VerticalAlignment="Center" Text="{loc:T 文件搜索}" />
      <Button Style="{StaticResource Button.Icon}" Content="" HorizontalAlignment="Right" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" />
    </Grid>
    <Grid Row="1" Margin="20,0,20,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Name="QueryBox" Grid.Column="0" Style="{StaticResource TextBox.Base}" MinHeight="40" VerticalContentAlignment="Center" FontSize="15" TextChanged="OnQueryChanged" />
      <Button Name="RefreshButton" Grid.Column="1" Style="{StaticResource Button.Base}" Margin="8,0,0,0" MinWidth="84" Content="{loc:T 刷新}" Click="OnRefreshClick" />
    </Grid>
    <Grid Row="2" Margin="20,0,20,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10,12,10,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Row="0" Margin="4,0,2,8">
            <TextBlock Style="{StaticResource Text.H3}" VerticalAlignment="Center" Text="{loc:T 筛选}" />
            <Button Name="ClearFilterButton" HorizontalAlignment="Right" Padding="8,3" Background="{DynamicResource Brush.AccentSoft}" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="OnClearFilter">
              <TextBlock Name="ClearFilterText" FontSize="11.5" Foreground="{DynamicResource Brush.Accent}" />
            </Button>
          </Grid>
          <ListBox Name="TypeList" Grid.Row="1" Background="#00FFFFFF" BorderThickness="0" ItemContainerStyle="{StaticResource RowItem.Compact}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="OnTypeChanged">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="1" Rows="{Binding Items.Count, RelativeSource={RelativeSource AncestorType=ListBox}}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Margin="2,0,9,0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Glyph}" />
                  <TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Label}" />
                  <TextBlock Grid.Column="2" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,2,0" Foreground="{DynamicResource Brush.TextTertiary}" Text="{Binding CountText}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Margin="4,10,2,6">
            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,10" />
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="{loc:T 最近修改}" />
          </StackPanel>
          <ListBox Name="TimeList" Grid.Row="3" Background="#00FFFFFF" BorderThickness="0" ItemContainerStyle="{StaticResource RowItem.Compact}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="OnTimeChanged">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="1" Rows="{Binding Items.Count, RelativeSource={RelativeSource AncestorType=ListBox}}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="" Margin="2,0,9,0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                  <TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Label}" />
                  <TextBlock Grid.Column="2" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,2,0" Foreground="{DynamicResource Brush.TextTertiary}" Text="{Binding CountText}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0" Padding="6">
        <ListView Name="ResultList" Background="#00FFFFFF" BorderThickness="0" ItemContainerStyle="{StaticResource RowItem.Grid.Compact}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="OnResultDoubleClick" SelectionChanged="OnResultSelectionChanged">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type GridViewColumnHeader}" TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource GridView.Header}" />
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <ListView.View>
            <GridView>
              <GridViewColumn x:Name="NameColumn" Width="280" Header="{loc:T 名称}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <Grid Height="26">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid Column="0" Width="18" Height="18" Margin="2,0,7,0" VerticalAlignment="Center">
                        <TextBlock Name="GlyphIcon" FontSize="11.5" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Glyph}" />
                        <Image Name="ShellIcon" Stretch="Uniform" Visibility="Collapsed" SnapsToDevicePixels="True" Source="{Binding IconSource}" />
                      </Grid>
                      <TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}" w:QbarTitleHighlight.Segments="{Binding Segments}" />
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Value="True" Binding="{Binding HasIcon}">
                        <Setter TargetName="GlyphIcon" Property="UIElement.Visibility" Value="Collapsed" />
                        <Setter TargetName="ShellIcon" Property="UIElement.Visibility" Value="Visible" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn x:Name="PathColumn" Width="480" Header="{loc:T 路径}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Height="26" LineHeight="26" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Folder}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn x:Name="DateColumn" Width="118" Header="{loc:T 修改日期}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="12" Height="26" LineHeight="26" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding DateText}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn x:Name="SizeColumn" Width="84" HeaderContainerStyle="{StaticResource GridView.Header.Right}" Header="{loc:T 大小}">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="12" Height="26" LineHeight="26" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding SizeText}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </Border>
    </Grid>
    <Grid Row="3" Margin="20,0,20,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Name="StatusText" Grid.Column="0" Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center" Margin="12,0,0,0" Text="{loc:T 双击或 Enter 打开   Esc 清除筛选}" />
    </Grid>
  </Grid>
</Window>