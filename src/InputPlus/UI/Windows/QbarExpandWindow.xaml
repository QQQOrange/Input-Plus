<Window x:Class="InputPlus.UI.Windows.QbarExpandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
        xmlns:w="clr-namespace:InputPlus.UI.Windows"
        Title="{loc:T '文件搜索'}" Width="1120" Height="720" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.WindowGradient}"
        FontFamily="{DynamicResource Font.Ui}" UseLayoutRounding="True"
        PreviewKeyDown="OnWindowKeyDown">

    <WindowChrome.WindowChrome>
        <!-- CornerRadius 只是"内容裁切"的半径；真正画圆角的是 DWM（Win11），
             构造函数里 WindowChrome.AttachTo 会设 DWMWCP_ROUND 顺带把标题栏切深色。 -->
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="{DynamicResource Radius.Card}" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="{loc:T '文件搜索'}" Style="{StaticResource Text.H3}" Margin="20,0,0,0"
                       VerticalAlignment="Center" />
            <Button Style="{StaticResource Button.Icon}" Content="&#xE8BB;" HorizontalAlignment="Right"
                    Margin="0,0,10,0" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>

        <!-- 搜索行：这里重新查一遍，不依赖 Qbar 面板的状态 —— 面板关掉之后这个窗口还要能继续用 -->
        <Grid Grid.Row="1" Margin="20,0,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" Grid.Column="0" Style="{StaticResource TextBox.Base}" MinHeight="40"
                     VerticalContentAlignment="Center" FontSize="15" TextChanged="OnQueryChanged" />
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource Button.Base}" Margin="8,0,0,0"
                    MinWidth="84" Click="OnRefreshClick" Content="{loc:T '刷新'}" />
        </Grid>

        <Grid Grid.Row="2" Margin="20,0,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 分面栏：Listary 的样子，类型在上、时间桶在下。
                 计数是"本次候选窗口内"的统计 —— 窗口被截断时底部会写明。 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10,12,10,12">
                <Grid>
                    <!-- 两半等高：「筛选」和「最近修改」各占一半。
                         以前类型那组是 Auto、时间那组也是 Auto，中间那行 * 把空隙全吃掉了，
                         结果类型列表下面一大片空白、时间桶被压到最底下。 -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,2,8">
                        <TextBlock Text="{loc:T '筛选'}" Style="{StaticResource Text.H3}" VerticalAlignment="Center" />
                        <Button x:Name="ClearFilterButton" HorizontalAlignment="Right" Padding="8,3"
                                Background="{DynamicResource Brush.AccentSoft}" BorderThickness="0"
                                Cursor="Hand" Click="OnClearFilter" Visibility="Collapsed">
                            <TextBlock x:Name="ClearFilterText" FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </Button>
                    </Grid>

                    <!-- 行高 22：小窗（MinHeight 520）也要把 7 个类型桶和 6 个时间桶一次摆完，
                         以前每行 46px，全屏才看得见「最近 30 天 / 365 天」。 -->
                    <ListBox x:Name="TypeList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource RowItem.Compact}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionChanged="OnTypeChanged">
                        <!-- 行高不再写死 22：UniformGrid 把这块高度按条数均分，
                             窗口拉高时每一行跟着变高，栏底不留空白（以前 7 行挤在顶上，
                             下面一大片空着，看着像少了内容）。 -->
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1"
                                             Rows="{Binding Items.Count, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}" Margin="2,0,9,0"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="8,0,2,0"
                                               Foreground="{DynamicResource Brush.TextTertiary}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="4,10,2,6">
                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,10" />
                        <TextBlock Text="{loc:T '最近修改'}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>

                    <ListBox x:Name="TimeList" Grid.Row="3" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource RowItem.Compact}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionChanged="OnTimeChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1"
                                             Rows="{Binding Items.Count, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE823;" Margin="2,0,9,0"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12.5"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="8,0,2,0"
                                               Foreground="{DynamicResource Brush.TextTertiary}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 结果表：名称 / 路径 / 修改日期 / 大小。虚拟化必须开着 ——
                 这里一次能挂 5000 行，不虚拟化光建容器就要几百毫秒。 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0" Padding="6">
                <ListView x:Name="ResultList" Background="Transparent" BorderThickness="0"
                          ItemContainerStyle="{StaticResource RowItem.Grid.Compact}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="OnResultDoubleClick" SelectionChanged="OnResultSelectionChanged">
                    <ListView.Resources>
                        <!-- 表头跟设置页里的表格标题同一套（GridView.Header）。
                             不用系统默认表头：那是灰渐变 + 边框 + 居中字，跟卡片背景完全不是一路，
                             而且居中的标题压不住左对齐的列内容。 -->
                        <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridView.Header}" />
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="NameColumn" Header="{loc:T '名称'}" Width="280">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Height="26">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 图标跟资源管理器同源：ShellIcons 走 IShellItemImageFactory + 系统图像列表，
                                                 文件是关联程序的图标，目录是系统的文件夹图标。取不到才退回字形。 -->
                                            <Grid Grid.Column="0" Width="18" Height="18" Margin="2,0,7,0"
                                                  VerticalAlignment="Center">
                                                <TextBlock x:Name="GlyphIcon" Text="{Binding Glyph}" FontSize="11.5"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                                <Image x:Name="ShellIcon" Source="{Binding IconSource}" Stretch="Uniform"
                                                       Visibility="Collapsed" SnapsToDevicePixels="True" />
                                            </Grid>
                                            <!-- 不绑 Text，改由附加属性把命中段铺成 Inlines：
                                                 加亮区间来自搜索引擎（索引层给的高亮或本地匹配），
                                                 数据层只给偏移，界面层决定怎么画。 -->
                                            <TextBlock Grid.Column="1" FontSize="13"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                                       w:QbarTitleHighlight.Segments="{Binding Segments}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                <Setter TargetName="GlyphIcon" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="ShellIcon" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- 路径列没有 MinWidth：GridViewColumn 不是 FrameworkElement，设了会在标记编译期报 MC3072；
                     宽度下限由 FitPathColumn 的 Math.Max(160, …) 保证。 -->
                <GridViewColumn x:Name="PathColumn" Header="{loc:T '路径'}" Width="480">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Folder}" FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Height="26" LineHeight="26"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="DateColumn" Header="{loc:T '修改日期'}" Width="118">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DateText}" FontSize="12" Height="26" LineHeight="26"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="SizeColumn" Header="{loc:T '大小'}" Width="84"
                                            HeaderContainerStyle="{StaticResource GridView.Header.Right}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" FontSize="12" Height="26" LineHeight="26"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource Text.Tertiary}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{loc:T '双击或 Enter 打开   Esc 清除筛选'}"
                       Style="{StaticResource Text.Tertiary}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
    </Grid>
</Window>