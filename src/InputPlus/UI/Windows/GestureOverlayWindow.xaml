<Window x:Class="InputPlus.UI.Windows.GestureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手势轨迹"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False"
        SnapsToDevicePixels="True">
    <!--
        全屏透明覆盖层：只负责"看见"，不接任何输入。
        点击穿透靠 WS_EX_TRANSPARENT（见 code-behind），IsHitTestVisible 只挡住
        WPF 内部的命中测试，挡不住窗口本身。

        轨迹三层画法照 WGestures 2 的 A/U.cs：阴影 → 描边 → 主线，
        三层共用同一条几何（Path.Data 是同一个对象），只是粗细和透明度不同。
        描边是主线两侧各 BorderWidth 像素，所以它的粗细 = 线宽 + 2×描边宽。
        用 Path 而不是 Polyline，是因为轨迹点要过一遍 Chaikin 切角
        （见 GestureTrail.cs），Polyline 的 Points 塞不进平滑后的几何。
    -->
    <Canvas x:Name="Root" Background="Transparent" IsHitTestVisible="False">
        <Path x:Name="TrailShadow"
              Stroke="#14000000"
              StrokeThickness="5"
              StrokeLineJoin="Round"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              IsHitTestVisible="False" />
        <Path x:Name="TrailBorder"
              Stroke="#B3FFFFFF"
              StrokeThickness="3.5"
              StrokeLineJoin="Round"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              IsHitTestVisible="False" />
        <Path x:Name="Trail"
              Stroke="#FF3B82F6"
              StrokeThickness="1.5"
              StrokeLineJoin="Round"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              IsHitTestVisible="False" />

        <!-- 起始超时：光标尖端一个红圆，照 WGestures 2 的 B/X.cs:21-28 画 ——
             24×24 的框内缩 4px 得到直径 16 的圆，纯红填充 + 白色 2px 描边，没有阴影。 -->
        <Ellipse x:Name="TimeoutDot"
                 Width="16" Height="16"
                 Fill="#FFFF0000"
                 Stroke="#FFFFFFFF"
                 StrokeThickness="2"
                 Visibility="Collapsed"
                 IsHitTestVisible="False" />

        <!-- 手势名称：圆角 16、白色描边、白字 24 号，尺寸和 WGestures 的 GestureLabelView 对齐 -->
        <Border x:Name="LabelBox"
                Canvas.Left="0" Canvas.Top="0"
                Padding="24,14,24,16"
                MinWidth="120"
                MinHeight="52"
                CornerRadius="16"
                Background="#55000000"
                BorderBrush="#FFFFFFFF"
                BorderThickness="2"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <!-- VerticalAlignment/HorizontalAlignment=Center 缺一不可：
                 Border 的子元素默认 Stretch，MinHeight 时文字会被顶到上边缘，
                 看上去"没在方框正中间"。 -->
            <TextBlock x:Name="LabelText"
                       Foreground="#FFFFFFFF"
                       FontSize="24"
                       FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
                       TextAlignment="Center"
                       TextWrapping="NoWrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

    </Canvas>
</Window>
