<Window x:Class="InputPlus.UI.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
        Title="{loc:T '提示'}" SizeToContent="WidthAndHeight" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        FontFamily="{DynamicResource Font.Ui}">
    <!-- 外观回到 v1.6.0 之前、也是 v1.0~v1.2 一直用的那一版：
         主题卡片 + 22px 图标 + 13px 文字，没有阴影、不居中。
         底色/可调白边仍由 ToastWindow.Apply 按 ToastStyles.Current 覆盖：
         默认什么都不盖，就是这里的 Overlay.CardAlt（浅色白卡 / 深色墨卡）；
         只有用户在「设置 → 外观 → 提示条」里调过，才覆盖成写死的颜色与白边。 -->
    <Border x:Name="Card" Style="{StaticResource Overlay.CardAlt}" Margin="14" Padding="16,11">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="IconBox" Width="22" Height="22" CornerRadius="7"
                    Background="{DynamicResource Brush.OverlayAccentSoft}" VerticalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                           Foreground="{DynamicResource Brush.OverlayAccentText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="Message" Text="" Foreground="{DynamicResource Brush.OverlayText}" FontSize="13"
                       Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="460" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
