<Window x:Class="InputPlus.UI.Windows.GestureMenusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
        Title="{loc:T '手势菜单'}"
        Width="980" Height="680" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <!--
        手势菜单管理器（v1.5.0）。

        三栏：左边挑菜单 → 中间改菜单本身（名字 / 说明 / 条目的增删排序）→ 右边改一条条目。
        所有编辑都直接写进 AppSettings.GestureMenus 里的对象，输入即所见；
        关闭窗口时只有真的动过才落盘（一进来看看就关掉不会白写一次盘）。
    -->
    <DockPanel Margin="22,18,22,18">
        <!-- ================= 底栏 ================= -->
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Text.Tertiary}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{loc:T '菜单弹在鼠标旁边；条目就是普通动作，参数照样能用。'}" />
            <Button Grid.Column="1" Content="{loc:T '关闭'}" Style="{StaticResource Button.Ghost}"
                    Padding="16,7" IsCancel="True" Click="OnCloseClick" />
        </Grid>

        <!-- ================= 顶栏 ================= -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="{loc:T '手势菜单'}" Style="{StaticResource Text.H2}" />
                <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="{loc:T '给键或手势挂一个菜单动作，按下时就弹出这一列条目 —— WGestures 2 的手势菜单在这里是可编辑的。'}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{loc:T '新建菜单'}" Style="{StaticResource Button.Primary}"
                        Click="OnNewMenuClick" />
                <Button x:Name="DuplicateMenuButton" Content="{loc:T '复制'}"
                        Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                        Click="OnDuplicateMenuClick" />
                <Button x:Name="DeleteMenuButton" Content="{loc:T '删除'}"
                        Style="{StaticResource Button.Danger}" Margin="8,0,0,0"
                        Click="OnDeleteMenuClick" />
            </StackPanel>
        </Grid>

        <!-- ================= 主体三栏 ================= -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：菜单列表 ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T '菜单'}"
                               Style="{StaticResource Text.H3}" Margin="4,0,4,10" />

                    <Grid>
                        <ListBox x:Name="MenuList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource RowItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnMenuSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Text.Tertiary}"
                                                   FontSize="11.5" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 空状态：列表空的时候别让用户对着一片空白猜 -->
                        <TextBlock x:Name="MenuEmptyHint" Visibility="Collapsed"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" Margin="10,0"
                                   Text="{loc:T '还没有菜单&#x0a;点右上角「新建菜单」'}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ===== 中：菜单本身 ===== -->
            <Border Grid.Column="1" x:Name="MenuCard" Style="{StaticResource Card}"
                    Padding="14,14" Margin="12,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T '菜单内容'}"
                               Style="{StaticResource Text.H3}" Margin="4,0,4,10" />

                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{loc:T '名称'}" Style="{StaticResource Text.Tertiary}" Margin="4,0,0,0" />
                        <TextBox x:Name="NameBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                 Margin="0,4,0,0" TextChanged="OnNameChanged" />

                        <TextBlock Text="{loc:T '说明（显示在菜单名右边，可空）'}"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   Margin="4,10,0,0" />
                        <TextBox x:Name="HintBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                 Margin="0,4,0,0" TextChanged="OnHintChanged" />

                        <TextBlock Text="{loc:T '条目'}" Style="{StaticResource Text.Tertiary}"
                                   Margin="4,12,0,0" />
                    </StackPanel>

                    <!-- 条目操作（m01050 图标化）：原先四个文字按钮 2×2 占掉整块底部，
                         换成四颗字形按钮排成一行，280 宽的卡片里也放得下，条目列表还多出两行高度。 -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Orientation="Horizontal">
                        <Button x:Name="AddButton" Content="&#xE710;" Style="{StaticResource Button.Icon}"
                                Click="OnAddItemClick" AutomationProperties.Name="{loc:T '添加条目'}"
                                ToolTip="{loc:T '添加条目'}" />
                        <Button x:Name="RemoveButton" Content="&#xE74D;" Style="{StaticResource Button.Icon}"
                                Margin="4,0,0,0" Foreground="{DynamicResource Brush.Danger}"
                                Click="OnRemoveItemClick" AutomationProperties.Name="{loc:T '删除条目'}"
                                ToolTip="{loc:T '删除条目'}" />
                        <Button x:Name="UpButton" Content="&#xE74A;" Style="{StaticResource Button.Icon}"
                                Margin="4,0,0,0" Click="OnMoveItemUpClick"
                                AutomationProperties.Name="{loc:T '上移'}" ToolTip="{loc:T '上移'}" />
                        <Button x:Name="DownButton" Content="&#xE74B;" Style="{StaticResource Button.Icon}"
                                Margin="4,0,0,0" Click="OnMoveItemDownClick"
                                AutomationProperties.Name="{loc:T '下移'}" ToolTip="{loc:T '下移'}" />
                    </StackPanel>

                    <Grid Margin="0,6,0,0">
                        <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource RowItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnItemSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Text.Tertiary}"
                                                   FontSize="11.5" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="ItemEmptyHint" Visibility="Collapsed"
                                   Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" Margin="10,0"
                                   Text="{loc:T '这个菜单还没有条目&#x0a;点下面「添加条目」'}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ===== 右：选中条目的编辑 ===== -->
            <Border Grid.Column="2" x:Name="ItemCard" Style="{StaticResource Card}"
                    Padding="16,14" Margin="12,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T '条目设置'}"
                               Style="{StaticResource Text.H3}" Margin="2,0,0,10" />

                    <TextBlock x:Name="ItemCardHint" DockPanel.Dock="Top" Visibility="Collapsed"
                               Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap" Margin="2,0,0,4"
                               Text="{loc:T '先在中间选中一条条目，再来改它。'}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ItemEditorPanel" Margin="2,0,2,0">
                            <TextBlock Text="{loc:T '显示文字'}" Style="{StaticResource Text.Tertiary}" />
                            <TextBox x:Name="TitleBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                     Margin="0,4,0,0" TextChanged="OnTitleChanged" />
                            <TextBlock Text="{loc:T '留空就用动作自己的名字'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                       Margin="0,2,0,0" />

                            <TextBlock Text="{loc:T '图标字形（可空）'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,12,0,0" />
                            <TextBox x:Name="GlyphBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                     Margin="0,4,0,0" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                     TextChanged="OnGlyphChanged" />
                            <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                       Margin="0,2,0,0"
                                       Text="{loc:T '图标字形，可空；例如 &#xE8B7;（Segoe MDL2 Assets）'}" />

                            <TextBlock Text="{loc:T '动作分类'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,12,0,0" />
                            <ComboBox x:Name="CategoryBox" Style="{StaticResource ComboBox.Base}"
                                      Margin="0,4,0,0" SelectionChanged="OnCategoryChanged" />

                            <TextBlock Text="{loc:T '动作'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,10,0,0" />
                            <ComboBox x:Name="ActionBox" Style="{StaticResource ComboBox.Base}"
                                      Margin="0,4,0,0"
                                      SelectionChanged="OnActionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="{loc:T '参数'}" Style="{StaticResource Text.Tertiary}"
                                       Margin="0,10,0,0" />
                            <TextBox x:Name="ArgBox" Style="{StaticResource TextBox.Base}" MinHeight="34"
                                     Margin="0,4,0,0" TextChanged="OnArgChanged" />
                            <TextBlock Text="{loc:T '只有需要参数的动作才用得上'}"
                                       Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                       Margin="0,2,0,0" />

                            <TextBlock x:Name="ActionHintText" Style="{StaticResource Text.Tertiary}"
                                       TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 一个菜单都没有时的说明：盖在两栏上（两栏此时是 Collapsed） -->
            <TextBlock x:Name="EmptyHint" Grid.Column="1" Grid.ColumnSpan="2"
                       Visibility="Collapsed" Style="{StaticResource Text.Tertiary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="{loc:T '先在左边新建一个菜单'}" />
        </Grid>
    </DockPanel>
</Window>
