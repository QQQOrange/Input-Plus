<Window x:Class="InputPlus.UI.Windows.GestureMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
        Title="{loc:T '手势菜单'}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowActivated="True"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
    <!--
        手势菜单的弹出菜单（v1.5.0；v1.3.17 起支持图标、备注与悬停二级菜单）。

        窗口自己完全透明，圆角和投影都画在里面这层 Border 上 ——
        AllowsTransparency 的窗口只能靠"透明窗口 + 内部一块自绘卡片"做非矩形外观。
        Margin="14" 是留给投影的：窗口边界会把圆角外的像素裁掉，投影必须留在窗口里面，
        不流这圈边距的话阴影四周会被切齐，看着像一块硬边。

        窗口没有标题栏、不可缩放、不可拖动（WindowStyle=None + ResizeMode=NoResize）：
        它一出现就钉在光标处，用户要求"不能移动"。
    -->
    <Window.Resources>
        <!-- 一行条目：图标（没有图标退回 1..9 序号）/ 标题 + 备注 / 右侧二级箭头 -->
        <DataTemplate x:Key="EntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="22" Margin="1,0,9,0">
                    <!-- 三选一：真实图标 > 字形 > 序号。同一时刻只会显示一个。 -->
                    <Image Source="{Binding Icon}" Width="18" Height="18" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IconVisibility}" />
                    <TextBlock x:Name="GlyphText" Text="{Binding Glyph}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding GlyphVisibility}" />
                    <TextBlock x:Name="IndexText" Text="{Binding Index}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IndexVisibility}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- 标题必须自己给前景色。
                         夜间模式下原来是**黑字压黑底**：ListBox 的默认样式把 Foreground 设成了
                         系统 ControlText（浅色系统主题 = 黑），而样式设置比"从窗口继承"优先，
                         窗口上那句 Foreground 根本轮不到模板里的文字。
                         这里写死主题画刷，白天夜间都跟着走。 -->
                    <TextBlock Text="{Binding Title}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <!-- 备注：网址显示网页标题、文件显示路径。空的时候整行折叠，行高不变。 -->
                    <TextBlock Text="{Binding Note}" FontSize="10" Margin="0,0,0,0"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding NoteVisibility}" />
                </StackPanel>

                <!-- 有二级菜单时显示箭头；没有就整列空着，标题宽度不变 -->
                <TextBlock Grid.Column="2" Text="&#xE76C;" Margin="10,0,2,0"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           VerticalAlignment="Center"
                           Visibility="{Binding ArrowVisibility}" />
            </Grid>
        </DataTemplate>

        <!-- 二级菜单的一行：**只有名称**。
             以前沿用一级的模板，第二行会把 URL / 命令关键字一起画出来 —— 历史记录里
             每条都拖着一条 https://…，行高被撑到 30 多，一屏放不下几条。
             图标/序号那一列保留，和一级菜单左对齐；不再留右侧箭头列（子项没有下级）。 -->
        <DataTemplate x:Key="SubEntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 图标列宽 Auto：二级条目大多数没有图标（历史记录是网址、命令是关键字），
                     固定 22 会在标题左边留出一块看不到东西的空白，看起来像"左边距太大"。 -->
                <Grid Grid.Column="0" Width="Auto" Margin="1,0,9,0">
                    <Image Source="{Binding Icon}" Width="18" Height="18" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IconVisibility}" />
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding GlyphVisibility}" />
                    <TextBlock Text="{Binding Index}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IndexVisibility}" />
                </Grid>

                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- 行容器：和主题的 RowItem 同一套观感（圆角、悬停 Brush.Hover、选中 Brush.Selected），
             但内边距更紧（8,2）—— 菜单是一行一行扫的，RowItem 的 10,7 太肥。
             模板自己给、而不是只改 Padding：RowItem 模板里的 Padding 是写死的，
             在继承它的样式上改 Padding 不会生效，行高会一直按 10,7 算。 -->
        <Style x:Key="MenuRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.All}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseEnter" Handler="OnRowMouseEnter" />
            <EventSetter Event="MouseLeave" Handler="OnRowMouseLeave" />
            <Style.Triggers>
                <!-- 禁用态（v1.5.1 / v1.5 改绑 IsEnabled）：附加菜单顶部「打开文件所在位置」
                     在没有认出文件时置灰 —— 不是"前台是桌面/资源管理器"才灰，
                     而是**只要没拿到文件就灰**（Electron / 浏览器这类程序永远拿不到，
                     以前它们会亮着，点下去弹出一个莫名其妙的"选择要定位的文件"）。
                     绑的是条目的 IsEnabled 而不是 Item.Enabled：后者是普通属性、不发通知，
                     预热回来后改成灰的也刷不出来（菜单已经上屏了）。
                     只降透明度、不改行高与内边距 —— 菜单宽度是钉死的，多一个视觉状态不能让它跳。
                     IsHitTestVisible 一起关掉：鼠标落在灰条上不该触发悬停选中，
                     键盘那一路由 Accept 里的判断兜住。 -->
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 二级菜单的行：和一级同一套观感，只是左右内边距更小（6,2）。
             用户的原话是"二级的左右边距还是太宽" —— 卡片的 Padding 已经收到 4，
             行再来 8 就又是一圈看不见的空白。行高不变（MinHeight 照样 24）。 -->
        <Style x:Key="SubMenuRow" TargetType="ListBoxItem" BasedOn="{StaticResource MenuRow}">
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <!-- 附加菜单自己的滚动条：比全局（7）再细一档，4 DIP。
             用户原话是"这个滚动条也特别粗，收窄收窄再收窄"。
             只覆盖**本窗口内部**的隐式样式，其它页面仍是主题的 7。 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="4" />
            <!-- 同主题里那条注释：不把 MinWidth 归零，系统默认的 17 会把 4 盖掉。 -->
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Brush.BorderStrong}"
                                                        CornerRadius="{DynamicResource Radius.All}" Margin="0.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="4" />
                                <Setter Property="Width" Value="Auto" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 固定宽度：菜单宽窄不该随条目文字长短变（用户要求）。
         128 的时候"历史记录"这四个字 + 右侧二级菜单箭头已经放不下，标题被省略号截成"历史记…"；
         160 是能稳稳放下四到六个汉字、又不至于像 192 那样空出半条街的宽度。
         更长的标题照旧省略号截，菜单不跟着内容变宽。二级卡片用同样的 160，两块等宽。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 一级卡片：宽度 / 内边距 / 投影留白都不动，只是把二级菜单从 Popup 挪到右边第二列。
             Popup 那条路走不通：Right 在屏幕边缘会翻边压住菜单，Custom 回调第一次又拿不到
             真实尺寸（设备像素甚至 0），摆出来的位置怎么调都对不上。放进同一棵视觉树里，
             位置由布局算 —— 拼接、宽度一致都是布局的自然结果。 -->
        <Border Grid.Column="0" x:Name="MainCard" Margin="14,14,0,14" Width="160"
                VerticalAlignment="Top"
                Padding="6,4,6,4" CornerRadius="{DynamicResource Radius.All}"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.18" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <!-- 标题行 + 右上角收藏星标（v1.5.0）。
                 星标只给"附加菜单"这一路用（构造时传了 FavoriteTarget 才显示）：
                 手势菜单是用户自己配的一份动作清单，"收藏当前位置"在那里没有意义。
                 标题行在附加菜单里是收起的（用户要求不显示菜单名），但星标照旧在右上角。 -->
            <Grid x:Name="HeaderRow" Margin="4,4,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 标题行：只有菜单名。v1.3.17 起不再显示任何说明/介绍文字
                     （用户要求"中键菜单上不能显示中键菜单的相关介绍"），Hint 为空时整块折叠。 -->
                <StackPanel x:Name="TitleRow" Grid.Column="0" Margin="6,1,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="MenuTitleText" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MenuHintText" Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>

                <!-- 收藏：把当前网页 / 当前文件夹 / 当前程序 变成一条 Qbar 固定项。
                     点它 = 关掉菜单 + 弹「收藏到 Qbar」，所以在菜单里不需要第二个按钮。
                     18×18 是刻意做小的（v1.5.8）：附加菜单没有标题，这行除了星标什么都不放，
                     按 24 会把菜单头顶撑出一条比行还高的空白带（见 HeaderRow 的注释）。 -->
                <Button x:Name="FavoriteButton" Grid.Column="1"
                        Style="{StaticResource Button.Icon}"
                        Width="18" Height="18" FontSize="12" Padding="0"
                        Content="&#xE734;"
                        ToolTip="{loc:T '收藏当前位置到 Qbar'}"
                        Visibility="Collapsed"
                        Click="OnFavoriteClick" />
            </Grid>

            <Border x:Name="TitleDivider" Style="{StaticResource Divider}" Margin="10,8,10,4" />

            <!--
                行容器用 ListBox + 主题里的 RowItem：Padding 10,7 / 圆角 8 /
                悬停 Brush.Hover / 选中 Brush.Selected 全都在 RowItem 里，
                方向键上下移动也是它白送的。
                鼠标"选中即执行"放在 PreviewMouseLeftButtonUp 里做：
                直接用 SelectionChanged 的话，方向键挪一格就会把菜单关掉。
            -->
            <ListBox x:Name="ItemList"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     Focusable="True" FocusVisualStyle="{x:Null}"
                     ItemContainerStyle="{StaticResource MenuRow}"
                     ItemTemplate="{StaticResource EntryTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="OnEntryClick" />

            <TextBlock x:Name="EmptyText" Text="{loc:T '这个菜单还没有条目'}"
                       Style="{StaticResource Text.Tertiary}" Margin="12,6,12,10"
                       Visibility="Collapsed" />

        </StackPanel>
        </Border>

        <!-- 二级菜单：和一级并排的第二块卡片，默认收起。
             - 宽度 / 圆角 / 投影留白和一级一致（160、14、12）；宽度相等是"同一个菜单"的前提；
             - 左边**不留下边距**：用户要的是"紧紧贴在一级菜单上"，2px 在 200% 缩放下是 4 个像素，
               看起来就是一条缝；
             - 内边距收到 4（一级是 6）：二级条目没有右侧箭头、也没有禁用态，
               同一圈留白会显得空；行容器另用 SubMenuRow（6,2）。
             - 纵向由代码按"父项行的位置"设 Margin.Top，默认对齐卡片顶。 -->
        <Border Grid.Column="1" x:Name="SubCard" Width="160" Visibility="Collapsed"
                Margin="0,14,14,0" Padding="4,4,4,4" CornerRadius="{DynamicResource Radius.All}"
                VerticalAlignment="Top"
                TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.18" Color="Black" />
            </Border.Effect>
            <ListBox x:Name="SubList" Background="Transparent" BorderThickness="0" Padding="0"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     Focusable="False" FocusVisualStyle="{x:Null}"
                     ItemContainerStyle="{StaticResource SubMenuRow}"
                     ItemTemplate="{StaticResource SubEntryTemplate}"
                     MaxHeight="200"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="OnSubEntryClick" />
        </Border>
    </Grid>
</Window>
