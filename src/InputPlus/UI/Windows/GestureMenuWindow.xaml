<Window x:Class="InputPlus.UI.Windows.GestureMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InputPlus.UI.Windows"
        xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
        Title="{loc:T '手势菜单'}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowActivated="True"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
    <!--
        菜单的弹出菜单（v1.5.0；v1.6.7 起改成**任意层级**的横向链）。

        窗口自己完全透明，圆角和投影都画在卡片那层 Border 上 ——
        AllowsTransparency 的窗口只能靠"透明窗口 + 内部一块自绘卡片"做非矩形外观。
        卡片自带的 14 DIP 外边距是留给投影的：窗口边界会把圆角外的像素裁掉，
        投影必须留在窗口里面，不留这圈边距的话阴影四周会被切齐，看着像一块硬边。

        窗口没有标题栏、不可缩放、不可拖动（WindowStyle=None + ResizeMode=NoResize）：
        它一出现就钉在光标处，用户要求"不能移动"。

        ── 多级下钻（v1.6.7）──────────────────────────────────────────
        以前是"一级卡片 + 一块写死的二级卡片"（Grid 两列），最多两层。
        现在整条链放在 CascadePanel 里：每展开一级就新增一张同样的卡片，
        位置由窗口算（贴着父条目、纵向对齐）。外层 ScrollViewer 只做一件事 ——
        **横向空间不够时允许滚动**，而不是把卡片挤出屏幕。
    -->
    <Window.Resources>
        <!-- 标题与备注两套文字样式：错误态整行变红（读目录失败、调起资源管理器失败）。
             用 DataTrigger 而不是在代码里塞画刷：主题切换时 DynamicResource 照样跟着走。 -->
        <Style x:Key="Menu.TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Menu.SubText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 一行条目：图标（没有图标退回字形）/ 标题 + 备注 / 右侧展开箭头。
             箭头是**独立的按钮**（v1.6.7）：触屏没有 hover，点箭头就是"展开下一级"；
             鼠标点行本身则是"打开这个文件夹"，两者互不吞并。 -->
        <DataTemplate x:Key="EntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="22" Margin="1,0,9,0">
                    <!-- 三选一：真实图标 > 字形 > 序号。同一时刻只会显示一个。 -->
                    <Image Source="{Binding Icon}" Width="18" Height="18" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IconVisibility}" />
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding GlyphVisibility}" />
                    <TextBlock Text="{Binding Index}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IndexVisibility}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- 标题必须自己给前景色。
                         夜间模式下原来是**黑字压黑底**：ListBox 的默认样式把 Foreground 设成了
                         系统 ControlText（浅色系统主题 = 黑），而样式设置比"从窗口继承"优先，
                         窗口上那句 Foreground 根本轮不到模板里的文字。
                         这里写死主题画刷，白天夜间都跟着走。 -->
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Menu.TitleText}" />
                    <!-- 备注：网址显示网页标题、文件显示路径。空的时候整行折叠，行高不变。
                         读取/调起失败时这里写原因（红色）。 -->
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Menu.SubText}"
                               Margin="0,0,0,0"
                               Visibility="{Binding NoteVisibility}" />
                </StackPanel>

                <!-- 有下一级时显示箭头；没有就整列空着，标题宽度不变。
                     字形 E76C 是 ChevronRight，和 Win11 的菜单一致。
                     Tag="expand" 让上层能一眼认出"这一下点的是箭头，不是行"。 -->
                <Button x:Name="ExpandButton" Grid.Column="2" Tag="expand"
                        Style="{StaticResource Button.Icon}"
                        Width="16" Height="16" Padding="0" FontSize="9"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Content="&#xE76C;"
                        Focusable="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ArrowVisibility}"
                        ToolTip="{loc:T '展开下一级'}"
                        AutomationProperties.Name="{Binding ExpandLabel}" />
            </Grid>
        </DataTemplate>

        <!-- 子级菜单的一行：**只有名称**。
             以前沿用一级的模板，第二行会把 URL / 命令关键字一起画出来 —— 历史记录里
             每条都拖着一条 https://…，行高被撑到 30 多，一屏放不下几条。
             图标/序号那一列保留，和上一级左对齐；右侧是新加的展开箭头（任意层级都能下钻）。 -->
        <DataTemplate x:Key="SubEntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 图标列固定 16 DIP：子级文件夹的图标是**后台**取回来的（shell 真图标），
                     留 Auto 的话"图标还没到"那一两帧列宽为 0，图标一到标题会横向跳一下。
                     固定宽度 = 一开始就留好位置，图标贴上时只有那 16px 变，文字不动。 -->
                <Grid Grid.Column="0" Width="16" Margin="1,0,9,0">
                    <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IconVisibility}" />
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding GlyphVisibility}" />
                    <TextBlock Text="{Binding Index}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IndexVisibility}" />
                </Grid>

                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Menu.TitleText}" />

                <Button Grid.Column="2" Tag="expand"
                        Style="{StaticResource Button.Icon}"
                        Width="16" Height="16" Padding="0" FontSize="9"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Content="&#xE76C;"
                        Focusable="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="4,0,0,0"
                        Visibility="{Binding ArrowVisibility}"
                        ToolTip="{loc:T '展开下一级'}"
                        AutomationProperties.Name="{Binding ExpandLabel}" />
            </Grid>
        </DataTemplate>

        <!-- 行容器：和主题的 RowItem 同一套观感（圆角、悬停 Brush.Hover、选中 Brush.Selected），
             但内边距更紧（8,2）—— 菜单是一行一行扫的，RowItem 的 10,7 太肥。
             模板自己给、而不是只改 Padding：RowItem 模板里的 Padding 是写死的，
             在继承它的样式上改 Padding 不会生效，行高会一直按 10,7 算。 -->
        <Style x:Key="MenuRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- 无障碍（v1.6.7）：每行带层级信息。
                 WPF 没有 role/aria-*，对应的是 UI Automation：
                   ListBox → ControlType.List（role=menu）
                   ListBoxItem → ControlType.ListItem（role=menuitem）
                   AutomationProperties.Name / HelpText / ItemStatus ↔ aria-label / aria-expanded。
                 读屏软件读到的是"第 2 级，可展开，C:\Users"。 -->
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleLabel}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding AccessibleHint}" />
            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding AccessibleStatus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.All}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseEnter" Handler="OnRowMouseEnter" />
            <EventSetter Event="MouseLeave" Handler="OnRowMouseLeave" />
            <Style.Triggers>
                <!-- 禁用态（v1.5.1 / v1.5 改绑 IsEnabled）：附加菜单顶部「打开文件所在位置」
                     在没有认出文件时置灰 —— 不是"前台是桌面/资源管理器"才灰，
                     而是**只要没拿到文件就灰**（Electron / 浏览器这类程序永远拿不到，
                     以前它们会亮着，点下去弹出一个莫名其妙的"选择要定位的文件"）。
                     绑的是条目的 IsEnabled 而不是 Item.Enabled：后者是普通属性、不发通知，
                     预热回来后改成灰的也刷不出来（菜单已经上屏了）。
                     只降透明度、不改行高与内边距 —— 菜单宽度是钉死的，多一个视觉状态不能让它跳。
                     IsHitTestVisible 一起关掉：鼠标落在灰条上不该触发悬停选中，
                     键盘那一路由 Accept 里的判断兜住。 -->
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 子级菜单的行：和上一级同一套观感，只是左右内边距更小（6,2）。
             用户的原话是"二级的左右边距还是太宽" —— 卡片的 Padding 已经收到 4，
             行再来 8 就又是一圈看不见的空白。行高不变（MinHeight 照样 24）。 -->
        <Style x:Key="SubMenuRow" TargetType="ListBoxItem" BasedOn="{StaticResource MenuRow}">
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <!-- 每一级卡片都是这一套：宽度钉死 160（宽窄不随条目文字长短变），
             左边不留白（要紧贴上一级），上/右留 14 给投影。
             代码里 new Border { Style = (Style)FindResource("Menu.Card") } 就能长出一张新卡。 -->
        <Style x:Key="Menu.Card" TargetType="Border">
            <Setter Property="Width" Value="160" />
            <Setter Property="Margin" Value="0,14,14,0" />
            <Setter Property="Padding" Value="4,4,4,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.All}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.18" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单里的滚动条：比全局（7）再细一档，4 DIP。
             用户原话是"这个滚动条也特别粗，收窄收窄再收窄"。
             v1.6.7：**横向也要能用** —— 层级太深、横向放不下时，外层 ScrollViewer
             会出现一条横向滚动条，它同样是 4 DIP，不占掉一整行的视觉重量。
             两个方向共用这一套模板，靠 Orientation 触发器换 Track 方向与翻页命令。 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="4" />
            <!-- 同主题里那条注释：不把 MinWidth 归零，系统默认的 17 会把 4 盖掉。 -->
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Brush.BorderStrong}"
                                                        CornerRadius="{DynamicResource Radius.All}" Margin="0.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageInc" Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageDec" Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="4" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="PageInc" Property="Command" Value="ScrollBar.PageRightCommand" />
                                <Setter TargetName="PageDec" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层只负责"横向放不下时能滚"，不参与每张卡片的摆放。
         纵向也留了 Auto：万一某台机器的卡片比工作区还高（极小屏 + 超大 DPI），
         宁可出一条滚动条，也不要把内容裁掉。 -->
    <ScrollViewer x:Name="CascadeScroll" Background="Transparent"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  CanContentScroll="False"
                  Focusable="False">
        <local:CascadePanel x:Name="CascadeHost">

            <!-- 一级卡片：宽度 / 内边距 / 投影留白都不动。
                 它是唯一带标题行和收藏星标的卡片（二~N 级只有条目），
                 位置由窗口钉在 (0,0)，尺寸按内容。 -->
            <Border x:Name="MainCard" Style="{StaticResource Menu.Card}"
                    Width="160" Margin="14,14,0,14" Padding="6,4,6,4">
                <StackPanel>
                    <!-- 标题行 + 右上角收藏星标（v1.5.0）。
                         星标只给"附加菜单"这一路用（构造时传了 FavoriteTarget 才显示）：
                         手势菜单是用户自己配的一份动作清单，"收藏当前位置"在那里没有意义。
                         标题行在附加菜单里是收起的（用户要求不显示菜单名），但星标照旧在右上角。 -->
                    <Grid x:Name="HeaderRow" Margin="4,4,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 标题行：只有菜单名。v1.3.17 起不再显示任何说明/介绍文字
                             （用户要求"中键菜单上不能显示中键菜单的相关介绍"），Hint 为空时整块折叠。 -->
                        <StackPanel x:Name="TitleRow" Grid.Column="0" Margin="6,1,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MenuTitleText" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MenuHintText" Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>

                        <!-- 收藏：把当前网页 / 当前文件夹 / 当前程序 变成一条 Qbar 固定项。
                             点它 = 关掉菜单 + 弹「收藏到 Qbar」，所以在菜单里不需要第二个按钮。
                             18×18 是刻意做小的（v1.5.8）：附加菜单没有标题，这行除了星标什么都不放，
                             按 24 会把菜单头顶撑出一条比行还高的空白带（见 HeaderRow 的注释）。 -->
                        <Button x:Name="FavoriteButton" Grid.Column="1"
                                Style="{StaticResource Button.Icon}"
                                Width="18" Height="18" FontSize="12" Padding="0"
                                Content="&#xE734;"
                                ToolTip="{loc:T '收藏当前位置到 Qbar'}"
                                Visibility="Collapsed"
                                Click="OnFavoriteClick" />
                    </Grid>

                    <Border x:Name="TitleDivider" Style="{StaticResource Divider}" Margin="10,8,10,4" />

                    <!--
                        行容器用 ListBox + 主题里的 RowItem：Padding 10,7 / 圆角 8 /
                        悬停 Brush.Hover / 选中 Brush.Selected 全都在 RowItem 里，
                        方向键上下移动也是它白送的。
                        鼠标"选中即执行"放在 PreviewMouseLeftButtonUp 里做：
                        直接用 SelectionChanged 的话，方向键挪一格就会把菜单关掉。
                    -->
                    <ListBox x:Name="ItemList"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             Focusable="True" FocusVisualStyle="{x:Null}"
                             ItemContainerStyle="{StaticResource MenuRow}"
                             ItemTemplate="{StaticResource EntryTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="OnEntryClick" />

                    <TextBlock x:Name="EmptyText" Text="{loc:T '这个菜单还没有条目'}"
                               Style="{StaticResource Text.Tertiary}" Margin="12,6,12,10"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </local:CascadePanel>
    </ScrollViewer>
</Window>
