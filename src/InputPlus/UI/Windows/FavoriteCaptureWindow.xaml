<Window x:Class="InputPlus.UI.Windows.FavoriteCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
        Title="{loc:T '收藏到 Qbar'}"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{DynamicResource Font.Ui}">

    <!--
        收藏对话框（v1.5.0）。

        流程：附加菜单右上角的星标 → 关掉菜单 → 弹这个窗 → 用户看一眼/改一改 → 确定
        → 写进 Qbar 的固定项。

        为什么先弹窗再填内容：读当前网址（UIA）和读当前目录（Shell COM）都是跨进程操作，
        快的几十毫秒、慢的能到一秒。窗口先出来、字段随后补上，用户看到的是"它已经在读"，
        而不是"点了星标之后什么都没发生"。
    -->
    <StackPanel Margin="24,18,24,20">

        <!-- 顶部：图标 + 标题 + 来源 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{DynamicResource Radius.Control}"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <Grid>
                    <Image x:Name="IconPreview" Width="28" Height="28" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
                    <TextBlock x:Name="IconFallback" Text="&#xE734;" FontSize="17"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{DynamicResource Brush.Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" Text="{loc:T '收藏到 Qbar'}"
                           FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="SourceText" FontSize="11" Margin="0,3,0,0"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Divider}" Margin="0,14,0,4" />

        <!-- 它正在打开的文件（v1.5.1）。
             星标原来的用途一点没变（网页 / 文件夹 / 程序），这里只是**多给一条路**：
             前台程序手里正开着一个文件时，顺手也能把它收进固定项。
             识别不到（浏览器、桌面、提权窗口）就整条不显示 —— 空着一条框比没有更难看。 -->
        <Border x:Name="OpenFileStrip" Visibility="Collapsed" Margin="0,6,0,4"
                Padding="10,8" CornerRadius="{DynamicResource Radius.Control}"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE8A5;" FontSize="14" Margin="0,0,8,0"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                <TextBlock x:Name="OpenFileText" Grid.Column="1" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
                <Button x:Name="OpenFileButton" Grid.Column="2" Content="{loc:T '收藏这个文件'}"
                        Style="{StaticResource Button.Ghost}" Padding="10,3" Margin="10,0,0,0"
                        Click="OnFavoriteOpenFile" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T '目标路径'}"
                       Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,0,10" />
            <TextBox x:Name="TargetBox" Grid.Row="0" Grid.Column="1" Height="32"
                     Style="{StaticResource TextBox.Base}" VerticalContentAlignment="Center"
                     Margin="0,0,0,10" TextChanged="OnFieldChanged" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T '备注'}"
                       Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,0,10" />
            <TextBox x:Name="CommentBox" Grid.Row="1" Grid.Column="1" Height="32"
                     Style="{StaticResource TextBox.Base}" VerticalContentAlignment="Center"
                     Margin="0,0,0,10" TextChanged="OnFieldChanged" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T '关键字'}"
                       Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="KeywordBox" Grid.Column="0" Height="32"
                         Style="{StaticResource TextBox.Base}" VerticalContentAlignment="Center"
                         TextChanged="OnFieldChanged" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                           Text="{loc:T '在 Qbar 里打这个就能命中；只保留字母数字。'}" />
            </Grid>
        </Grid>

        <!-- 图标来源与「显示在附加菜单」 -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IconPathText" Grid.Column="0" Style="{StaticResource Text.Tertiary}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <CheckBox x:Name="ShowInMenuBox" Grid.Column="1" Margin="12,0,0,0" FontSize="12"
                      Foreground="{DynamicResource Brush.TextSecondary}"
                      VerticalAlignment="Center" Content="{loc:T '在附加菜单里显示'}" />
        </Grid>

        <!-- 状态行：读不到网页地址 / 读不到目录时说明原因；读完就收起来 -->
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource Brush.Warning}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{loc:T '取消'}" Style="{StaticResource Button.Ghost}" Padding="14,7"
                    Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
            <Button Content="{loc:T '收藏'}" Style="{StaticResource Button.Primary}" Padding="20,7"
                    Click="OnOk" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
