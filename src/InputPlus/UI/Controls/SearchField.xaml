<UserControl x:Class="InputPlus.UI.Controls.SearchField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InputPlus.UI.Markup;assembly=InputPlus.Localization"
             FontFamily="{DynamicResource Font.Ui}"
             Focusable="False">
    <!--
        全软件统一的搜索框：放大镜**在框里面**、清空叉在框里面、分类下拉也在框里面。

        以前每个页各画一套：有的把放大镜摆在输入框左边（两件东西并排，看着像
        图标 + 输入框两个控件），有的干脆只有个空盒子，用户根本看不出这里是搜索。
        现在一处定义、所有页面引用，外观和行为只有一份实现。

        分类是"先选列，再搜"：选了「备注」就只在备注列里找，不会因为正文里
        恰好有同一个词而把行留下来。页面通过 SetCategories 传进来，
        不传 = 没有分类（纯筛选框），下拉和那条竖线一起收掉。
    -->
    <UserControl.Resources>
        <!-- 框内的输入框：不要自己的边框和圆角 —— 边框由外层 Shell 画，
             里面再画一层就会出现"框中框"，聚焦时尤其明显。 -->
        <Style x:Key="SearchField.Inner" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
            <Setter Property="FontSize" Value="{StaticResource Size.Text}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 框内的分类下拉：同样不要边框/圆角/底色，只留文字 + 小箭头，
             读起来是"搜索框右端的一个选择器"，而不是嵌了一个 ComboBox。 -->
        <Style x:Key="SearchField.Category" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.Control}" />
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Site" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,18,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Path Data="M 0 0 L 3.5 3.5 L 7 0" Stroke="{DynamicResource Brush.TextTertiary}"
                                  StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,7,0" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.BorderStrong}"
                                        BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Margin="0,4,0,0" Padding="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        TextElement.Foreground="{DynamicResource Brush.TextPrimary}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Shell" CornerRadius="{DynamicResource Radius.Control}" BorderThickness="1" MinHeight="34"
            Background="{DynamicResource Brush.Surface}"
            SnapsToDevicePixels="True">
        <Border.Style>
            <!-- 悬停/聚焦时整条框换描边（不是框里那层输入框换）：
                 用户看到的是"这一整条被激活了"，和 TextBox.Base 的观感一致。 -->
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=Shell}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchInput}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 放大镜：在框**里面**，不参与命中测试（点它等于点输入框） -->
            <TextBlock Grid.Column="0" x:Name="SearchGlyph" Text="&#xE721;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                       Foreground="{DynamicResource Brush.TextTertiary}"
                       VerticalAlignment="Center" Margin="11,0,7,0"
                       IsHitTestVisible="False" />

            <Grid Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True">
                <TextBox x:Name="SearchInput" Style="{StaticResource SearchField.Inner}"
                         VerticalContentAlignment="Center"
                         TextChanged="OnInputTextChanged"
                         PreviewKeyDown="OnInputKeyDown" />
                <TextBlock x:Name="PlaceholderText" Text=""
                           Foreground="{DynamicResource Brush.TextTertiary}"
                           VerticalAlignment="Center" Margin="1,0,6,0"
                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- 清空：只在有字的时候出现，所以平时几乎不占宽 -->
            <Button Grid.Column="2" x:Name="ClearButton" Content="&#xE711;"
                    Style="{StaticResource Button.Icon}" Width="24" Height="24"
                    FontSize="11" Margin="2,0,2,0" VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextTertiary}"
                    Visibility="Collapsed"
                    Click="OnClearClick"
                    AutomationProperties.Name="{loc:T '清空搜索'}"
                    ToolTip="{loc:T '清空搜索'}" />

            <Rectangle Grid.Column="3" x:Name="CategorySeparator" Width="1" Margin="2,7,2,7"
                       Fill="{DynamicResource Brush.Border}" Visibility="Collapsed" />

            <ComboBox Grid.Column="4" x:Name="CategoryBox" Style="{StaticResource SearchField.Category}"
                      VerticalAlignment="Center" Margin="0,0,4,0"
                      Visibility="Collapsed"
                      SelectionChanged="OnCategorySelectionChanged"
                      ToolTip="{loc:T '先选搜哪一列，再输入关键词'}" />
        </Grid>
    </Border>
</UserControl>
